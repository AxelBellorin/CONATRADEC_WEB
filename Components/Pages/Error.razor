@page "/error"

<PageTitle>No fue posible completar la operación | CONATRADEC</PageTitle>

<div class="empty-state"
     role="alert"
     aria-live="assertive">
    <i class="fa-solid fa-circle-exclamation"></i>

    <h1>No fue posible completar la operación</h1>

    <p>
        Ocurrió un inconveniente al procesar la solicitud.
        Intenta nuevamente o regresa al inicio.
    </p>

    <a class="btn-primary"
       href="/">
        Volver al inicio
    </a>
</div>
