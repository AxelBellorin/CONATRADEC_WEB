@page "/inspeccion-fitosanitaria"
@inject InspeccionFitosanitariaWebService Servicio
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Inspección fitosanitaria</PageTitle>

<div class="fit-page">
    <header class="fit-header">
        <div>
            <span class="fit-kicker">Supervisión agrícola</span>
            <h1>Inspección fitosanitaria</h1>
            <p>
                Registre evidencias, prepare el análisis y dé seguimiento a cada fotografía
                durante la revisión técnica.
            </p>
            <div class="fit-flow-guide" aria-label="Etapas del proceso fitosanitario">
                <span><i class="fa-solid fa-map-location-dot"></i> Terreno</span>
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                <span><i class="fa-solid fa-camera"></i> Evidencias</span>
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                <span><i class="fa-solid fa-wand-magic-sparkles"></i> Análisis</span>
                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                <span><i class="fa-solid fa-check-double"></i> Revisión</span>
            </div>
        </div>

        @if (PuedeCrear && vistaActual == "mis")
        {
            <button class="fit-btn fit-btn-primary" @onclick="AbrirNuevaInspeccion">
                <i class="fa-solid fa-plus"></i>
                Nueva inspección
            </button>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="fit-alert @(mensajeError ? "error" : "success")">
            <i class="fa-solid @(mensajeError ? "fa-circle-exclamation" : "fa-circle-check")"></i>
            <span>@mensaje</span>
            <button type="button" @onclick="() => mensaje = string.Empty" aria-label="Cerrar">×</button>
        </div>
    }

    <nav class="fit-tabs" aria-label="Bandejas fitosanitarias">
        @if (PuedeSolicitud)
        {
            <button class="@(vistaActual == "mis" ? "active" : string.Empty)"
                    @onclick='() => CambiarVistaAsync("mis")'>
                <i class="fa-solid fa-folder-open"></i>
                Mis inspecciones
            </button>

            <button class="@(vistaActual == "decisiones" ? "active" : string.Empty)"
                    @onclick='() => CambiarVistaAsync("decisiones")'>
                <i class="fa-solid fa-user-check"></i>
                Decisiones técnicas
            </button>
        }

        @if (PuedeAnalizador)
        {
            <button class="@(vistaActual == "analizador" ? "active" : string.Empty)"
                    @onclick='() => CambiarVistaAsync("analizador")'>
                <i class="fa-solid fa-briefcase"></i>
                Analizador · Mis expedientes
            </button>

            <button class="@(vistaActual == "analizador-disponibles" ? "active" : string.Empty)"
                    @onclick='() => CambiarVistaAsync("analizador-disponibles")'>
                <i class="fa-solid fa-inbox"></i>
                Analizador · Disponibles
            </button>

            <button class="@(vistaActual == "analizador-revisadas" ? "active" : string.Empty)"
                    @onclick='() => CambiarVistaAsync("analizador-revisadas")'>
                <i class="fa-solid fa-clock-rotate-left"></i>
                Analizador · Revisados
            </button>
        }

        @if (PuedeAprobador)
        {
            <button class="@(vistaActual == "aprobador" ? "active" : string.Empty)"
                    @onclick='() => CambiarVistaAsync("aprobador")'>
                <i class="fa-solid fa-briefcase"></i>
                Aprobador · Mis expedientes
            </button>

            <button class="@(vistaActual == "aprobador-disponibles" ? "active" : string.Empty)"
                    @onclick='() => CambiarVistaAsync("aprobador-disponibles")'>
                <i class="fa-solid fa-inbox"></i>
                Aprobador · Disponibles
            </button>

            <button class="@(vistaActual == "aprobador-revisadas" ? "active" : string.Empty)"
                    @onclick='() => CambiarVistaAsync("aprobador-revisadas")'>
                <i class="fa-solid fa-box-archive"></i>
                Aprobador · Revisados
            </button>
        }

        @if (PuedeSolicitud)
        {
            <button class="@(vistaActual == "historial" ? "active" : string.Empty)"
                    @onclick='() => CambiarVistaAsync("historial")'>
                <i class="fa-solid fa-timeline"></i>
                Historial
            </button>
        }
    </nav>

    <section class="fit-panel fit-filters">
        <div class="fit-field grow">
            <label>Buscar</label>
            <div class="fit-input-icon">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input @bind="buscar"
                       @bind:event="oninput"
                       placeholder="Código, inspección, terreno, técnico o propietario" />
            </div>
        </div>

        <div class="fit-field">
            <label>Estado</label>
            <select @bind="estado">
                <option value="">Todos</option>
                <option value="BORRADOR">Borrador</option>
                <option value="EN_PROCESO">En proceso</option>
                <option value="EN_PROCESO_CON_ERRORES">Con errores</option>
                <option value="PENDIENTE_REVISION">Pendiente revisión</option>
                <option value="PENDIENTE_APROBACION">Pendiente aprobación</option>
                <option value="FINALIZADA">Finalizada</option>
                <option value="FINALIZADA_PARCIALMENTE">Finalizada parcialmente</option>
            </select>
        </div>

        <div class="fit-field">
            <label>Propietario</label>
            <input @bind="filtroPropietario" placeholder="Nombre del propietario" />
        </div>

        <div class="fit-field">
            <label>Departamento</label>
            <input @bind="filtroDepartamento" placeholder="Departamento" />
        </div>

        <div class="fit-field">
            <label>Tipo de fotografía</label>
            <select @bind="filtroTipoFotografia">
                <option value="">Todos</option>
                @foreach (TipoFotografiaIAWeb tipo in tiposFotografia)
                {
                    <option value="@tipo.Codigo">@tipo.Nombre</option>
                }
            </select>
        </div>

        <div class="fit-field">
            <label>Desde</label>
            <input type="date" @bind="fechaDesde" />
        </div>

        <div class="fit-field">
            <label>Hasta</label>
            <input type="date" @bind="fechaHasta" />
        </div>

        <button class="fit-btn fit-btn-secondary" @onclick="AplicarFiltrosAsync" disabled="@cargando">
            <i class="fa-solid fa-filter"></i>
            Aplicar
        </button>

        <button class="fit-btn fit-btn-light" @onclick="LimpiarFiltrosAsync" disabled="@cargando">
            Limpiar
        </button>
    </section>

    @if (cargando && inspecciones.Count == 0)
    {
        <div class="fit-loading">
            <i class="fa-solid fa-spinner fa-spin"></i>
            <span>Cargando inspecciones...</span>
        </div>
    }
    else if (inspecciones.Count == 0)
    {
        <div class="fit-empty">
            <i class="fa-solid fa-leaf"></i>
            <h3>No hay inspecciones en esta bandeja</h3>
            <p>Los registros aparecerán aquí cuando cumplan las condiciones de la etapa seleccionada.</p>
        </div>
    }
    else
    {
        <section class="fit-list">
            @foreach (InspeccionFitosanitariaBandejaItemWeb item in inspecciones)
            {
                <article class="fit-card" @onclick="() => AbrirDetalle(item)">
                    <div class="fit-thumb">
                        @if (!string.IsNullOrWhiteSpace(item.UrlMiniatura))
                        {
                            <img src="@item.UrlMiniatura" alt="Evidencia de la inspección" loading="lazy" />
                        }
                        else
                        {
                            <i class="fa-solid fa-seedling"></i>
                        }
                    </div>

                    <div class="fit-card-main">
                        <div class="fit-card-title-row">
                            <div>
                                <span class="fit-id">#@item.InspeccionId</span>
                                <h3>@NombreInspeccion(item)</h3>
                            </div>
                            <span class="fit-status @ClaseEstadoBandeja(item)">@TextoEstadoBandeja(item)</span>
                        </div>

                        <div class="fit-meta-grid">
                            <span><i class="fa-solid fa-map-location-dot"></i> @Terreno(item)</span>
                            <span><i class="fa-solid fa-user"></i> @Tecnico(item)</span>
                            @if (!string.IsNullOrWhiteSpace(item.Propietario))
                            {
                                <span><i class="fa-solid fa-id-card"></i> @item.Propietario</span>
                            }
                            <span><i class="fa-regular fa-clock"></i> @Local(item.FechaRegistroSistemaUtc).ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        <div class="fit-progress-row">
                            <span><strong>@item.TotalFotografias</strong> fotos</span>
                            <span><strong>@item.Pendientes</strong> pendientes</span>
                            <span class="@(item.ConError > 0 ? "danger" : string.Empty)"><strong>@item.ConError</strong> error IA</span>
                            <span><strong>@item.Finalizadas</strong> finalizadas</span>
                        </div>

                        <div class="fit-progress-meter" aria-label="Progreso de fotografías">
                            <div class="fit-progress-track" role="progressbar" aria-valuemin="0"
                                 aria-valuemax="100" aria-valuenow="@PorcentajeAvance(item)">
                                <span style="@($"width:{PorcentajeAvance(item)}%")"></span>
                            </div>
                            <span>@PorcentajeAvance(item)% completado</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.AnalizadorAsignado) ||
                             !string.IsNullOrWhiteSpace(item.AprobadorAsignado))
                        {
                            <div class="fit-assignments">
                                @if (!string.IsNullOrWhiteSpace(item.AnalizadorAsignado))
                                {
                                    <span><i class="fa-solid fa-microscope"></i> Analizador: @item.AnalizadorAsignado</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.AprobadorAsignado))
                                {
                                    <span><i class="fa-solid fa-stamp"></i> Aprobador: @item.AprobadorAsignado</span>
                                }
                            </div>
                        }
                    </div>

                    @if (EsVistaDisponible)
                    {
                        <button class="fit-btn fit-btn-primary"
                                @onclick:stopPropagation="true"
                                @onclick="() => TomarExpedienteAsync(item)"
                                disabled="@(!PuedeTomarVistaActual || cargando)">
                            <i class="fa-solid fa-hand"></i>
                            @(PuedeTomarVistaActual ? "Tomar expediente" : "Solo consulta")
                        </button>
                    }
                    else
                    {
                        <i class="fa-solid fa-chevron-right fit-open"></i>
                    }
                </article>
            }
        </section>

        @if (hayMas)
        {
            <div class="fit-load-more">
                <button class="fit-btn fit-btn-secondary" @onclick="CargarMasAsync" disabled="@cargando">
                    @if (cargando)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                    }
                    else
                    {
                        <i class="fa-solid fa-arrow-down"></i>
                    }
                    Cargar más
                </button>
            </div>
        }
    }
</div>

@if (mostrarNueva)
{
    <div class="fit-modal-backdrop" @onclick="CerrarNuevaInspeccion">
        <section class="fit-modal fit-modal-wide" role="dialog" aria-modal="true"
                 aria-labelledby="fit-nueva-title" aria-describedby="fit-nueva-descripcion"
                 @onclick:stopPropagation="true">
            <header>
                <div class="fit-modal-heading">
                    <span class="fit-modal-heading-icon" aria-hidden="true"><i class="fa-solid fa-clipboard-check"></i></span>
                    <div>
                    <span class="fit-kicker">Registro en campo</span>
                    <h2 id="fit-nueva-title">Nueva inspección fitosanitaria</h2>
                    <p id="fit-nueva-descripcion" class="fit-modal-subtitle">Identifique el terreno y agregue las evidencias del recorrido.</p>
                    </div>
                </div>
                <button type="button" class="fit-icon-btn" @onclick="CerrarNuevaInspeccion" aria-label="Cerrar registro" disabled="@guardando">×</button>
            </header>

            <div class="fit-modal-body">
                <div class="fit-modal-steps" aria-label="Etapas del registro">
                    <span class="@(string.IsNullOrWhiteSpace(codigoTerreno) ? "current" : "complete")"><b>01</b> Terreno</span>
                    <span class="@(fotosNueva.Count > 0 ? "complete" : string.Empty)"><b>02</b> Evidencias</span>
                    <span><b>03</b> Registrar</span>
                </div>

            <div class="fit-form-grid">
                <div class="fit-field">
                    <label>Código del terreno *</label>
                    <div class="fit-terreno-actions">
                        <input @bind="codigoTerreno" maxlength="50" placeholder="Ej. TR-001"
                               readonly="@(terrenoSeleccionado is not null)" />
                        @if (PuedeBuscarTerrenos)
                        {
                            <button type="button" class="fit-btn fit-btn-secondary"
                                    @onclick="() => mostrarBuscadorTerreno = !mostrarBuscadorTerreno"
                                    disabled="@guardando">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                @(mostrarBuscadorTerreno ? "Cerrar búsqueda" : "Buscar terreno")
                            </button>
                        }
                    </div>
                    <small>Seleccione un terreno activo o introduzca su código como antes.</small>
                    @if (terrenoSeleccionado is not null)
                    {
                        <div class="fit-terreno-seleccionado">
                            <span>
                                <i class="fa-solid fa-circle-check"></i>
                                <strong>@terrenoSeleccionado.CodigoTerreno</strong> ·
                                @terrenoSeleccionado.PropietarioTexto ·
                                @terrenoSeleccionado.UbicacionTexto
                            </span>
                            <button type="button" @onclick="QuitarTerrenoSeleccionado" disabled="@guardando">Quitar</button>
                        </div>
                    }
                </div>

                <div class="fit-field">
                    <label>Nombre de la inspección *</label>
                    <input @bind="nombreInspeccion" maxlength="150" placeholder="Ej. Monitoreo lote norte" />
                    <small>Use entre 3 y 150 caracteres para identificar la inspección.</small>
                </div>

                @if (mostrarBuscadorTerreno && PuedeBuscarTerrenos)
                {
                    <div class="fit-search-slot">
                        <BuscadorTerrenoFitosanitario OnSeleccionado="SeleccionarTerreno" />
                    </div>
                }

                <div class="fit-field full">
                    <label>Observación general</label>
                    <textarea @bind="observacion" maxlength="1000" rows="3"
                              placeholder="Contexto general observado durante la visita"></textarea>
                </div>

                <div class="fit-field full">
                    <div class="fit-evidence-heading">
                        <label>Fotografías *</label>
                        <span class="fit-evidence-counter"><i class="fa-regular fa-images" aria-hidden="true"></i> @fotosNueva.Count de 40</span>
                    </div>
                    <label class="fit-file-drop">
                        <i class="fa-solid fa-images"></i>
                        <strong>Seleccionar fotografías</strong>
                        <span>JPG, PNG o WEBP. Hasta 40 evidencias; máximo 12 MB por foto.</span>
                        <InputFile OnChange="SeleccionarFotosAsync" multiple accept="image/*" />
                    </label>
                </div>
            </div>

            @if (fotosNueva.Count > 0)
            {
                <div class="fit-upload-list" aria-label="Fotografías seleccionadas">
                    <div class="fit-upload-summary">
                        <strong><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Evidencias por registrar</strong>
                        <span>Revise el tipo y la fecha de cada fotografía.</span>
                    </div>
                    @for (int i = 0; i < fotosNueva.Count; i++)
                    {
                        FotoFitosanitariaCargaWeb foto = fotosNueva[i];
                        int indice = i;
                        <div class="fit-upload-item">
                            <div class="fit-file-icon"><i class="fa-regular fa-image"></i></div>
                            <div class="fit-file-name">
                                <strong>@foto.Archivo.Name</strong>
                                <span>@FormatoBytes(foto.Archivo.Size)</span>
                            </div>
                            <div class="fit-field compact">
                                <label>Tipo</label>
                                <select @bind="foto.TipoFotografia">
                                    @foreach (TipoFotografiaIAWeb tipo in tiposFotografia)
                                    {
                                        <option value="@tipo.Codigo">@tipo.Nombre</option>
                                    }
                                </select>
                            </div>
                            <div class="fit-field compact">
                                <label>Fecha en campo</label>
                                <input type="date" @bind="foto.FechaIdentificacionCampo" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <button class="fit-icon-btn danger" @onclick="() => EliminarFoto(indice)" aria-label="Quitar fotografía">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                            @if (tiposFotografia.FirstOrDefault(t => t.Codigo == foto.TipoFotografia) is TipoFotografiaIAWeb seleccionado &&
                                 !string.IsNullOrWhiteSpace(seleccionado.InstruccionIA))
                            {
                                <p class="fit-photo-help"><i class="fa-solid fa-wand-magic-sparkles"></i> @seleccionado.InstruccionIA</p>
                            }
                        </div>
                    }
                </div>
            }
            </div>

            <footer>
                <button class="fit-btn fit-btn-light" @onclick="CerrarNuevaInspeccion" disabled="@guardando">Cancelar</button>
                <button class="fit-btn fit-btn-primary" @onclick="GuardarNuevaInspeccionAsync" disabled="@guardando">
                    @if (guardando)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>Registrando...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Registrar inspección</span>
                    }
                </button>
            </footer>
        </section>
    </div>
}

@code {
    private readonly List<InspeccionFitosanitariaBandejaItemWeb> inspecciones = [];
    private readonly List<FotoFitosanitariaCargaWeb> fotosNueva = [];
    private List<TipoFotografiaIAWeb> tiposFotografia = [];

    private string vistaActual = "mis";
    private string buscar = string.Empty;
    private string estado = string.Empty;
    private string filtroPropietario = string.Empty;
    private string filtroDepartamento = string.Empty;
    private string filtroTipoFotografia = string.Empty;
    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private bool cargando;
    private bool guardando;
    private bool hayMas;
    private DateTime? siguienteFechaUtc;
    private int? siguienteId;
    private bool mostrarNueva;
    private bool mostrarBuscadorTerreno;
    private TerrenoBusquedaIAItemWeb? terrenoSeleccionado;
    private string codigoTerreno = string.Empty;
    private string nombreInspeccion = string.Empty;
    private string observacion = string.Empty;
    private string mensaje = string.Empty;
    private bool mensajeError;

    private bool PuedeSolicitud =>
        AuthState.TienePermisoDirectoLectura(PermisosWeb.DiagnosticoSolicitud);

    private bool PuedeCrear =>
        AuthState.TienePermisoDirectoAgregar(PermisosWeb.DiagnosticoSolicitud);

    private bool PuedeBuscarTerrenos =>
        AuthState.TienePermisoDirectoLectura("terrenoPage");

    private bool PuedeAnalizador =>
        AuthState.TienePermisoDirectoLectura(PermisosWeb.DiagnosticoAnalizador);

    private bool PuedeAprobador =>
        AuthState.TienePermisoDirectoLectura(PermisosWeb.DiagnosticoAprobador);

    private bool PuedeTomarAnalizador =>
        AuthState.TienePermisoDirectoActualizar(PermisosWeb.DiagnosticoAnalizador);

    private bool PuedeTomarAprobador =>
        AuthState.TienePermisoDirectoActualizar(PermisosWeb.DiagnosticoAprobador);

    private bool EsVistaDisponible => vistaActual is
        "analizador-disponibles" or "aprobador-disponibles";

    private bool PuedeTomarVistaActual => vistaActual switch
    {
        "analizador-disponibles" => PuedeTomarAnalizador,
        "aprobador-disponibles" => PuedeTomarAprobador,
        _ => false
    };

    protected override async Task OnInitializedAsync()
    {
        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!PuedeSolicitud && !PuedeAnalizador && !PuedeAprobador)
        {
            Navigation.NavigateTo("/");
            return;
        }

        vistaActual = PuedeSolicitud
            ? "mis"
            : PuedeAnalizador
                ? "analizador"
                : "aprobador";

        await CargarTiposFotografiaAsync(mostrarError: false);
        await RecargarAsync();
    }

    private async Task<bool> CargarTiposFotografiaAsync(bool mostrarError = true)
    {
        try
        {
            List<TipoFotografiaIAWeb> catalogo =
                await Servicio.ObtenerTiposFotografiaAsync();

            tiposFotografia = catalogo
                .Where(tipo =>
                    tipo.Activo &&
                    !string.IsNullOrWhiteSpace(tipo.Codigo))
                .OrderBy(tipo => tipo.Orden)
                .ThenBy(tipo => tipo.Nombre)
                .ToList();

            if (tiposFotografia.Count == 0)
                throw new InvalidOperationException(
                    "No existen tipos de fotografía activos disponibles para registrar evidencia.");

            return true;
        }
        catch (Exception ex)
        {
            tiposFotografia = [];
            if (mostrarError)
            {
                MostrarMensaje(
                    string.IsNullOrWhiteSpace(ex.Message)
                        ? "No fue posible cargar el catálogo oficial de tipos de fotografía."
                        : ex.Message,
                    true);
            }
            return false;
        }
    }

    private async Task CambiarVistaAsync(string vista)
    {
        vistaActual = vista;
        await RecargarAsync();
    }

    private Task AplicarFiltrosAsync() => RecargarAsync();

    private async Task LimpiarFiltrosAsync()
    {
        buscar = string.Empty;
        estado = string.Empty;
        filtroPropietario = string.Empty;
        filtroDepartamento = string.Empty;
        filtroTipoFotografia = string.Empty;
        fechaDesde = null;
        fechaHasta = null;
        await RecargarAsync();
    }

    private async Task RecargarAsync()
    {
        inspecciones.Clear();
        siguienteFechaUtc = null;
        siguienteId = null;
        hayMas = false;
        await CargarPaginaAsync(false);
    }

    private Task CargarMasAsync() => CargarPaginaAsync(true);

    private async Task CargarPaginaAsync(bool agregar)
    {
        if (cargando)
            return;

        cargando = true;
        try
        {
            InspeccionFitosanitariaBandejaWeb pagina =
                await Servicio.ObtenerBandejaAsync(
                    vistaActual,
                    buscar,
                    filtroPropietario,
                    null,
                    filtroDepartamento,
                    filtroTipoFotografia,
                    estado,
                    fechaDesde,
                    fechaHasta,
                    agregar ? siguienteFechaUtc : null,
                    agregar ? siguienteId : null,
                    20);

            if (!agregar)
                inspecciones.Clear();

            foreach (InspeccionFitosanitariaBandejaItemWeb item in pagina.Items)
            {
                if (inspecciones.All(x => x.InspeccionId != item.InspeccionId))
                    inspecciones.Add(item);
            }

            hayMas = pagina.HayMas;
            siguienteFechaUtc = pagina.SiguienteFechaUtc;
            siguienteId = pagina.SiguienteId;
        }
        catch (Exception ex)
        {
            MostrarMensaje(ex.Message, true);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task TomarExpedienteAsync(
        InspeccionFitosanitariaBandejaItemWeb item)
    {
        if (!EsVistaDisponible || !PuedeTomarVistaActual || cargando)
            return;

        string etapa = vistaActual == "aprobador-disponibles"
            ? "aprobador"
            : "analizador";

        bool asignado = false;
        cargando = true;
        try
        {
            await Servicio.TomarExpedienteAsync(
                item.InspeccionId,
                etapa);

            asignado = true;
            vistaActual = etapa;
            MostrarMensaje(
                $"El expediente #{item.InspeccionId} quedó asignado a tu usuario. Ahora aparece en Mis expedientes.",
                false);
        }
        catch (Exception ex)
        {
            MostrarMensaje(ex.Message, true);
        }
        finally
        {
            cargando = false;
        }

        /*
         * Si hubo una carrera y otro usuario tomó primero el expediente, se
         * refresca Disponibles. Si la operación fue exitosa, se carga la nueva
         * bandeja personal para que la asignación sea visible inmediatamente.
         */
        await RecargarAsync();

        if (asignado)
            StateHasChanged();
    }

    private async Task AbrirNuevaInspeccion()
    {
        if (!PuedeCrear)
            return;

        if (!await CargarTiposFotografiaAsync())
            return;

        codigoTerreno = string.Empty;
        terrenoSeleccionado = null;
        mostrarBuscadorTerreno = false;
        nombreInspeccion = string.Empty;
        observacion = string.Empty;
        fotosNueva.Clear();
        mostrarNueva = true;
    }

    private void CerrarNuevaInspeccion()
    {
        if (!guardando)
        {
            mostrarNueva = false;
            mostrarBuscadorTerreno = false;
        }
    }

    private void SeleccionarTerreno(TerrenoBusquedaIAItemWeb terreno)
    {
        if (terreno.TerrenoId <= 0 || string.IsNullOrWhiteSpace(terreno.CodigoTerreno))
            return;

        terrenoSeleccionado = terreno;
        codigoTerreno = terreno.CodigoTerreno;
        mostrarBuscadorTerreno = false;
    }

    private void QuitarTerrenoSeleccionado()
    {
        terrenoSeleccionado = null;
        codigoTerreno = string.Empty;
    }

    private Task SeleccionarFotosAsync(InputFileChangeEventArgs e)
    {
        try
        {
            if (tiposFotografia.Count == 0)
            {
                MostrarMensaje(
                    "El catálogo oficial de tipos de fotografía no está disponible. Cierre el formulario y vuelva a intentarlo.",
                    true);
                return Task.CompletedTask;
            }

            IReadOnlyList<IBrowserFile> archivos = e.GetMultipleFiles(40);
            string tipoInicial = tiposFotografia[0].Codigo;

            foreach (IBrowserFile archivo in archivos)
            {
                if (fotosNueva.Count >= 40)
                    break;

                if (archivo.Size > 12L * 1024L * 1024L)
                {
                    MostrarMensaje($"{archivo.Name} supera el máximo de 12 MB.", true);
                    continue;
                }

                fotosNueva.Add(new FotoFitosanitariaCargaWeb
                {
                    Archivo = archivo,
                    TipoFotografia = tipoInicial,
                    FechaIdentificacionCampo = DateTime.Today
                });
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje(ex.Message, true);
        }

        return Task.CompletedTask;
    }

    private void EliminarFoto(int indice)
    {
        if (indice >= 0 && indice < fotosNueva.Count)
            fotosNueva.RemoveAt(indice);
    }

    private async Task GuardarNuevaInspeccionAsync()
    {
        if (guardando)
            return;

        if (string.IsNullOrWhiteSpace(codigoTerreno))
        {
            MostrarMensaje("Debe indicar el código del terreno.", true);
            return;
        }

        string nombre = nombreInspeccion.Trim();
        if (nombre.Length < 3)
        {
            MostrarMensaje(
                "Escriba un nombre de al menos 3 caracteres para identificar la inspección.",
                true);
            return;
        }

        if (nombre.Length > 150)
        {
            MostrarMensaje(
                "El nombre de la inspección no puede superar 150 caracteres.",
                true);
            return;
        }

        if (tiposFotografia.Count == 0)
        {
            MostrarMensaje(
                "El catálogo oficial de tipos de fotografía no está disponible.",
                true);
            return;
        }

        if (fotosNueva.Count == 0)
        {
            MostrarMensaje("Debe seleccionar al menos una fotografía.", true);
            return;
        }

        if (fotosNueva.Any(x =>
                string.IsNullOrWhiteSpace(x.TipoFotografia) ||
                !tiposFotografia.Any(tipo => string.Equals(
                    tipo.Codigo,
                    x.TipoFotografia,
                    StringComparison.OrdinalIgnoreCase))))
        {
            MostrarMensaje(
                "Una o más fotografías tienen un tipo que ya no está activo en el catálogo. Revise la selección.",
                true);
            return;
        }

        if (fotosNueva.Any(x => x.FechaIdentificacionCampo.Date > DateTime.Today))
        {
            MostrarMensaje("La fecha de identificación en campo no puede estar en el futuro.", true);
            return;
        }

        guardando = true;
        try
        {
            InspeccionFitosanitariaDetalleWeb creada =
                await Servicio.CrearAsync(
                    codigoTerreno,
                    nombre,
                    observacion,
                    fotosNueva);

            mostrarNueva = false;
            MostrarMensaje("La inspección fue registrada. Puede seleccionar las fotografías que desea procesar con IA.", false);
            await RecargarAsync();
            Navigation.NavigateTo($"/inspeccion-fitosanitaria/{creada.InspeccionId}?modo=mis");
        }
        catch (Exception ex)
        {
            MostrarMensaje(ex.Message, true);
        }
        finally
        {
            guardando = false;
        }
    }

    private void AbrirDetalle(InspeccionFitosanitariaBandejaItemWeb item)
    {
        /*
         * Disponibles se toma desde la bandeja. Abrir el expediente no debe
         * provocar una asignación implícita ni presentar herramientas de edición.
         */
        if (EsVistaDisponible)
            return;

        Navigation.NavigateTo(
            $"/inspeccion-fitosanitaria/{item.InspeccionId}?modo={Uri.EscapeDataString(vistaActual)}");
    }

    private void MostrarMensaje(string texto, bool error)
    {
        mensaje = texto;
        mensajeError = error;
    }

    private static string NombreInspeccion(InspeccionFitosanitariaBandejaItemWeb item) =>
        string.IsNullOrWhiteSpace(item.NombreInspeccion)
            ? $"Inspección #{item.InspeccionId}"
            : item.NombreInspeccion;

    private static string Terreno(InspeccionFitosanitariaBandejaItemWeb item) =>
        string.IsNullOrWhiteSpace(item.CodigoTerreno)
            ? "Terreno sin código"
            : item.CodigoTerreno;

    private static int PorcentajeAvance(InspeccionFitosanitariaBandejaItemWeb item) =>
        item.TotalFotografias <= 0
            ? 0
            : (int)Math.Clamp(
                Math.Round(100d * item.Finalizadas / item.TotalFotografias),
                0d,
                100d);

    private static string Tecnico(InspeccionFitosanitariaBandejaItemWeb item) =>
        !string.IsNullOrWhiteSpace(item.TecnicoNombreCompleto)
            ? item.TecnicoNombreCompleto
            : !string.IsNullOrWhiteSpace(item.TecnicoUsuario)
                ? item.TecnicoUsuario
                : $"Usuario #{item.UsuarioTecnicoId}";

    private static DateTime Local(DateTime utc) =>
        utc.Kind == DateTimeKind.Utc ? utc.ToLocalTime() : DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();

    private static string TextoEstado(string? estado) =>
        (estado ?? string.Empty).Replace('_', ' ').ToLowerInvariant() switch
        {
            "" => "Sin estado",
            var texto => char.ToUpperInvariant(texto[0]) + texto[1..]
        };

    private static string TextoEstadoBandeja(InspeccionFitosanitariaBandejaItemWeb item)
    {
        if (!item.CerradaDefinitiva && item.RequierenDecisionTecnico > 0)
            return item.RequierenDecisionTecnico == 1
                ? "Pendiente de decisión técnica"
                : $"{item.RequierenDecisionTecnico} decisiones técnicas pendientes";

        if (!item.CerradaDefinitiva && item.Procesando > 0)
            return "Análisis IA en proceso";

        if (!item.CerradaDefinitiva &&
            !item.EtapaTecnicaFinalizada &&
            item.EnviadasRevision > 0)
        {
            return "Pendiente de revisión";
        }

        if (string.Equals(item.Estado, "BORRADOR", StringComparison.OrdinalIgnoreCase) &&
            item.TotalFotografias > 0)
        {
            return "En proceso";
        }

        return TextoEstado(item.Estado);
    }

    private static string ClaseEstadoBandeja(InspeccionFitosanitariaBandejaItemWeb item)
    {
        if (!item.CerradaDefinitiva && item.RequierenDecisionTecnico > 0)
            return "warn";
        if (!item.CerradaDefinitiva && item.ConError > 0)
            return "danger";
        if (!item.CerradaDefinitiva && (item.Procesando > 0 || item.EnviadasRevision > 0))
            return "blue";
        return ClaseEstado(item.Estado);
    }

    private static string ClaseEstado(string? estado) =>
        (estado ?? string.Empty).ToUpperInvariant() switch
        {
            "FINALIZADA" => "ok",
            "FINALIZADA_PARCIALMENTE" => "warn",
            "PENDIENTE_APROBACION" => "purple",
            "PENDIENTE_REVISION" => "blue",
            "EN_PROCESO_CON_ERRORES" => "danger",
            "EN_PROCESO" => "blue",
            _ => "neutral"
        };

    private static string FormatoBytes(long bytes) =>
        bytes >= 1024L * 1024L
            ? $"{bytes / 1024d / 1024d:N1} MB"
            : $"{bytes / 1024d:N0} KB";
}
