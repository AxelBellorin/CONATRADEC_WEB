    {
        usuarioAsignacionSeleccionadoId = usuario.UsuarioId;
        buscarUsuarioAsignacion = TextoUsuarioAsignacion(usuario);
        buscarTerrenoAsignacion = string.Empty;
        nuevaAsignacion = new AsignarUsuarioTerrenoRequest
        {
