    private void DesactivarCapasSuelo()
    {
        foreach (string clave in capasActivas.Keys
                     .Where(EsCapaSuelo)
                     .ToList())
        {
            capasActivas[clave] = false;
        }

        foreach (string clave in ClavesSueloBase)
            capasActivas[clave] = false;

        foreach (PortalCentroNutriente nutriente in datos?.NutrientesDisponibles ?? [])
            capasActivas[nutriente.Clave] = false;
    }

    private CapaSueloMapaRespuesta ConstruirCapaSuelo(string clave)
    {
        List<ValorSueloTerreno> valores = TerrenosFiltrados
            .Select(terreno => new ValorSueloTerreno
            {
                Terreno = terreno,
                Valor = ObtenerValorSuelo(terreno, clave),
                Clasificacion = ObtenerClasificacionSuelo(terreno, clave)
            })
            .Where(x => x.Valor.HasValue)
            .ToList();

        bool municipal = departamentoId.HasValue;

        IEnumerable<IGrouping<string, ValorSueloTerreno>> grupos = municipal
            ? valores.GroupBy(x =>
                $"{x.Terreno.DepartamentoId}|{x.Terreno.MunicipioId}")
            : valores.GroupBy(x =>
                x.Terreno.DepartamentoId.ToString(
                    CultureInfo.InvariantCulture));

        List<ResumenTerritorialSueloMapa> regiones = grupos
            .Select(grupo =>
            {
                var items = grupo.ToList();
                PortalCentroTerreno primero = items[0].Terreno;
                decimal[] numeros = items
                    .Select(x => x.Valor!.Value)
                    .ToArray();
                decimal promedio = numeros.Average();
                string clasificacion = ClasificarPromedio(
                    clave,
                    promedio,
                    items.Select(x => x.Clasificacion));

                return new ResumenTerritorialSueloMapa
                {
                    TipoTerritorio = municipal
                        ? "MUNICIPIO"
                        : "DEPARTAMENTO",
                    NombreTerritorio = municipal
                        ? primero.Municipio
                        : primero.Departamento,
                    DepartamentoId = primero.DepartamentoId,
                    Departamento = primero.Departamento,
                    MunicipioId = municipal
                        ? primero.MunicipioId
                        : null,
                    Municipio = municipal
                        ? primero.Municipio
                        : string.Empty,
                    Promedio = promedio,
                    Minimo = numeros.Min(),
                    Maximo = numeros.Max(),
                    TerrenosAnalizados = items.Count,
                    Clasificacion = clasificacion,
                    Color = ColorClasificacion(clave, promedio, clasificacion),
                    FechaMasReciente = items
                        .Select(x => x.Terreno.FechaUltimoAnalisis)
                        .Where(x => x.HasValue)
                        .Select(x => x!.Value)
                        .DefaultIfEmpty(DateTime.UtcNow)
                        .Max(),
                    MuestraLimitada = items.Count < 3
                };
            })
            .OrderBy(x => x.NombreTerritorio)
            .ToList();

        decimal? minimo = valores.Count > 0
            ? valores.Min(x => x.Valor!.Value)
            : null;
        decimal? maximo = valores.Count > 0
            ? valores.Max(x => x.Valor!.Value)
            : null;

        return new CapaSueloMapaRespuesta
        {
            Disponible = regiones.Count > 0,
            Mensaje = regiones.Count > 0
                ? "Capa construida únicamente con los terrenos del propietario."
                : "No existen valores disponibles para esta capa.",
            Clave = clave,
            Nombre = NombreCapaSuelo(clave),
            Descripcion = "Promedio territorial del último análisis de sus terrenos.",
            Unidad = UnidadCapaSuelo(clave),
            NivelAgrupacion = municipal
                ? "MUNICIPIO"
                : "DEPARTAMENTO",
            ActualizadoUtc = DateTime.UtcNow,
            Minimo = minimo,
            Maximo = maximo,
            TotalRegiones = regiones.Count,
            TotalTerrenosAnalizados = valores.Count,
            Leyenda = CrearLeyendaSuelo(clave),
            Regiones = regiones
        };
    }

