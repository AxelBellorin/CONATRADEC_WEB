                            StringComparison.OrdinalIgnoreCase))
            .Where(x => terrenoIdSeleccionado <= 0 ||
                        x.TerrenoId == terrenoIdSeleccionado)
            .Where(x => !soloConAlertas || x.Alertas.Count > 0)
            .ToList();

