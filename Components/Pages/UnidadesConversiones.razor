    private async Task AbrirEditorElementoAsync(
        ElementoConfiguracionUnidadesAdminModel elemento)
    {
        procesando = true;
        LimpiarMensajes();

        try
        {
            ConfiguracionUnidadesApiResponseModel<
                ElementoConfiguracionUnidadesAdminModel>? respuesta =
                    await Api.GetAsync<
                        ConfiguracionUnidadesApiResponseModel<
                            ElementoConfiguracionUnidadesAdminModel>>(
                        "api/configuracion-unidades/elemento/" +
                        elemento.ElementoQuimicosId +
                        "?incluirInactivas=true",
                        cancellation.Token);

            elementoEditor = respuesta?.Data ?? elemento;
            editorMateriaOrganica = false;
            tituloEditor = elementoEditor.NombreMostrar;
            subtituloEditor = "Unidades del elemento químico";

            ConstruirEditor(elementoEditor.Unidades);
            ForzarUnidadInternaKgHa();
            mostrarEditorConversion = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private void AbrirEditorMateria()
    {
        elementoEditor = null;
        editorMateriaOrganica = true;
        tituloEditor = "Materia orgánica";
        subtituloEditor = "Unidades normalizadas a porcentaje";

        ConstruirEditor(materiaOrganica);

        foreach (UnidadConversionEdicionModel item in editorUnidades)
        {
            item.CodigoFormulaConversion = "LINEAL";
        }

        mostrarEditorConversion = true;
    }

    private void ConstruirEditor(
        IEnumerable<UnidadConversionConfiguradaAdminModel> existentes)
    {
        Dictionary<int, UnidadConversionConfiguradaAdminModel> mapa =
            existentes.ToDictionary(item => item.UnidadMedidaId);

        editorUnidades.Clear();

        int siguienteOrden = 10;

        foreach (UnidadCatalogoAdminModel unidad in unidades
            .OrderByDescending(item => item.Activo)
            .ThenBy(item => item.NombreUnidadMedida))
        {
            mapa.TryGetValue(
                unidad.UnidadMedidaId,
                out UnidadConversionConfiguradaAdminModel? configuracion);

            editorUnidades.Add(
                new UnidadConversionEdicionModel
                {
                    ConfiguracionId = configuracion?.ConfiguracionId ?? 0,
                    UnidadMedidaId = unidad.UnidadMedidaId,
                    NombreUnidadMedida = unidad.NombreUnidadMedida,
                    UnidadCatalogoActiva = unidad.Activo,
                    Seleccionada = configuracion?.Activo ?? false,
                    CodigoFormulaConversion =
                        configuracion?.CodigoFormulaConversion ?? "LINEAL",
                    FactorPrincipal = configuracion?.FactorPrincipal ?? 1m,
                    FactorSecundario = configuracion?.FactorSecundario ?? 1m,
                    FactorTerciario = configuracion?.FactorTerciario ?? 1m,
                    Divisor = configuracion?.Divisor ?? 1m,
                    Desplazamiento = configuracion?.Desplazamiento ?? 0m,
                    UnidadPredeterminada =
                        configuracion?.UnidadPredeterminada ?? false,
                    VisibleEnFormulario =
                        configuracion?.VisibleEnFormulario ?? true,
                    Orden = configuracion?.Orden ?? siguienteOrden,
                    Observacion = configuracion?.Observacion ?? string.Empty
                });

            siguienteOrden += 10;
        }
    }

    private void ForzarUnidadInternaKgHa()
    {
        UnidadConversionEdicionModel? kgHa =
            editorUnidades.FirstOrDefault(item => item.EsUnidadInternaKgHa);

        if (kgHa is null)
            return;

        kgHa.Seleccionada = true;
        kgHa.UnidadCatalogoActiva = true;
    }

    private void MarcarPredeterminada(
        UnidadConversionEdicionModel seleccionada)
    {
        foreach (UnidadConversionEdicionModel item in editorUnidades)
        {
            item.UnidadPredeterminada =
                ReferenceEquals(item, seleccionada);
        }
    }

    private async Task CerrarEditorConversionAsync()
    {
        if (procesando)
            return;

        mostrarEditorConversion = false;
        editorUnidades.Clear();
        elementoEditor = null;
        errorEditor = null;

        await Task.CompletedTask;
    }

    private async Task GuardarEditorConversionAsync()
    {
        errorEditor = null;

        List<UnidadConversionEdicionModel> seleccionadas =
            editorUnidades
                .Where(item => item.Seleccionada)
                .ToList();

        if (seleccionadas.Count == 0)
        {
            errorEditor =
                "Debe seleccionar al menos una unidad.";
            return;
        }

        if (!editorMateriaOrganica &&
            !seleccionadas.Any(item => item.EsUnidadInternaKgHa))
        {
            errorEditor =
                "No está disponible la configuración técnica requerida por " +
                "el motor de conversión. Actualice la página y vuelva a " +
                "intentarlo.";
            return;
        }

        if (seleccionadas.Any(item => item.Divisor == 0))
        {
            errorEditor =
                "El divisor no puede ser cero.";
            return;
        }

        if (seleccionadas.Count(item =>
                item.UnidadPredeterminada &&
                item.VisibleEnFormulario) > 1)
        {
            errorEditor =
                "Solo puede existir una unidad predeterminada visible.";
            return;
        }

        bool confirmar =
            await JS.InvokeAsync<bool>(
                "confirm",
                "¿Desea guardar esta configuración de conversiones? " +
                "Los análisis nuevos utilizarán los valores actualizados.");

        if (!confirmar)
            return;

        procesando = true;

        try
        {
            var request =
                new GuardarConfiguracionUnidadesRequestModel
                {
                    Unidades = seleccionadas
                        .Select(item =>
                            new GuardarUnidadConversionRequestModel
                            {
                                UnidadMedidaId = item.UnidadMedidaId,
                                CodigoFormulaConversion =
                                    editorMateriaOrganica
                                        ? "LINEAL"
                                        : item.CodigoFormulaConversion,
                                FactorPrincipal = item.FactorPrincipal,
                                FactorSecundario = item.FactorSecundario,
                                FactorTerciario = item.FactorTerciario,
                                Divisor = item.Divisor,
                                Desplazamiento = item.Desplazamiento,
                                UnidadPredeterminada =
                                    item.UnidadPredeterminada,
                                VisibleEnFormulario =
                                    item.VisibleEnFormulario,
                                Orden = item.Orden,
                                Observacion =
                                    (item.Observacion ?? string.Empty).Trim(),
                                Activo = true
                            })
                        .ToList()
                };

            if (editorMateriaOrganica)
            {
                await Api.PutAsync<
                    GuardarConfiguracionUnidadesRequestModel,
                    ConfiguracionUnidadesApiResponseModel<
                        List<UnidadConversionConfiguradaAdminModel>>>(
                    "api/configuracion-unidades/materia-organica",
                    request,
                    cancellation.Token);
            }
            else if (elementoEditor is not null)
            {
                await Api.PutAsync<
                    GuardarConfiguracionUnidadesRequestModel,
                    ConfiguracionUnidadesApiResponseModel<
                        ElementoConfiguracionUnidadesAdminModel>>(
                    "api/configuracion-unidades/elemento/" +
                    elementoEditor.ElementoQuimicosId,
                    request,
                    cancellation.Token);
            }

            mostrarEditorConversion = false;
            mensaje =
                "Configuración de unidades actualizada correctamente.";

            await CargarTodoAsync();
        }
        catch (Exception ex)
        {
            errorEditor = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private void InicializarPrueba()
    {
        elementoPruebaId =
            elementos.FirstOrDefault()?.ElementoQuimicosId ?? 0;

        prueba = new ProbarConversionUnidadRequestModel
        {
            Contexto = contextoPrueba,
            ElementoQuimicosId = elementoPruebaId > 0
                ? elementoPruebaId
                : null,
            MateriaOrganicaPorcentaje = 3m
        };

        SincronizarUnidadPrueba();
        resultadoPrueba = null;
    }

    private void CambiarContextoPrueba()
    {
        prueba.Contexto = contextoPrueba;
        prueba.ElementoQuimicosId =
            contextoPrueba == "ELEMENTO"
                ? elementoPruebaId
                : null;

        SincronizarUnidadPrueba();
        resultadoPrueba = null;
    }

    private void SincronizarUnidadPrueba()
    {
        prueba.ElementoQuimicosId =
            contextoPrueba == "ELEMENTO"
                ? elementoPruebaId
                : null;

        prueba.UnidadMedidaId =
            UnidadesDisponiblesPrueba
                .FirstOrDefault(item => item.UnidadPredeterminada)
                ?.UnidadMedidaId ??
            UnidadesDisponiblesPrueba
                .FirstOrDefault()
                ?.UnidadMedidaId ??
            0;
    }

    private async Task ProbarConversionAsync()
    {
        if (prueba.UnidadMedidaId <= 0)
        {
            error =
                "Seleccione una unidad configurada para ejecutar la prueba.";
            return;
        }

        if (contextoPrueba == "ELEMENTO" &&
            elementoPruebaId <= 0)
        {
            error =
                "Seleccione un elemento químico.";
            return;
        }

        procesando = true;
        LimpiarMensajes();

        try
        {
            prueba.Contexto = contextoPrueba;
            prueba.ElementoQuimicosId =
                contextoPrueba == "ELEMENTO"
                    ? elementoPruebaId
                    : null;

            ConfiguracionUnidadesApiResponseModel<
                ResultadoPruebaConversionAdminModel>? respuesta =
                    await Api.PostAsync<
                        ProbarConversionUnidadRequestModel,
                        ConfiguracionUnidadesApiResponseModel<
                            ResultadoPruebaConversionAdminModel>>(
                        "api/configuracion-unidades/probar",
                        prueba,
                        cancellation.Token);

            resultadoPrueba = respuesta?.Data;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            resultadoPrueba = null;
        }
        finally
        {
            procesando = false;
        }
    }

    private string NombreUnidadPredeterminada(
        ElementoConfiguracionUnidadesAdminModel elemento)
    {
        return elemento.Unidades
            .FirstOrDefault(item =>
                item.Activo &&
                !item.EsUnidadInternaKgHa &&
                item.UnidadPredeterminada)
            ?.NombreUnidadMedida ??
            "Sin definir";
    }

    private string DescripcionFormula(string codigo)
    {
        return formulas
            .FirstOrDefault(item =>
                string.Equals(
                    item.Codigo,
                    codigo,
                    StringComparison.OrdinalIgnoreCase))
            ?.Descripcion ??
            codigo;
    }

    private void LimpiarMensajes()
    {
        mensaje = null;
        error = null;
        errorEditor = null;
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
