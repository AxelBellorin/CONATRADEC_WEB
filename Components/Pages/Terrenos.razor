        };

    private IEnumerable<int> PaginasVisibles
    {
        get
        {
            int inicio = Math.Max(1, pagina.Page - 2);
            int fin = Math.Min(
                Math.Max(1, pagina.TotalPages),
                inicio + 4);

            inicio = Math.Max(1, fin - 4);

            return Enumerable.Range(
                inicio,
                Math.Max(1, fin - inicio + 1));
        }
    }

    private List<TerrenoCatalogo> Paises =>
        municipios
            .GroupBy(x => new { x.PaisId, x.NombrePais })
            .Select(x => new TerrenoCatalogo
            {
                Id = x.Key.PaisId,
                Nombre = x.Key.NombrePais
            })
            .OrderBy(x => x.Nombre)
            .ToList();

    private List<TerrenoCatalogo> Departamentos =>
        municipios
            .GroupBy(x => new
            {
                x.DepartamentoId,
                x.NombreDepartamento
            })
            .Select(x => new TerrenoCatalogo
            {
                Id = x.Key.DepartamentoId,
                Nombre = x.Key.NombreDepartamento
            })
            .OrderBy(x => x.Nombre)
            .ToList();

    private List<MunicipioSelectorItem> MunicipiosFiltro =>
        municipios
            .Where(x =>
                !departamentoFiltro.HasValue ||
                x.DepartamentoId == departamentoFiltro.Value)
            .OrderBy(x => x.NombreMunicipio)
            .ToList();

    private List<TerrenoCatalogo> DepartamentosFormulario =>
        municipios
            .Where(x =>
                !formulario.PaisId.HasValue ||
                x.PaisId == formulario.PaisId.Value)
            .GroupBy(x => new
            {
                x.DepartamentoId,
                x.NombreDepartamento
            })
            .Select(x => new TerrenoCatalogo
            {
                Id = x.Key.DepartamentoId,
                Nombre = x.Key.NombreDepartamento
            })
            .OrderBy(x => x.Nombre)
            .ToList();

    private List<MunicipioSelectorItem> MunicipiosFormulario =>
        municipios
            .Where(x =>
                !formulario.DepartamentoId.HasValue ||
                x.DepartamentoId == formulario.DepartamentoId.Value)
            .OrderBy(x => x.NombreMunicipio)
            .ToList();

    private PropietarioTerrenoCatalogoItem? PropietarioSeleccionado =>
        propietarios.FirstOrDefault(x =>
            x.PropietarioId == formulario.PropietarioId);

    private MunicipioSelectorItem? MunicipioSeleccionado =>
        municipios.FirstOrDefault(x =>
            x.MunicipioId == formulario.MunicipioId);

    private decimal DiferenciaArea =>
        decimal.Round(
            Math.Abs(
                formulario.ExtensionManzanaTerreno -
                poligonoEdicion.AreaManzanas),
            4);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!AuthState.IsAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            referenciaEditor =
                DotNetObjectReference.Create(this);

            await Task.WhenAll(
                CargarCatalogosAsync(),
                CargarPoligonosAsync(),
                CargarPaginaAsync(1));
        }

        if (inicializarMapaPendiente &&
            modalFormulario &&
            pestanaFormulario == "MAPA")
        {
            inicializarMapaPendiente = false;

            await JS.InvokeVoidAsync(
                "conatradecTerrenoEditor.inicializar",
                EditorId,
                referenciaEditor,
                new
                {
                    latitud = formulario.Latitud,
                    longitud = formulario.Longitud,
                    vertices = poligonoEdicion.Vertices
                });
        }
    }

    private Task CargarAsync() =>
        CargarPaginaAsync(Math.Max(1, pagina.Page));

    private Task BuscarAsync() =>
        CargarPaginaAsync(1);

    private async Task LimpiarFiltrosAsync()
    {
        buscar = string.Empty;
        departamentoFiltro = null;
        municipioFiltro = null;
        tamanoPagina = 20;

        await CargarPaginaAsync(1);
    }

    private async Task CargarCatalogosAsync()
    {
        try
        {
            List<PropietarioTerrenoCatalogoItem>? propietariosApi =
                await Api.GetAsync<List<PropietarioTerrenoCatalogoItem>>(
                    "api/terreno/propietarios-disponibles");

            List<MunicipioSelectorItem>? municipiosApi =
                await Api.GetAsync<List<MunicipioSelectorItem>>(
                    "api/municipio/listarTodos-por-departamento-por-pais");

            propietarios.Clear();
            municipios.Clear();

            if (propietariosApi is not null)
                propietarios.AddRange(propietariosApi);

            if (municipiosApi is not null)
                municipios.AddRange(municipiosApi);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private async Task CargarPoligonosAsync()
    {
        try
        {
            List<TerrenoPoligonoWeb>? datos =
                await Api.GetAsync<List<TerrenoPoligonoWeb>>(
                    "api/terreno-poligono/resumen");

            poligonos.Clear();

            foreach (TerrenoPoligonoWeb item in datos ?? [])
                poligonos[item.TerrenoId] = item;

            await JS.InvokeVoidAsync(
                "conatradecTerrenoPoligonosMapa.establecerPoligonos",
                datos ?? []);
        }
        catch
        {
            poligonos.Clear();
        }
    }

    private async Task CargarPaginaAsync(int numero)
    {
        if (!PuedeLeer)
        {
            cargando = false;
            return;
        }

        cargando = true;
        LimpiarMensajes();

        try
        {
            string ruta =
                "api/terreno/buscar" +
                $"?page={numero}" +
                $"&pageSize={tamanoPagina}" +
                "&ordenarPor=codigo" +
                "&descendente=false";

            if (!string.IsNullOrWhiteSpace(buscar))
                ruta += $"&texto={Uri.EscapeDataString(buscar.Trim())}";

            if (departamentoFiltro.HasValue)
                ruta += $"&departamentoId={departamentoFiltro.Value}";

            if (municipioFiltro.HasValue)
                ruta += $"&municipioId={municipioFiltro.Value}";

            pagina =
                await Api.GetAsync<TerrenoAdminPagina>(ruta) ??
                new TerrenoAdminPagina();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task IrPaginaAsync(int numero)
    {
        if (numero < 1 ||
            numero > Math.Max(1, pagina.TotalPages))
        {
            return;
        }

        await CargarPaginaAsync(numero);
    }

    private void DepartamentoFiltroCambiado(ChangeEventArgs e)
    {
        departamentoFiltro = ParseNullable(e.Value);
        municipioFiltro = null;
    }

    private void MunicipioFiltroCambiado(ChangeEventArgs e) =>
        municipioFiltro = ParseNullable(e.Value);

    private void AbrirCrear()
    {
        modoFormulario = "CREAR";
        pestanaFormulario = "DATOS";

        formulario = new TerrenoFormularioWeb
        {
            Latitud = 12.8654m,
            Longitud = -85.2072m,
            ExtensionManzanaTerreno = 0.01m
        };

        poligonoOriginal = new TerrenoPoligonoWeb();

        poligonoEdicion = new TerrenoEditorCambio
        {
            Latitud = formulario.Latitud,
            Longitud = formulario.Longitud
        };

        poligonoEliminadoManualmente = false;
        modalFormulario = true;
    }

    private Task AbrirEditarAsync(TerrenoAdminItem item) =>
        AbrirFormularioAsync(item, "EDITAR");

    private Task AbrirVerAsync(TerrenoAdminItem item) =>
        AbrirFormularioAsync(item, "VER");

    private async Task AbrirFormularioAsync(
        TerrenoAdminItem item,
        string modo)
    {
        modoFormulario = modo;
        pestanaFormulario = "DATOS";
        formulario = CrearFormulario(item);

        try
        {
            poligonoOriginal =
                await Api.GetAsync<TerrenoPoligonoWeb>(
                    $"api/terreno-poligono/{item.TerrenoId}") ??
                CrearPoligonoVacio(item);
        }
        catch
        {
            poligonoOriginal = CrearPoligonoVacio(item);
        }

        poligonoEdicion = new TerrenoEditorCambio
        {
            Latitud = item.Latitud,
            Longitud = item.Longitud,
            Vertices = poligonoOriginal.Vertices
                .Select(x => new TerrenoPoligonoVerticeWeb
                {
                    Latitud = x.Latitud,
                    Longitud = x.Longitud
                })
                .ToList(),
            AreaMetrosCuadrados = poligonoOriginal.AreaMetrosCuadrados,
            AreaHectareas = poligonoOriginal.AreaHectareas,
            AreaManzanas = poligonoOriginal.AreaManzanasCalculada,
            PuntoDentroPoligono = poligonoOriginal.PuntoDentroPoligono
        };

        poligonoEliminadoManualmente = false;
        modalFormulario = true;
    }

    private void ConvertirVistaAEdicion()
    {
        modoFormulario = "EDITAR";
        pestanaFormulario = "DATOS";
    }

    private void CambiarPestana(string pestana)
    {
        pestanaFormulario = pestana;

        if (pestana == "MAPA")
            inicializarMapaPendiente = true;
    }

    private async Task CerrarFormularioAsync()
    {
        if (procesando)
            return;

        modalFormulario = false;
        inicializarMapaPendiente = false;

        await JS.InvokeVoidAsync(
            "conatradecTerrenoEditor.destruir",
            EditorId);
    }

    private void PaisFormularioCambiado(ChangeEventArgs e)
    {
        formulario.PaisId = ParseNullable(e.Value);
        formulario.DepartamentoId = null;
        formulario.MunicipioId = 0;
    }

    private void DepartamentoFormularioCambiado(ChangeEventArgs e)
    {
        formulario.DepartamentoId = ParseNullable(e.Value);
        formulario.MunicipioId = 0;
    }

    [JSInvokable]
    public Task GeometriaTerrenoActualizada(
        TerrenoEditorCambio cambio)
    {
        poligonoEdicion = cambio;
        formulario.Latitud = cambio.Latitud;
        formulario.Longitud = cambio.Longitud;

        poligonoEliminadoManualmente =
            cambio.Vertices.Count < 3 &&
            poligonoOriginal.TienePoligono;

        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task DibujarPoligonoAsync() =>
        JS.InvokeVoidAsync(
            "conatradecTerrenoEditor.dibujarPoligono",
            EditorId).AsTask();

    private Task EditarPoligonoAsync() =>
        JS.InvokeVoidAsync(
            "conatradecTerrenoEditor.editarPoligono",
            EditorId).AsTask();

    private Task SeleccionarPuntoAsync() =>
        JS.InvokeVoidAsync(
            "conatradecTerrenoEditor.seleccionarPunto",
            EditorId).AsTask();

    private Task CentrarPuntoAsync() =>
        JS.InvokeVoidAsync(
            "conatradecTerrenoEditor.centrarPunto",
            EditorId).AsTask();

    private Task CentrarPoligonoAsync() =>
        JS.InvokeVoidAsync(
            "conatradecTerrenoEditor.centrarPoligono",
            EditorId).AsTask();

    private Task ActualizarPuntoMapaAsync() =>
        JS.InvokeVoidAsync(
            "conatradecTerrenoEditor.establecerPunto",
            EditorId,
            formulario.Latitud,
            formulario.Longitud,
            true).AsTask();

    private Task QuitarPoligonoAsync()
    {
        poligonoEliminadoManualmente =
            poligonoOriginal.TienePoligono;

        return JS.InvokeVoidAsync(
            "conatradecTerrenoEditor.eliminarPoligono",
            EditorId).AsTask();
    }

    private void UsarAreaCalculada()
    {
        if (poligonoEdicion.AreaManzanas > 0)
        {
            formulario.ExtensionManzanaTerreno =
                decimal.Round(
                    poligonoEdicion.AreaManzanas,
                    2);
        }
    }

    private async Task GuardarAsync()
    {
        if (procesando)
            return;

        if (formulario.Latitud == 0 &&
            formulario.Longitud == 0)
        {
            errorFormulario =
                "Seleccione el punto principal del terreno.";

            pestanaFormulario = "MAPA";
            inicializarMapaPendiente = true;
            return;
        }

        bool eraNuevo = formulario.TerrenoId <= 0;

        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            eraNuevo
                ? "¿Desea crear el terreno?"
                : "¿Desea actualizar el terreno?");

        if (!confirmar)
            return;

        procesando = true;
        errorFormulario = null;
        LimpiarMensajes();

        try
        {
            TerrenoOperacionWeb<TerrenoAdminItem>? respuesta;

            if (eraNuevo)
            {
                respuesta =
                    await Api.PostAsync<
                        TerrenoFormularioWeb,
                        TerrenoOperacionWeb<TerrenoAdminItem>>(
                        "api/terreno/crear",
                        formulario);
            }
            else
            {
                respuesta =
                    await Api.PutAsync<
                        TerrenoFormularioWeb,
                        TerrenoOperacionWeb<TerrenoAdminItem>>(
                        $"api/terreno/editar/{formulario.TerrenoId}",
                        formulario);
            }

            int terrenoId =
                respuesta?.Data?.TerrenoId ??
                formulario.TerrenoId;

            if (terrenoId <= 0)
            {
                throw new InvalidOperationException(
                    "El servidor no devolvió el identificador del terreno.");
            }

            /*
             * Si el terreno se creó pero falla el polígono, el formulario
             * pasa a edición. Así un segundo intento no duplica el terreno.
             */
            if (eraNuevo)
            {
                formulario.TerrenoId = terrenoId;
                formulario.CodigoTerreno =
                    respuesta?.Data?.CodigoTerreno ??
                    formulario.CodigoTerreno;
                formulario.FechaIngresoTerreno =
                    respuesta?.Data?.FechaIngresoTerreno ??
                    formulario.FechaIngresoTerreno;
                modoFormulario = "EDITAR";
            }

            if (poligonoEdicion.Vertices.Count >= 3)
            {
                var solicitud = new TerrenoPoligonoGuardarWeb
                {
                    Vertices = poligonoEdicion.Vertices
                };

                if (eraNuevo)
                {
                    await Api.PostAsync<
                        TerrenoPoligonoGuardarWeb,
                        TerrenoOperacionWeb<TerrenoPoligonoWeb>>(
                        $"api/terreno-poligono/{terrenoId}",
                        solicitud);
                }
                else
                {
                    await Api.PutAsync<
                        TerrenoPoligonoGuardarWeb,
                        TerrenoOperacionWeb<TerrenoPoligonoWeb>>(
                        $"api/terreno-poligono/{terrenoId}",
                        solicitud);
                }
            }
            else if (poligonoEliminadoManualmente)
            {
                await Api.EliminarAsync(
                    $"api/terreno-poligono/{terrenoId}");
            }

            await CerrarFormularioAsync();

            await Task.WhenAll(
                CargarPaginaAsync(eraNuevo ? 1 : pagina.Page),
                CargarPoligonosAsync());

            mensaje =
                !string.IsNullOrWhiteSpace(respuesta?.MensajeMostrar)
                    ? respuesta.MensajeMostrar
                    : "Terreno guardado correctamente.";
        }
        catch (Exception ex)
        {
            errorFormulario = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task EliminarTerrenoAsync(
        TerrenoAdminItem terreno)
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Desea desactivar el terreno \"{terreno.CodigoTerreno}\"?");

        if (!confirmar)
            return;

        procesando = true;
        LimpiarMensajes();

        try
        {
            await Api.EliminarAsync(
                $"api/terreno/eliminar/{terreno.TerrenoId}");

            await CargarPaginaAsync(pagina.Page);
            mensaje = "Terreno desactivado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task AbrirFotosAsync(TerrenoAdminItem terreno)
    {
        terrenoFotos = terreno;
        modalFotos = true;
        await CargarFotosAsync();
    }

    private async Task CargarFotosAsync()
    {
        if (terrenoFotos is null)
            return;

        cargandoFotos = true;

        try
        {
            fotos.Clear();

            List<TerrenoFotoWeb>? data =
                await Api.GetAsync<List<TerrenoFotoWeb>>(
                    $"api/fotoTerreno/por-terreno/{terrenoFotos.TerrenoId}");

            if (data is not null)
                fotos.AddRange(data);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargandoFotos = false;
        }
    }

    private void SeleccionarFotos(InputFileChangeEventArgs e)
    {
        archivosFotos.Clear();
        archivosFotos.AddRange(e.GetMultipleFiles(10));
    }

    private async Task SubirFotosAsync()
    {
        if (terrenoFotos is null ||
            archivosFotos.Count == 0)
        {
            return;
        }

        procesando = true;

        try
        {
            foreach (IBrowserFile archivo in archivosFotos)
            {
                await Api.SubirFormularioArchivoAsync<object>(
                    "api/fotoTerreno/subir",
                    archivo,
                    new Dictionary<string, string>
                    {
                        ["terrenoId"] =
                            terrenoFotos.TerrenoId.ToString()
                    },
                    nombreCampo: "fotos",
                    tamanoMaximo: MaximoFoto);
            }

            archivosFotos.Clear();
            await CargarFotosAsync();

            mensaje = "Fotografías guardadas correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task EliminarFotoAsync(TerrenoFotoWeb foto)
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "¿Desea eliminar esta fotografía?");

        if (!confirmar)
            return;

        procesando = true;

        try
        {
            await Api.EliminarAsync(
                $"api/fotoTerreno/eliminar/{foto.FotoTerrenoId}");

            await CargarFotosAsync();
            mensaje = "Fotografía eliminada correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private void CerrarFotos()
    {
        if (procesando)
            return;

        modalFotos = false;
        terrenoFotos = null;
        fotos.Clear();
        archivosFotos.Clear();
    }

    private async Task AbrirEliminadosAsync()
    {
        modalEliminados = true;
        cargandoEliminados = true;

        try
        {
            TerrenoEliminadosRespuesta? respuesta =
                await Api.GetAsync<TerrenoEliminadosRespuesta>(
                    "api/catalogos-eliminados/terreno",
                    AuthState.CrearEncabezadosSesion());

            eliminados.Clear();

            if (respuesta?.Data is not null)
                eliminados.AddRange(respuesta.Data);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargandoEliminados = false;
        }
    }

    private async Task ReactivarAsync(TerrenoEliminadoWeb terreno)
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Desea reactivar \"{terreno.Titulo}\"?");

        if (!confirmar)
            return;

        procesando = true;

        try
        {
            await Api.PutSinContenidoAsync(
                $"api/catalogos-eliminados/terreno/{terreno.Id}/reactivar",
                AuthState.CrearEncabezadosSesion());

            eliminados.Remove(terreno);
            await CargarPaginaAsync(1);

            mensaje = "Terreno reactivado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private void CerrarEliminados()
    {
        if (procesando)
            return;

        modalEliminados = false;
        eliminados.Clear();
    }

