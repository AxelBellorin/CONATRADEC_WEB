@page "/mapa"
@implements IAsyncDisposable
@inject AuthStateService AuthState
@inject MapaService MapaService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Centro Geoespacial | CONATRADEC</PageTitle>

<div class="geo-page-header">
    <div class="geo-title-block">
        <span class="geo-country-badge">
            <i class="fa-solid fa-location-dot"></i>
            República de Nicaragua
        </span>
        <p class="eyebrow">Inteligencia territorial nacional</p>
        <h1>Centro Geoespacial CONATRADEC</h1>
        <p>
            Integra terrenos, alertas, suelos y condiciones meteorológicas
            dentro de un único mapa nacional.
        </p>
    </div>

    <div class="geo-header-actions">
        <a class="btn-secondary" href="/alertas-agricolas">
            <i class="fa-solid fa-triangle-exclamation"></i>
            Centro de alertas
        </a>

        <button class="btn-secondary"
                type="button"
                title="Volver a la vista nacional"
                @onclick="CentrarNicaraguaAsync">
            <i class="fa-solid fa-expand"></i>
            Centrar Nicaragua
        </button>

        <button class="btn-primary"
                type="button"
                @onclick="ActualizarTodoAsync"
                disabled="@(cargando || cargandoClima)">
            <i class="fa-solid fa-rotate @(cargando || cargandoClima ? "fa-spin" : string.Empty)"></i>
            Actualizar
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-error geo-alert">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@error</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorClima))
{
    <div class="alert alert-warning geo-alert">
        <i class="fa-solid fa-cloud-bolt"></i>
        <span>@errorClima</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorSuelo))
{
    <div class="alert alert-warning geo-alert">
        <i class="fa-solid fa-flask-vial"></i>
        <span>@errorSuelo</span>
    </div>
}

<section class="geo-summary-grid">
    <article class="geo-summary-card">
        <span class="geo-summary-icon terrain">
            <i class="fa-solid fa-seedling"></i>
        </span>
        <div>
            <small>Terrenos visibles</small>
            <strong>@respuesta.Resumen.TotalTerrenos</strong>
            <span>@respuesta.Resumen.ExtensionVisibleManzanas.ToString("N2") Mz</span>
        </div>
    </article>

    <article class="geo-summary-card">
        <span class="geo-summary-icon critical">
            <i class="fa-solid fa-circle-exclamation"></i>
        </span>
        <div>
            <small>Estado crítico</small>
            <strong class="critical-text">@respuesta.Resumen.Criticos</strong>
            <span>Atención prioritaria</span>
        </div>
    </article>

    <article class="geo-summary-card">
        <span class="geo-summary-icon attention">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </span>
        <div>
            <small>Requieren atención</small>
            <strong class="attention-text">@respuesta.Resumen.Atencion</strong>
            <span>Seguimiento técnico</span>
        </div>
    </article>

    <article class="geo-summary-card">
        <span class="geo-summary-icon analysis">
            <i class="fa-solid fa-flask"></i>
        </span>
        <div>
            <small>Sin análisis</small>
            <strong>@respuesta.Resumen.SinAnalisis</strong>
            <span>Sin diagnóstico activo</span>
        </div>
    </article>

    <article class="geo-summary-card climate">
        <span class="geo-summary-icon temperature">
            <i class="fa-solid fa-temperature-half"></i>
        </span>
        <div>
            <small>@EtiquetaTemperatura</small>
            <strong>@RangoTemperatura</strong>
            <span>@EstadoActualizacionClima</span>
        </div>
    </article>

    <article class="geo-summary-card climate">
        <span class="geo-summary-icon rain">
            <i class="fa-solid fa-cloud-rain"></i>
        </span>
        <div>
            <small>@EtiquetaPrecipitacion</small>
            <strong>@ValorPrecipitacion</strong>
            <span>Estimación actual</span>
        </div>
    </article>
</section>

<section class="geo-workspace">
    <aside class="geo-control-panel @(panelControlesAbierto ? "open" : string.Empty)">
        <div class="geo-panel-heading">
            <div>
                <span>Panel nacional</span>
                <h2>Capas y filtros</h2>
            </div>

            <button class="geo-icon-button mobile-only"
                    type="button"
                    title="Cerrar panel"
                    @onclick="AlternarPanelControles">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="geo-global-filter-tabs">
            <button class="@ClasePanelFiltro("TERRITORIO")"
                    type="button"
                    @onclick='() => CambiarPanelFiltro("TERRITORIO")'>
                <i class="fa-solid fa-map"></i>
                <span>Territorio</span>
            </button>

            <button class="@ClasePanelFiltro("AGRICOLA")"
                    type="button"
                    @onclick='() => CambiarPanelFiltro("AGRICOLA")'>
                <i class="fa-solid fa-seedling"></i>
                <span>Agrícola</span>
            </button>

            <button class="@ClasePanelFiltro("SUELO")"
                    type="button"
                    @onclick='() => CambiarPanelFiltro("SUELO")'>
                <i class="fa-solid fa-flask-vial"></i>
                <span>Suelo</span>
            </button>

            <button class="@ClasePanelFiltro("CLIMA")"
                    type="button"
                    @onclick='() => CambiarPanelFiltro("CLIMA")'>
                <i class="fa-solid fa-cloud-sun-rain"></i>
                <span>Clima</span>
            </button>
        </div>

        <div class="geo-panel-scroll geo-global-panel-scroll">
            <section class="geo-control-section geo-recommended-section">
                <div class="geo-recommended-action">
                    <div>
                        <strong>@TituloCapasRecomendadas</strong>
                        <small>@DescripcionCapasRecomendadas</small>
                    </div>

                    <button class="btn-secondary"
                            type="button"
                            @onclick="AplicarCapasRecomendadasAsync">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        Aplicar capas
                    </button>
                </div>
            </section>
            @if (panelFiltroActivo == "TERRITORIO")
            {
                <section class="geo-control-section">
                    <div class="geo-section-title">
                        <div>
                            <h3>Mapa base</h3>
                            <p>Cambie el fondo sin perder las capas activas.</p>
                        </div>
                    </div>

                    <select class="form-control geo-base-select"
                            value="@mapaBase"
                            @onchange="CambiarMapaBaseAsync">
                        <option value="calles">Calles y comunidades</option>
                        <option value="satelite">Vista satelital</option>
                    </select>
                </section>
            }

            @foreach (IGrouping<string, MapaCapaDisponible> grupo in CapasDelPanel)
            {
                <section class="geo-control-section">
                    <div class="geo-section-title compact">
                        <div>
                            <h3>@NombreCategoria(grupo.Key)</h3>
                        </div>
                        <span>@grupo.Count(item => item.Disponible) disponibles</span>
                    </div>

                    <div class="geo-layer-list">
                        @foreach (MapaCapaDisponible capa in grupo)
                        {
                            <label class="geo-layer-item @(!capa.Disponible ? "disabled" : string.Empty)"
                                   title="@(capa.Mensaje ?? capa.Descripcion)">
                                <span class="geo-layer-icon @capa.Categoria.ToLowerInvariant()">
                                    <i class="@capa.Icono"></i>
                                </span>

                                <span class="geo-layer-copy">
                                    <strong>@capa.Nombre</strong>
                                    <small>@capa.Descripcion</small>
                                </span>

                                @if (cargandoCapaSuelo == capa.Clave)
                                {
                                    <span class="geo-layer-loading" title="Cargando capa">
                                        <i class="fa-solid fa-spinner fa-spin"></i>
                                    </span>
                                }
                                else if (!capa.Disponible)
                                {
                                    <span class="geo-coming-soon">Próximamente</span>
                                }

                                <input type="checkbox"
                                       checked="@CapaActiva(capa.Clave)"
                                       disabled="@(!capa.Disponible)"
                                       @onchange="args => CambiarCapaAsync(capa.Clave, args)" />
                                <span class="geo-switch" aria-hidden="true"></span>
                            </label>
                        }
                    </div>
                </section>
            }

            @if (panelFiltroActivo == "TERRITORIO")
            {
                <section class="geo-control-section">
                    <div class="geo-section-title">
                        <div>
                            <h3>Navegación territorial</h3>
                            <p>El filtro se aplica a todo el Centro Geoespacial.</p>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Departamento</label>
                        <select class="form-control"
                                value="@filtro.DepartamentoId"
                                @onchange="DepartamentoCambiadoAsync">
                            <option value="">Todos los departamentos</option>
                            @foreach (CatalogoSimple item in departamentos)
                            {
                                <option value="@item.Id">@item.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Municipio</label>
                        <select class="form-control"
                                value="@filtro.MunicipioId"
                                disabled="@(!filtro.DepartamentoId.HasValue)"
                                @onchange="MunicipioCambiadoAsync">
                            <option value="">Todos los municipios</option>
                            @foreach (MunicipioSelectorItem item in MunicipiosDisponibles)
                            {
                                <option value="@item.MunicipioId">@item.NombreMunicipio</option>
                            }
                        </select>
                    </div>

                    <div class="geo-filter-actions">
                        <button class="btn-primary"
                                type="button"
                                @onclick="AplicarFiltrosAsync"
                                disabled="@cargando">
                            <i class="fa-solid fa-magnifying-glass-location"></i>
                            Aplicar territorio
                        </button>

                        <button class="btn-link"
                                type="button"
                                @onclick="LimpiarSeleccionTerritorialAsync">
                            Ver Nicaragua
                        </button>
                    </div>
                </section>
            }
            else if (panelFiltroActivo == "AGRICOLA")
            {
                <section class="geo-control-section">
                    <div class="geo-section-title">
                        <div>
                            <h3>Filtros agrícolas</h3>
                            <p>Busque y reduzca los terrenos visibles.</p>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Buscar terreno</label>
                        <InputText class="form-control"
                                   @bind-Value="filtro.Texto"
                                   placeholder="Código, productor o dirección" />
                    </div>

                    <div class="geo-filter-columns">
                        <div class="form-group">
                            <label>Estado</label>
                            <InputSelect class="form-control"
                                         @bind-Value="filtro.Nivel">
                                <option value="">Todos</option>
                                <option value="CRITICA">Crítico</option>
                                <option value="ATENCION">Atención</option>
                                <option value="NORMAL">Normal</option>
                                <option value="SIN_ANALISIS">Sin análisis</option>
                            </InputSelect>
                        </div>

                        <div class="form-group">
                            <label>Indicador</label>
                            <InputSelect class="form-control"
                                         @bind-Value="filtro.Indicador">
                                <option value="">Todos</option>
                                <option value="ph">pH fuera de rango</option>
                                <option value="materia-organica">Materia orgánica baja</option>
                                <option value="acidez">Acidez alta</option>
                                <option value="sin-analisis">Sin análisis</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="geo-filter-actions">
                        <button class="btn-primary"
                                type="button"
                                @onclick="AplicarFiltrosAsync"
                                disabled="@cargando">
                            <i class="fa-solid fa-filter"></i>
                            Aplicar filtros
                        </button>

                        <button class="btn-link"
                                type="button"
                                @onclick="LimpiarFiltrosAsync">
                            Limpiar todos
                        </button>
                    </div>
                </section>
            }
            else if (panelFiltroActivo == "CLIMA")
            {
                <section class="geo-control-section geo-climate-refresh-box">
                    <div>
                        <i class="fa-solid fa-cloud-arrow-down"></i>
                        <span>
                            El clima se ajusta al departamento o municipio
                            seleccionado y conserva la vista nacional.
                        </span>
                    </div>

                    <button class="btn-secondary"
                            type="button"
                            disabled="@cargandoClima"
                            @onclick="() => CargarClimaAsync(true)">
                        <i class="fa-solid fa-rotate @(cargandoClima ? "fa-spin" : string.Empty)"></i>
                        Actualizar clima
                    </button>
                </section>
            }
        </div>
    </aside>

    <article class="geo-map-stage">
        @if (filtro.DepartamentoId.HasValue || filtro.MunicipioId.HasValue)
        {
            <div class="geo-territorial-breadcrumb">
                <button type="button"
                        title="Volver a la vista nacional"
                        @onclick="LimpiarSeleccionTerritorialAsync">
                    <i class="fa-solid fa-earth-americas"></i>
                    Nicaragua
                </button>
                @if (DepartamentoSeleccionado is not null)
                {
                    <i class="fa-solid fa-chevron-right"></i>
                    <span>@DepartamentoSeleccionado.Nombre</span>
                }
                @if (MunicipioSeleccionado is not null)
                {
                    <i class="fa-solid fa-chevron-right"></i>
                    <strong>@MunicipioSeleccionado.NombreMunicipio</strong>
                }
            </div>
        }

        <div class="geo-floating-toolbar">
            <button class="geo-tool-button mobile-only"
                    type="button"
                    title="Abrir capas y filtros"
                    @onclick="AlternarPanelControles">
                <i class="fa-solid fa-layer-group"></i>
            </button>

            <button class="geo-tool-button"
                    type="button"
                    title="Centrar Nicaragua"
                    @onclick="CentrarNicaraguaAsync">
                <i class="fa-solid fa-crosshairs"></i>
            </button>

            <button class="geo-tool-button"
                    type="button"
                    title="Pantalla completa"
                    @onclick="AlternarPantallaCompletaAsync">
                <i class="fa-solid fa-up-right-and-down-left-from-center"></i>
            </button>

            <button class="geo-tool-button"
                    type="button"
                    title="Actualizar clima"
                    @onclick="() => CargarClimaAsync(true)"
                    disabled="@cargandoClima">
                <i class="fa-solid fa-cloud-arrow-down @(cargandoClima ? "fa-bounce" : string.Empty)"></i>
            </button>
        </div>

        @if (cargando)
        {
            <div class="geo-map-loading">
                <LoadingState Mensaje="Preparando el Centro Geoespacial..." />
            </div>
        }

        <div id="mapaTerrenos"
             class="geo-national-map">
        </div>

        <div class="geo-map-statusbar">
            <span>
                <i class="fa-solid fa-location-crosshairs"></i>
                <b id="mapaCoordenadas">Nicaragua</b>
            </span>
            <span>
                <i class="fa-solid fa-magnifying-glass-plus"></i>
                Zoom <b id="mapaZoom">7</b>
            </span>
            <span class="geo-status-country">
                <i class="fa-solid fa-shield-halved"></i>
                Navegación restringida al territorio nacional
            </span>
            <span>
                <i class="fa-regular fa-clock"></i>
                @UltimaActualizacionTexto
            </span>
            @if (CapaSueloActiva is not null)
            {
                <span title="@CapaSueloActiva.Descripcion">
                    <i class="fa-solid fa-flask-vial"></i>
                    Suelo: <b>@CapaSueloActiva.Nombre</b>
                    (@CapaSueloActiva.TotalRegiones @EtiquetaRegiones(CapaSueloActiva)
                    · @CapaSueloActiva.TotalTerrenosAnalizados terrenos)
                </span>
            }
            @if (climaConsultado &&
                 !string.IsNullOrWhiteSpace(clima.Proveedor))
            {
                <span title="@clima.Licencia">
                    <i class="fa-solid fa-cloud-sun"></i>
                    Clima: <b>@clima.Proveedor</b>
                </span>
            }
        </div>

        @if (detalleTerreno is not null || cargandoDetalle)
        {
            <aside class="geo-detail-panel">
                <div class="geo-detail-heading">
                    <div>
                        <span>Ficha territorial</span>
                        <h2>@(detalleTerreno?.Codigo ?? "Cargando terreno...")</h2>
                    </div>
                    <button class="geo-icon-button"
                            type="button"
                            title="Cerrar detalle"
                            @onclick="CerrarDetalle">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                @if (cargandoDetalle)
                {
                    <LoadingState Mensaje="Cargando historial del terreno..." />
                }
                else if (!string.IsNullOrWhiteSpace(errorDetalle))
                {
                    <div class="geo-detail-error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        @errorDetalle
                    </div>
                }
                else if (detalleTerreno is not null)
                {
                    <div class="geo-detail-scroll">
                        <section class="geo-terrain-profile">
                            <h3>@detalleTerreno.Nombre</h3>
                            <p>
                                <i class="fa-solid fa-user"></i>
                                @detalleTerreno.Productor
                            </p>
                            <p>
                                <i class="fa-solid fa-map-pin"></i>
                                @detalleTerreno.Municipio, @detalleTerreno.Departamento
                            </p>

                            <div class="geo-profile-stats">
                                <span>
                                    <small>Extensión</small>
                                    <strong>@detalleTerreno.ExtensionManzanas.ToString("N2") Mz</strong>
                                </span>
                                <span>
                                    <small>Producción</small>
                                    <strong>@detalleTerreno.ProduccionQuintalesOro.ToString("N2") QQ</strong>
                                </span>
                                <span>
                                    <small>Análisis</small>
                                    <strong>@detalleTerreno.Analisis.Count</strong>
                                </span>
                            </div>
                        </section>

                        <PronosticoTerrenoPanel
                            TerrenoId="@detalleTerreno.TerrenoId" />

                        <section class="geo-timeline-section">
                            <div class="geo-section-title compact">
                                <div>
                                    <h3>Línea de tiempo del suelo</h3>
                                    <p>Selecciona un análisis para revisar su estado.</p>
                                </div>
                            </div>

                            @if (detalleTerreno.Analisis.Count == 0)
                            {
                                <div class="geo-empty-timeline">
                                    <i class="fa-solid fa-flask-vial"></i>
                                    <strong>Sin análisis de suelo</strong>
                                    <span>Este terreno todavía no posee historial disponible.</span>
                                </div>
                            }
                            else
                            {
                                <div class="geo-timeline">
                                    @foreach (AnalisisTerrenoMapa analisis in detalleTerreno.Analisis)
                                    {
                                        <button class="geo-timeline-item @ClaseAnalisis(analisis)"
                                                type="button"
                                                @onclick="() => SeleccionarAnalisis(analisis)">
                                            <span class="geo-timeline-dot @analisis.Nivel.ToLowerInvariant()"></span>
                                            <span>
                                                <strong>@analisis.FechaLaboratorio.ToString("dd/MM/yyyy")</strong>
                                                <small>@analisis.Identificador</small>
                                            </span>
                                            <span class="geo-level-badge @analisis.Nivel.ToLowerInvariant()">
                                                @analisis.Estado
                                            </span>
                                        </button>
                                    }
                                </div>
                            }
                        </section>

                        @if (analisisSeleccionado is not null)
                        {
                            <section class="geo-analysis-detail">
                                <div class="geo-analysis-title">
                                    <div>
                                        <small>Análisis seleccionado</small>
                                        <h3>@analisisSeleccionado.FechaLaboratorio.ToString("dd MMMM yyyy")</h3>
                                    </div>
                                    <span class="geo-level-badge @analisisSeleccionado.Nivel.ToLowerInvariant()">
                                        @analisisSeleccionado.Estado
                                    </span>
                                </div>

                                <div class="geo-analysis-values">
                                    <span>
                                        <small>pH</small>
                                        <strong>@analisisSeleccionado.Ph.ToString("N2")</strong>
                                    </span>
                                    <span>
                                        <small>Materia orgánica</small>
                                        <strong>@ValorNullable(analisisSeleccionado.MateriaOrganica, "%")</strong>
                                    </span>
                                    <span>
                                        <small>Acidez total</small>
                                        <strong>@ValorNullable(analisisSeleccionado.AcidezTotal)</strong>
                                    </span>
                                    <span>
                                        <small>CICE</small>
                                        <strong>@ValorNullable(analisisSeleccionado.Cice)</strong>
                                    </span>
                                    <span>
                                        <small>Saturación de bases</small>
                                        <strong>@ValorNullable(analisisSeleccionado.SaturacionBases, "%")</strong>
                                    </span>
                                </div>

                                @if (analisisSeleccionado.Elementos.Count > 0)
                                {
                                    <div class="geo-nutrient-section">
                                        <div class="geo-nutrient-heading">
                                            <strong>
                                                <i class="fa-solid fa-atom"></i>
                                                Elementos químicos
                                            </strong>
                                            <small>@analisisSeleccionado.Elementos.Count elementos</small>
                                        </div>
                                        <div class="geo-nutrient-grid">
                                            @foreach (ElementoAnalisisTerrenoMapa elemento in analisisSeleccionado.Elementos)
                                            {
                                                <article class="geo-nutrient-card">
                                                    <span>@elemento.Simbolo</span>
                                                    <div>
                                                        <strong>@elemento.Valor.ToString("N2") @elemento.Unidad</strong>
                                                        <small>@elemento.Nombre</small>
                                                        @if (!string.IsNullOrWhiteSpace(elemento.Clasificacion))
                                                        {
                                                            <em>@elemento.Clasificacion</em>
                                                        }
                                                    </div>
                                                </article>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(analisisSeleccionado.RecomendacionGeneral))
                                {
                                    <div class="geo-recommendation">
                                        <strong>
                                            <i class="fa-solid fa-lightbulb"></i>
                                            Recomendación
                                        </strong>
                                        <p>@analisisSeleccionado.RecomendacionGeneral</p>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(analisisSeleccionado.Observacion))
                                {
                                    <div class="geo-observation">
                                        <strong>Observación</strong>
                                        <p>@analisisSeleccionado.Observacion</p>
                                    </div>
                                }
                            </section>
                        }
                    </div>
                }
            </aside>
        }
    </article>
</section>

@code {
    private static readonly HashSet<string> ClavesClima =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "temperatura",
            "humedad",
            "lluvia",
            "viento"
        };

    private readonly MapaFiltro filtro = new();
    private readonly Dictionary<string, bool> capasActivas =
        new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, CapaSueloMapaRespuesta> capasSueloCache =
        new(StringComparer.OrdinalIgnoreCase);

    private MapaInteligenteRespuesta respuesta = new();
    private CentroGeoespacialCapasRespuesta catalogoCapas = new();
    private ClimaMapaRespuesta clima = new();
    private ClimaMapaRespuesta climaNacional = new();
    private CapaSueloMapaRespuesta? capaSueloActiva;
