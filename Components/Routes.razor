@using CONATRADEC.AdminWeb.Components.Layout
@using CONATRADEC.AdminWeb.Components.Shared

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @if (EsPaginaLogin(routeData.PageType))
        {
            <RouteView RouteData="@routeData"
                       DefaultLayout="typeof(MainLayout)" />
        }
        else
        {
            <ProtectedRouteView RouteData="@routeData"
                                DefaultLayout="typeof(MainLayout)" />
        }

        <FocusOnNavigate RouteData="@routeData"
                         Selector="h1" />
    </Found>

    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <div class="empty-state">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <h1>Página no encontrada</h1>
                <p>La dirección solicitada no existe.</p>

                <a class="btn-primary"
                   href="/">
                    Volver al inicio
                </a>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static bool EsPaginaLogin(Type pageType) =>
        string.Equals(
            pageType.Name,
            "Login",
            StringComparison.OrdinalIgnoreCase);
}
