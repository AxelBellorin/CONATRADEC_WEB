@page "/seguimiento-alertas"
@inject AuthStateService AuthState
@inject SeguimientoAlertasService Service
@inject NavigationManager Navigation

<PageTitle>Seguimiento de alertas | CONATRADEC</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Gestión técnica</p>
        <h1>Seguimiento de alertas</h1>
        <p>Asigna responsables, documenta acciones y cierra alertas atendidas.</p>
    </div>

    <div class="page-header-actions">
        <a class="btn-secondary" href="/alertas-agricolas">
            <i class="fa-solid fa-triangle-exclamation"></i>
            Alertas detectadas
        </a>

        <button class="btn-primary" @onclick="Cargar" disabled="@cargando">
            <i class="fa-solid fa-rotate"></i>
            Actualizar
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError ? "alert-error" : "alert-success")">
        <i class="fa-solid @(esError ? "fa-circle-exclamation" : "fa-circle-check")"></i>
        <span>@mensaje</span>
    </div>
}

<section class="followup-summary">
    <article><span>Pendientes</span><strong>@seguimientos.Count(x => x.Estado == "PENDIENTE")</strong></article>
    <article><span>En proceso</span><strong>@seguimientos.Count(x => x.Estado == "EN_PROCESO")</strong></article>
    <article><span>Atendidas</span><strong>@seguimientos.Count(x => x.Estado == "ATENDIDA")</strong></article>
    <article><span>Descartadas</span><strong>@seguimientos.Count(x => x.Estado == "DESCARTADA")</strong></article>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <h2>Casos registrados</h2>
            <p>Seguimientos creados desde las alertas agrícolas</p>
        </div>
    </div>

    @if (cargando)
    {
        <LoadingState Mensaje="Cargando seguimientos..." />
    }
    else
    {
        <div class="followup-grid">
            @foreach (SeguimientoAlertaItem item in seguimientos)
            {
                <article class="followup-card">
                    <div class="followup-card-header">
                        <div>
                            <span class="executive-alert-badge @ClaseNivel(item.Nivel)">
                                @item.Nivel
                            </span>
                            <h3>@item.TipoAlerta</h3>
                        </div>

                        <span class="followup-status @item.Estado.ToLowerInvariant()">
                            @EstadoTexto(item.Estado)
                        </span>
                    </div>

                    <dl>
                        <div><dt>Terreno</dt><dd>#@item.TerrenoId</dd></div>
                        <div><dt>Responsable</dt><dd>@(item.UsuarioAsignado ?? "Sin asignar")</dd></div>
                        <div><dt>Último cambio</dt><dd>@item.FechaUltimaModificacionUtc.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</dd></div>
                    </dl>

                    <p>@(string.IsNullOrWhiteSpace(item.Observacion) ? "Sin observaciones." : item.Observacion)</p>

                    <button class="btn-secondary" @onclick="() => Editar(item)">
                        <i class="fa-solid fa-pen"></i>
                        Actualizar seguimiento
                    </button>
                </article>
            }
        </div>
    }
</section>

@if (editando is not null)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <div>
                    <h2>Actualizar seguimiento</h2>
                    <p>@editando.TipoAlerta · Terreno #@editando.TerrenoId</p>
                </div>
                <button class="modal-close" @onclick="CerrarModal">×</button>
            </div>

            <div class="form-group">
                <label>Estado</label>
                <InputSelect class="form-control" @bind-Value="formulario.Estado">
                    <option value="PENDIENTE">Pendiente</option>
                    <option value="EN_PROCESO">En proceso</option>
                    <option value="ATENDIDA">Atendida</option>
                    <option value="DESCARTADA">Descartada</option>
                </InputSelect>
            </div>

            <div class="form-group">
                <label>ID del usuario responsable</label>
                <InputNumber class="form-control" @bind-Value="formulario.UsuarioAsignadoId" />
                <small>Déjalo vacío para mantener el caso sin asignar.</small>
            </div>

            <div class="form-group">
                <label>Observación técnica</label>
                <InputTextArea class="form-control followup-observation"
                               @bind-Value="formulario.Observacion" />
            </div>

            <div class="modal-actions">
                <button class="btn-link" @onclick="CerrarModal">Cancelar</button>
                <button class="btn-primary" @onclick="Guardar" disabled="@guardando">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Guardar cambios
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<SeguimientoAlertaItem> seguimientos = [];
    private SeguimientoAlertaItem? editando;
    private ActualizarSeguimientoAlerta formulario = new();
    private bool cargando = true;
    private bool guardando;
    private string? mensaje;
    private bool esError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await Cargar();
        StateHasChanged();
    }

    private async Task Cargar()
    {
        cargando = true;
        mensaje = null;

        try
        {
            seguimientos = await Service.ListarAsync();
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private void Editar(SeguimientoAlertaItem item)
    {
        editando = item;
        formulario = new ActualizarSeguimientoAlerta
        {
            Estado = item.Estado,
            UsuarioAsignadoId = item.UsuarioAsignadoId,
            Observacion = item.Observacion,
            UsuarioAccionId = AuthState.Usuario?.UsuarioId ?? 0
        };
    }

    private void CerrarModal() => editando = null;

    private async Task Guardar()
    {
        if (editando is null) return;

        guardando = true;
        mensaje = null;

        try
        {
            await Service.ActualizarAsync(
                editando.SeguimientoAlertaAgricolaId,
                formulario);

            mensaje = "Seguimiento actualizado correctamente.";
            esError = false;
            editando = null;
            await Cargar();
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
        finally
        {
            guardando = false;
        }
    }

    private static string ClaseNivel(string nivel) =>
        nivel == "CRITICA" ? "critical" : "attention";

    private static string EstadoTexto(string estado) =>
        estado switch
        {
            "EN_PROCESO" => "En proceso",
            "ATENDIDA" => "Atendida",
            "DESCARTADA" => "Descartada",
            _ => "Pendiente"
        };
}
