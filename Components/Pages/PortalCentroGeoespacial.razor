@page "/mi-portal/centro-geoespacial"
@implements IAsyncDisposable
@using System.Globalization
@using CONATRADEC.AdminWeb.Models
@using CONATRADEC.AdminWeb.Services
@using Microsoft.JSInterop
@inject AuthStateService AuthState
@inject PortalPropietarioService Servicio
@inject MapaService MapaService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Mi Centro Geoespacial | CONATRADEC</PageTitle>

<div class="owner-geo-compact">
    <div class="geo-page-header">
        <div class="geo-title-block">
            <span class="geo-country-badge">
                <i class="fa-solid fa-location-dot"></i>
                República de Nicaragua
            </span>

            <p class="eyebrow">Información territorial privada</p>
            <h1>Mi Centro Geoespacial</h1>
            <p>
                Consulte sus terrenos, alertas, análisis de suelo y
                condiciones meteorológicas dentro del mapa nacional.
            </p>
        </div>

        <div class="geo-header-actions">
            <button class="btn-secondary"
                    type="button"
                    @onclick="VolverAlPortal">
                <i class="fa-solid fa-arrow-left"></i>
                Mi portal
            </button>

            <button class="btn-secondary"
                    type="button"
                    disabled="@(datos is null || cargando)"
                    @onclick="CentrarMisTerrenosAsync">
                <i class="fa-solid fa-location-crosshairs"></i>
                Mis terrenos
            </button>

            <button class="btn-secondary"
                    type="button"
                    disabled="@(!mapaInicializado)"
                    @onclick="CentrarNicaraguaAsync">
                <i class="fa-solid fa-expand"></i>
                Nicaragua
            </button>

            <button class="btn-primary"
                    type="button"
                    disabled="@cargando"
                    @onclick="ActualizarTodoAsync">
                <i class="fa-solid fa-rotate @(cargando ? "fa-spin" : string.Empty)"></i>
                Actualizar
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-error geo-alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@error</span>
        </div>
    }

    @if (cargando && datos is null)
    {
        <div class="owner-geo-loading">
            <i class="fa-solid fa-map-location-dot fa-beat-fade"></i>
            <strong>Preparando su Centro Geoespacial</strong>
            <span>Estamos cargando únicamente sus terrenos.</span>
        </div>
    }
    else if (datos is not null && !datos.Vinculado)
    {
        <div class="owner-geo-loading warning">
            <i class="fa-solid fa-link-slash"></i>
            <strong>Cuenta sin propietario vinculado</strong>
            <span>@datos.Mensaje</span>
        </div>
    }
    else if (datos is not null)
    {
        <section class="geo-summary-grid owner-summary-grid">
            <article class="geo-summary-card">
                <span class="geo-summary-icon terrain">
                    <i class="fa-solid fa-seedling"></i>
                </span>
                <div>
                    <small>Terrenos visibles</small>
                    <strong>@TerrenosFiltrados.Count</strong>
                    <span>@ExtensionVisible.ToString("N2") Mz</span>
                </div>
            </article>

            <article class="geo-summary-card">
                <span class="geo-summary-icon critical">
                    <i class="fa-solid fa-circle-exclamation"></i>
                </span>
                <div>
                    <small>Estado crítico</small>
                    <strong class="critical-text">@ContarNivel("CRITICO")</strong>
                    <span>Atención prioritaria</span>
                </div>
            </article>

            <article class="geo-summary-card">
                <span class="geo-summary-icon attention">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </span>
                <div>
                    <small>Requieren atención</small>
                    <strong class="attention-text">@ContarNivel("ATENCION")</strong>
                    <span>Seguimiento técnico</span>
                </div>
            </article>

            <article class="geo-summary-card">
                <span class="geo-summary-icon analysis">
                    <i class="fa-solid fa-flask"></i>
                </span>
                <div>
                    <small>Sin análisis</small>
                    <strong>@ContarNivel("SIN_ANALISIS")</strong>
                    <span>Sin diagnóstico activo</span>
                </div>
            </article>

            <article class="geo-summary-card climate">
                <span class="geo-summary-icon temperature">
                    <i class="fa-solid fa-temperature-half"></i>
                </span>
                <div>
                    <small>@EtiquetaTemperatura</small>
                    <strong>@RangoTemperatura</strong>
                    <span>@EstadoClima</span>
                </div>
            </article>

            <article class="geo-summary-card climate">
                <span class="geo-summary-icon rain">
                    <i class="fa-solid fa-cloud-rain"></i>
                </span>
                <div>
                    <small>@EtiquetaPrecipitacion</small>
                    <strong>@ValorPrecipitacion</strong>
                    <span>Estimación actual</span>
                </div>
            </article>
        </section>

        <section class="geo-workspace owner-workspace">
            <aside class="geo-control-panel owner-control-panel">
                <div class="geo-panel-heading owner-panel-heading">
                    <div>
                        <span>Panel privado</span>
                        <h2>Capas y filtros</h2>
                    </div>

                    <span class="owner-filter-count"
                          title="Filtros activos">
                        @CantidadFiltrosActivos
                    </span>
                </div>

                <div class="owner-filter-tabs">
                    <button class="@ClasePanel("TERRITORIO")"
                            type="button"
                            @onclick='() => CambiarPanel("TERRITORIO")'>
                        <i class="fa-solid fa-map"></i>
                        <span>Territorio</span>
                    </button>

                    <button class="@ClasePanel("AGRICOLA")"
                            type="button"
                            @onclick='() => CambiarPanel("AGRICOLA")'>
                        <i class="fa-solid fa-seedling"></i>
                        <span>Agrícola</span>
                    </button>

                    <button class="@ClasePanel("SUELO")"
                            type="button"
                            @onclick='() => CambiarPanel("SUELO")'>
                        <i class="fa-solid fa-flask-vial"></i>
                        <span>Suelo</span>
                    </button>

                    <button class="@ClasePanel("CLIMA")"
                            type="button"
                            @onclick='() => CambiarPanel("CLIMA")'>
                        <i class="fa-solid fa-cloud-sun-rain"></i>
                        <span>Clima</span>
                    </button>
                </div>

                <div class="geo-panel-scroll owner-panel-scroll">
                    <section class="geo-control-section geo-recommended-section">
                        <div class="geo-recommended-action">
                            <div>
                                <strong>@TituloCapasRecomendadas</strong>
                                <small>@DescripcionCapasRecomendadas</small>
                            </div>

                            <button class="btn-secondary"
                                    type="button"
                                    @onclick="AplicarCapasRecomendadasAsync">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                                Aplicar capas
                            </button>
                        </div>
                    </section>
                    @if (panelActivo == "TERRITORIO")
                    {
                        <section class="geo-control-section">
                            <div class="geo-section-title">
                                <div>
                                    <h3>Mapa base</h3>
                                    <p>Cambie el fondo sin perder las capas.</p>
                                </div>
                            </div>

                            <select class="form-control"
                                    value="@mapaBase"
                                    @onchange="CambiarMapaBaseAsync">
                                <option value="calles">Calles y comunidades</option>
                                <option value="satelite">Vista satelital</option>
                            </select>
                        </section>

                        <section class="geo-control-section">
                            <div class="geo-section-title compact">
                                <div>
                                    <h3>Navegación territorial</h3>
                                    <p>Seleccione departamento y municipio.</p>
                                </div>
                            </div>

                            <div class="owner-territory-selects">
                                <select class="form-control"
                                        value="@DepartamentoValor"
                                        @onchange="DepartamentoCambiadoAsync">
                                    <option value="">Todos los departamentos</option>
                                    @foreach (CatalogoSimple departamento in departamentos)
                                    {
                                        <option value="@departamento.Id">
                                            @departamento.Nombre
                                        </option>
                                    }
                                </select>

                                <select class="form-control"
                                        value="@MunicipioValor"
                                        disabled="@(!departamentoId.HasValue)"
                                        @onchange="MunicipioCambiadoAsync">
                                    <option value="">Todos los municipios</option>
                                    @foreach (MunicipioSelectorItem municipio in MunicipiosDisponibles)
                                    {
                                        <option value="@municipio.MunicipioId">
                                            @municipio.NombreMunicipio
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="owner-territory-actions">
                                <button class="btn-secondary"
                                        type="button"
                                        @onclick="LimpiarTerritorioAsync">
                                    <i class="fa-solid fa-earth-americas"></i>
                                    Ver Nicaragua
                                </button>
                            </div>
                        </section>

                        <section class="geo-control-section">
                            <div class="geo-section-title compact">
                                <div>
                                    <h3>División territorial</h3>
                                </div>
                                <span>2 capas</span>
                            </div>

                            <div class="geo-layer-list">
                                @CapaCheckbox(
                                    "departamentos",
                                    "Límites departamentales",
                                    "División política de Nicaragua.",
                                    "fa-solid fa-border-all")

                                @CapaCheckbox(
                                    "municipios",
                                    "Límites municipales",
                                    "Navegación detallada por municipio.",
                                    "fa-solid fa-draw-polygon")
                            </div>
                        </section>
                    }
                    else if (panelActivo == "AGRICOLA")
                    {
                        <section class="geo-control-section">
                            <div class="geo-section-title compact">
                                <div>
                                    <h3>Información agrícola</h3>
                                    <p>Datos exclusivos de sus fincas.</p>
                                </div>
                                <span>2 capas</span>
                            </div>

                            <div class="geo-layer-list">
                                @CapaCheckbox(
                                    "terrenos",
                                    "Mis terrenos",
                                    "Estado del último análisis.",
                                    "fa-solid fa-seedling")

                                @CapaCheckbox(
                                    "alertas",
                                    "Mis alertas",
                                    $"{TotalAlertasVisibles} alertas activas.",
                                    "fa-solid fa-triangle-exclamation")
                            </div>
                        </section>

                        <section class="geo-control-section">
                            <div class="geo-section-title">
                                <div>
                                    <h3>Estado del terreno</h3>
                                    <p>Reduzca los marcadores visibles.</p>
                                </div>
                            </div>

                            <select class="form-control"
                                    value="@filtroNivel"
                                    @onchange="NivelCambiadoAsync">
                                <option value="">Todos los estados</option>
                                <option value="CRITICO">Crítico</option>
                                <option value="ATENCION">Atención</option>
                                <option value="ESTABLE">Estable</option>
                                <option value="SIN_ANALISIS">Sin análisis</option>
                            </select>

                            <label class="owner-inline-switch">
                                <span>
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                    Solo con alertas
                                </span>
                                <input type="checkbox"
                                       checked="@soloConAlertas"
                                       @onchange="SoloAlertasCambiadoAsync" />
                                <span class="geo-switch"></span>
                            </label>
                        </section>

                        <section class="geo-control-section">
                            <div class="geo-section-title">
                                <div>
                                    <h3>Terreno específico</h3>
                                </div>
                            </div>

                            <select class="form-control"
                                    value="@terrenoIdSeleccionado"
                                    @onchange="TerrenoFiltroCambiadoAsync">
                                <option value="0">Todos mis terrenos</option>
                                @foreach (PortalCentroTerreno terreno in TerrenosDelTerritorio)
                                {
                                    <option value="@terreno.TerrenoId">
                                        @terreno.CodigoTerreno
                                    </option>
                                }
                            </select>
                        </section>
                    }
                    else if (panelActivo == "SUELO")
                    {
                        <section class="geo-control-section">
                            <div class="geo-section-title">
                                <div>
                                    <h3>Último análisis de suelo</h3>
                                    <p>Promedio territorial de sus terrenos.</p>
                                </div>
                            </div>

                            <div class="owner-soil-grid">
                                @BotonSuelo("ph", "pH", "fa-solid fa-flask")
                                @BotonSuelo("materia-organica", "Materia orgánica", "fa-solid fa-leaf")
                                @BotonSuelo("acidez-total", "Acidez total", "fa-solid fa-vial")
                                @BotonSuelo("cice", "CICE", "fa-solid fa-atom")
                                @BotonSuelo("saturacion-bases", "Saturación", "fa-solid fa-percent")
                            </div>
                        </section>

                        @if (datos.NutrientesDisponibles.Count > 0)
                        {
                            <section class="geo-control-section">
                                <div class="geo-section-title">
                                    <div>
                                        <h3>Nutrientes</h3>
                                        <p>Disponibles en sus análisis.</p>
                                    </div>
                                </div>

                                <select class="form-control"
                                        value="@capaSueloActiva"
                                        @onchange="NutrienteCambiadoAsync">
                                    <option value="">Seleccione un nutriente</option>
                                    @foreach (PortalCentroNutriente nutriente in datos.NutrientesDisponibles)
                                    {
                                        <option value="@nutriente.Clave">
                                            @nutriente.Nombre (@nutriente.Simbolo)
                                        </option>
                                    }
                                </select>
                            </section>
                        }

                        <button class="owner-clear-layer"
                                type="button"
                                disabled="@string.IsNullOrWhiteSpace(capaSueloActiva)"
                                @onclick="() => LimpiarCapaSueloAsync()">
                            <i class="fa-solid fa-eraser"></i>
                            Quitar capa de suelo
                        </button>
                    }
                    else
                    {
                        <section class="geo-control-section">
                            <div class="geo-section-title compact">
                                <div>
                                    <h3>Condición meteorológica</h3>
                                    <p>El mismo mapa de calor del portal administrativo.</p>
                                </div>
                                <button class="geo-icon-button"
                                        type="button"
                                        disabled="@cargando"
                                        title="Actualizar clima"
                                        @onclick="ActualizarClimaAsync">
                                    <i class="fa-solid fa-rotate"></i>
                                </button>
                            </div>

                            <div class="owner-weather-grid">
                                @BotonClima("temperatura", "Temperatura", "fa-solid fa-temperature-half")
                                @BotonClima("humedad", "Humedad", "fa-solid fa-droplet")
                                @BotonClima("lluvia", "Precipitación", "fa-solid fa-cloud-rain")
                                @BotonClima("viento", "Viento", "fa-solid fa-wind")
                            </div>

                            @if (!climaNacional.Disponible)
                            {
                                <div class="alert alert-warning owner-weather-alert">
                                    <i class="fa-solid fa-cloud-bolt"></i>
                                    <span>@climaNacional.Mensaje</span>
                                </div>
                            }
                        </section>

                        <section class="owner-weather-summary">
                            <article>
                                <i class="fa-solid fa-temperature-half"></i>
                                <div>
                                    <span>Temperatura</span>
                                    <strong>@RangoTemperatura</strong>
                                </div>
                            </article>
                            <article>
                                <i class="fa-solid fa-droplet"></i>
                                <div>
                                    <span>Humedad</span>
                                    <strong>@RangoHumedad</strong>
                                </div>
                            </article>
                            <article>
                                <i class="fa-solid fa-cloud-rain"></i>
                                <div>
                                    <span>Precipitación</span>
                                    <strong>@ValorPrecipitacion</strong>
                                </div>
                            </article>
                            <article>
                                <i class="fa-solid fa-wind"></i>
                                <div>
                                    <span>Viento</span>
                                    <strong>@ValorViento</strong>
                                </div>
                            </article>
                        </section>

                        <button class="owner-clear-layer"
                                type="button"
                                disabled="@string.IsNullOrWhiteSpace(capaClimaActiva)"
                                @onclick="() => LimpiarCapaClimaAsync()">
                            <i class="fa-solid fa-eraser"></i>
                            Quitar capa meteorológica
                        </button>
                    }
                </div>
            </aside>

            <article class="geo-map-stage owner-map-stage">
                @if (departamentoId.HasValue || municipioId.HasValue)
                {
                    <div class="geo-territorial-breadcrumb">
                        <button type="button"
                                @onclick="LimpiarTerritorioAsync">
                            <i class="fa-solid fa-earth-americas"></i>
                            Nicaragua
                        </button>

                        @if (DepartamentoSeleccionado is not null)
                        {
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>@DepartamentoSeleccionado.Nombre</span>
                        }

                        @if (MunicipioSeleccionado is not null)
                        {
                            <i class="fa-solid fa-chevron-right"></i>
                            <strong>@MunicipioSeleccionado.NombreMunicipio</strong>
                        }
                    </div>
                }

                <div class="geo-floating-toolbar">
                    <button class="geo-tool-button"
                            type="button"
                            title="Centrar Nicaragua"
                            @onclick="CentrarNicaraguaAsync">
                        <i class="fa-solid fa-earth-americas"></i>
                    </button>

                    <button class="geo-tool-button"
                            type="button"
                            title="Centrar mis terrenos"
                            @onclick="CentrarMisTerrenosAsync">
                        <i class="fa-solid fa-crosshairs"></i>
                    </button>

                    <button class="geo-tool-button"
                            type="button"
                            title="Pantalla completa"
                            @onclick="AlternarPantallaCompletaAsync">
                        <i class="fa-solid fa-up-right-and-down-left-from-center"></i>
                    </button>
                </div>

                <div id="mapaTerrenosPropietario"
                     class="geo-national-map owner-national-map">
                </div>

                <div class="geo-map-statusbar">
                    <span>
                        <i class="fa-solid fa-location-crosshairs"></i>
                        <b id="mapaCoordenadas">Nicaragua</b>
                    </span>
                    <span>
                        <i class="fa-solid fa-magnifying-glass-plus"></i>
                        Zoom <b id="mapaZoom">7</b>
                    </span>
                    <span class="geo-status-country">
                        <i class="fa-solid fa-shield-halved"></i>
                        Solo Nicaragua y datos propios
                    </span>
                    <span>
                        <i class="fa-regular fa-clock"></i>
                        @datos.ActualizadoUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>

                @if (detalleTerreno is not null || cargandoHistorial)
                {
                    <aside class="geo-detail-panel">
                        <div class="geo-detail-heading">
                            <div>
                                <span>Ficha territorial privada</span>
                                <h2>@(detalleTerreno?.CodigoTerreno ?? "Cargando...")</h2>
                            </div>
                            <button class="geo-icon-button"
                                    type="button"
                                    @onclick="CerrarDetalle">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        @if (cargandoHistorial)
                        {
                            <div class="owner-detail-loading">
                                <i class="fa-solid fa-spinner fa-spin"></i>
                                Cargando historial...
                            </div>
                        }
                        else if (detalleTerreno is not null)
                        {
                            <div class="geo-detail-scroll">
                                <section class="geo-terrain-profile">
                                    <h3>@detalleTerreno.CodigoTerreno</h3>
                                    <p>
                                        <i class="fa-solid fa-map-pin"></i>
                                        @detalleTerreno.Municipio,
                                        @detalleTerreno.Departamento
                                    </p>

                                    <div class="geo-profile-stats">
                                        <span>
                                            <small>Extensión</small>
                                            <strong>@detalleTerreno.ExtensionManzanas.ToString("N2") Mz</strong>
                                        </span>
                                        <span>
                                            <small>Producción</small>
                                            <strong>@detalleTerreno.ProduccionQuintalesOro.ToString("N2") QQ</strong>
                                        </span>
                                        <span>
                                            <small>Análisis</small>
                                            <strong>@detalleTerreno.Analisis.Count</strong>
                                        </span>
                                    </div>
                                </section>

                                <PronosticoTerrenoPanel
                                    TerrenoId="@detalleTerreno.TerrenoId"
                                    VistaPropietario="true" />

                                <section class="geo-timeline-section">
                                    <div class="geo-section-title compact">
                                        <div>
                                            <h3>Línea de tiempo del suelo</h3>
                                        </div>
                                    </div>

                                    @if (detalleTerreno.Analisis.Count == 0)
                                    {
                                        <div class="geo-empty-timeline">
                                            <i class="fa-solid fa-flask-vial"></i>
                                            <strong>Sin análisis de suelo</strong>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="geo-timeline">
                                            @foreach (PortalHistorialAnalisis analisis in detalleTerreno.Analisis)
                                            {
                                                <button class="geo-timeline-item"
                                                        type="button"
                                                        @onclick='() => SeleccionarAnalisis(analisis)'>
                                                    <span class="geo-timeline-dot @ClaseNivel(analisis.Nivel)"></span>
                                                    <span>
                                                        <strong>@analisis.FechaLaboratorio.ToString("dd/MM/yyyy")</strong>
                                                        <small>@analisis.Identificador</small>
                                                    </span>
                                                    <span class="geo-level-badge @ClaseNivel(analisis.Nivel)">
                                                        @analisis.Estado
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </section>

                                @if (analisisSeleccionado is not null)
                                {
                                    <section class="geo-analysis-detail">
                                        <div class="geo-analysis-title">
                                            <div>
                                                <small>Análisis seleccionado</small>
                                                <h3>@analisisSeleccionado.FechaLaboratorio.ToString("dd/MM/yyyy")</h3>
                                            </div>
                                            <span class="geo-level-badge @ClaseNivel(analisisSeleccionado.Nivel)">
                                                @analisisSeleccionado.Estado
                                            </span>
                                        </div>

                                        <div class="geo-analysis-values">
                                            <span><small>pH</small><strong>@analisisSeleccionado.Ph.ToString("N2")</strong></span>
                                            <span><small>Materia orgánica</small><strong>@ValorNullable(analisisSeleccionado.MateriaOrganica, "%")</strong></span>
                                            <span><small>Acidez total</small><strong>@ValorNullable(analisisSeleccionado.AcidezTotal)</strong></span>
                                            <span><small>CICE</small><strong>@ValorNullable(analisisSeleccionado.Cice)</strong></span>
                                            <span><small>Saturación</small><strong>@ValorNullable(analisisSeleccionado.SaturacionBases, "%")</strong></span>
                                        </div>
                                    </section>
                                }
                            </div>
                        }
                    </aside>
                }
            </article>
        </section>
    }
</div>

@code {
    private static readonly string[] ClavesClima =
    [
        "temperatura",
        "humedad",
        "lluvia",
        "viento"
    ];

    private static readonly string[] ClavesSueloBase =
    [
        "ph",
        "materia-organica",
        "acidez-total",
        "cice",
        "saturacion-bases"
    ];

    private readonly Dictionary<string, bool> capasActivas =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ["departamentos"] = true,
            ["municipios"] = false,
            ["terrenos"] = true,
            ["alertas"] = true,
            ["ph"] = false,
            ["temperatura"] = false,
            ["humedad"] = false,
            ["lluvia"] = false,
