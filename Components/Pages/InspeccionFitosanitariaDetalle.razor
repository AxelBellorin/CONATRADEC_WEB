    public async ValueTask DisposeAsync()
    {
        try
        {
            bloqueoCts?.Cancel();
            if (tareaRenovacion is not null) { try { await tareaRenovacion; } catch { } }
            if (bloqueo is not null && !string.IsNullOrWhiteSpace(bloqueo.Token))
            {
                string modo = (bloqueo.Modo ?? string.Empty)
                    .Trim()
                    .ToLowerInvariant();

                if (modo is "analizador" or "aprobador")
                {
                    try
                    {
                        await Servicio.LiberarBloqueoAsync(
                            InspeccionId,
                            modo,
                            bloqueo.Token);
                    }
                    catch
                    {
                        // El bloqueo puede haber vencido o haber sido liberado.
                    }
                }
            }
        }
        finally { bloqueoCts?.Dispose(); bloqueoCts = null; }
    }
