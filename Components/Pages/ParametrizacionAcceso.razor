    private Task LimpiarUsuarioAsignacionAsync()
    {
        usuarioAsignacionSeleccionadoId = 0;
        buscarUsuarioAsignacion = string.Empty;
        buscarTerrenoAsignacion = string.Empty;
        asignaciones = [];
        terrenosAsignacionPropietario = [];
        nuevaAsignacion = new();
        LimpiarMensaje();
        return Task.CompletedTask;
    }

    private async Task CargarAsignacionesUsuarioAsync()
    {
        if (usuarioAsignacionSeleccionadoId <= 0)
        {
            asignaciones = [];
            terrenosAsignacionPropietario = [];
            return;
        }

        cargandoAsignacionesUsuario = true;

        try
        {
            Task<List<AsignacionTerrenoItem>?> asignacionesTask =
                Servicio.ListarAsignacionesAsync(usuarioAsignacionSeleccionadoId);
            Task<List<TerrenoAccesoCatalogo>?> terrenosPropietarioTask =
                Servicio.ListarTerrenosPropietarioAsync(
                    usuarioAsignacionSeleccionadoId);

            await Task.WhenAll(asignacionesTask, terrenosPropietarioTask);

            asignaciones = asignacionesTask.Result ?? [];
            terrenosAsignacionPropietario = terrenosPropietarioTask.Result ?? [];
            nuevaAsignacion = new AsignarUsuarioTerrenoRequest
            {
                UsuarioId = usuarioAsignacionSeleccionadoId,
                TipoAsignacion = "PROPIETARIO",
                EsResponsablePrincipal = true
            };
        }
        catch (Exception ex)
        {
            asignaciones = [];
            terrenosAsignacionPropietario = [];
            MostrarError(ex.Message);
        }
        finally
        {
            cargandoAsignacionesUsuario = false;
        }
    }

