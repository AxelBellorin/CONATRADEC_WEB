        }
    }

    private IReadOnlyList<FuenteNutrienteAdminItemModel>
        FiltrarInactivas()
    {
        IEnumerable<FuenteNutrienteAdminItemModel> query =
            inactivas;

        string texto =
            busqueda.Trim();

        if (!string.IsNullOrWhiteSpace(texto))
        {
            query =
                query.Where(item =>
                    item.NombreNutriente.Contains(
                        texto,
                        StringComparison.OrdinalIgnoreCase) ||
                    item.DescripcionNutriente.Contains(
                        texto,
                        StringComparison.OrdinalIgnoreCase));
        }

        query =
            categoria switch
            {
                "BALANCE_NUTRICIONAL" =>
                    query.Where(item =>
                        !item.HabilitadaEnmiendaCalcarea &&
                        !item.HabilitadaFertilizacionMixta),

                "FERTILIZACION_MIXTA" =>
                    query.Where(item =>
                        item.HabilitadaFertilizacionMixta),

                "ENMIENDA_CALCAREA" =>
                    query.Where(item =>
                        item.HabilitadaEnmiendaCalcarea),

                _ =>
                    query
            };

        return query
            .OrderBy(item =>
                item.NombreNutriente)
            .ToList();
    }

