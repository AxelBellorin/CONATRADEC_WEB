@page "/login"
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión | CONATRADEC</PageTitle>

<div class="@ClasePagina">
    <section class="login-visual">
        <div class="login-visual-content">
            <div class="login-copy">
                <div class="login-logo">
                    <i class="fa-solid fa-seedling"></i>
                </div>

                <p class="eyebrow">CONATRADEC</p>

                <h1>
                    Gestión agrícola en una sola plataforma
                </h1>

                <p>
                    Supervisa terrenos, análisis de suelo,
                    indicadores y actividad administrativa
                    desde cualquier computadora.
                </p>

                <div class="login-feature-list">
                    <span>
                        <i class="fa-solid fa-chart-pie"></i>
                        Indicadores consolidados
                    </span>

                    <span>
                        <i class="fa-solid fa-map"></i>
                        Mapa dinámico de terrenos
                    </span>

                    <span>
                        <i class="fa-solid fa-shield-halved"></i>
                        Acceso por permisos
                    </span>
                </div>
            </div>

            <div class="login-mascot-stage"
                 aria-hidden="true">
                <span class="mascot-glow"></span>
                <span class="coffee-bean bean-one"></span>
                <span class="coffee-bean bean-two"></span>
                <span class="coffee-bean bean-three"></span>

                <img class="login-mascot"
                     src="images/mascota-conatradec.webp"
                     width="720"
                     height="734"
                     alt="" />

                <span class="mascot-ground-shadow"></span>
            </div>
        </div>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <div class="login-card-header">
                <span class="mobile-logo mobile-mascot-logo">
                    <img src="images/mascota-conatradec.webp"
                         width="720"
                         height="734"
                         alt="Mascota de CONATRADEC" />
                </span>

                <p class="eyebrow">
                    Portal administrativo
                </p>

                <h2>Bienvenido</h2>

                <p>
                    Utiliza las mismas credenciales
                    de CONATRADEC.
                </p>
            </div>

            <EditForm Model="@modelo"
                      OnValidSubmit="IniciarSesionAsync"
                      FormName="login-form">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-error"
                         role="alert"
                         aria-live="polite">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@error</span>
                    </div>
                }

                <div class="form-group login-field-user">
                    <label for="usuario">
                        Usuario o correo
                    </label>

                    <div class="input-with-icon">
                        <i class="fa-regular fa-user"></i>

                        <InputText id="usuario"
                                   class="form-control"
                                   autocomplete="username"
                                   disabled="@procesando"
                                   @bind-Value="modelo.UsuarioOEmail"
                                   placeholder="Escribe tu usuario o correo" />
                    </div>

                    <ValidationMessage
                        For="() => modelo.UsuarioOEmail" />
                </div>

                <div class="form-group login-field-password">
                    <label for="clave">
                        Contraseña
                    </label>

                    <div class="input-with-icon">
                        <i class="fa-solid fa-lock"></i>

                        <InputText id="clave"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   disabled="@procesando"
                                   @bind-Value="modelo.Clave"
                                   placeholder="Escribe tu contraseña" />
                    </div>

                    <ValidationMessage
                        For="() => modelo.Clave" />
                </div>

                <button type="submit"
                        class="btn-primary btn-block login-submit"
                        disabled="@procesando">
                    @if (procesando)
                    {
                        <span class="spinner"></span>
                        <span>Validando...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        <span>Iniciar sesión</span>
                    }
                </button>
            </EditForm>

            <div class="login-note">
                <i class="fa-solid fa-circle-info"></i>

                <span>
                    El acceso y las opciones dependen
                    de tu rol y permisos.
                </span>
            </div>
        </div>
    </section>
</div>

@code {
    private readonly LoginRequest modelo = new();

    private bool procesando;
    private string? error;

    private string ClasePagina =>
        $"login-page{(procesando ? " is-processing" : string.Empty)}" +
        $"{(!string.IsNullOrWhiteSpace(error) ? " has-error" : string.Empty)}";

    private async Task IniciarSesionAsync()
    {
        if (procesando)
            return;

        procesando = true;
        error = null;

        try
        {
            ResultadoOperacion resultado =
                await AuthState.IniciarSesionAsync(
                    modelo);

            if (!resultado.Exitoso)
            {
                error = resultado.Mensaje;
                return;
            }

            Navigation.NavigateTo(
                "/",
                forceLoad: false,
                replace: true);
        }
        catch (Exception ex)
        {
            error =
                $"No fue posible completar el inicio de sesión. {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }
}
