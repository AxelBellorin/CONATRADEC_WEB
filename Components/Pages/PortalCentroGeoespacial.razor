        (!string.IsNullOrWhiteSpace(filtroNivel) ? 1 : 0) +
        (terrenoIdSeleccionado > 0 ? 1 : 0) +
        (soloConAlertas ? 1 : 0) +
        (!string.IsNullOrWhiteSpace(capaSueloActiva) ? 1 : 0) +
        (!string.IsNullOrWhiteSpace(capaClimaActiva) ? 1 : 0);

