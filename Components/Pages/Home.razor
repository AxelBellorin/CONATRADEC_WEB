@page "/"
@inject AuthStateService AuthState
@inject DashboardService DashboardService
@inject NavigationManager Navigation

<PageTitle>Dashboard ejecutivo | CONATRADEC</PageTitle>

@if (cargando)
{
    <LoadingState Mensaje="Preparando el centro de operaciones..." />
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <section class="panel dashboard-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <h1>No fue posible cargar el dashboard</h1>
        <p>@error</p>
        <button class="btn-primary" @onclick="CargarDatos">Reintentar</button>
    </section>
}
else
{
    <div class="executive-header">
        <div>
            <p class="eyebrow">Centro de operaciones</p>
            <h1>Dashboard ejecutivo</h1>
            <p>Resumen actualizado al @FechaConsultaTexto.</p>
        </div>

        <div class="executive-header-actions">
            <span class="dashboard-live-indicator">
                <i class="fa-solid fa-circle"></i>
                Datos de la API
            </span>
            <button class="btn-secondary" @onclick="CargarDatos">
                <i class="fa-solid fa-rotate"></i>
                Actualizar
            </button>
        </div>
    </div>

    <section class="executive-kpi-grid">
        <Kpi Icono="fa-map-location-dot" Clase="green"
             Titulo="Terrenos activos" Valor="@resumen.TotalTerrenos.ToString("N0")"
             Detalle="@($"{resumen.ExtensionTotalManzanas:N2} manzanas")" />

        <Kpi Icono="fa-flask" Clase="blue"
             Titulo="Análisis de suelo" Valor="@resumen.TotalAnalisis.ToString("N0")"
             Detalle="@($"{resumen.AnalisisMesActual:N0} este mes")" />

        <Kpi Icono="fa-seedling" Clase="brown"
             Titulo="Cobertura analizada" Valor="@($"{resumen.PorcentajeTerrenosAnalizados:N1}%")"
             Detalle="@($"{resumen.TerrenosConAnalisis} de {resumen.TotalTerrenos} terrenos")" />

        <Kpi Icono="fa-triangle-exclamation" Clase="orange"
             Titulo="Alertas críticas" Valor="@resumen.AlertasCriticas.ToString("N0")"
             Detalle="@($"{resumen.AlertasAtencion:N0} requieren atención")" />

        <Kpi Icono="fa-list-check" Clase="purple"
             Titulo="Seguimientos abiertos"
             Valor="@((resumen.SeguimientosPendientes + resumen.SeguimientosEnProceso).ToString("N0"))"
             Detalle="@($"{resumen.SeguimientosSinAsignar:N0} sin asignar")" />

        <Kpi Icono="fa-mobile-screen-button" Clase="cyan"
             Titulo="Conectados ahora" Valor="@resumen.DispositivosConectados.ToString("N0")"
             Detalle="@($"{resumen.UsuariosConectados:N0} usuarios únicos")" />
    </section>

    <section class="dashboard-main-grid">
        <article class="panel dashboard-chart-panel">
            <div class="panel-header">
                <div>
                    <h2>Actividad de análisis</h2>
                    <p>Últimos seis meses</p>
                </div>
                <span class="badge">@resumen.AnalisisUltimos30Dias en 30 días</span>
            </div>

            <div class="dashboard-bars">
                @foreach (var item in resumen.AnalisisPorMes)
                {
                    <div class="dashboard-bar-item">
                        <strong>@item.Cantidad</strong>
                        <div class="dashboard-bar-track">
                            <div class="dashboard-bar-fill"
                                 style="height:@Altura(item.Cantidad)%"></div>
                        </div>
                        <span>@item.Mes</span>
                    </div>
                }
            </div>
        </article>

        <article class="panel followup-overview">
            <div class="panel-header">
                <div>
                    <h2>Gestión de seguimientos</h2>
                    <p>Estado operativo actual</p>
                </div>
                <a class="btn-link" href="/seguimiento-alertas">Gestionar</a>
            </div>

            <div class="followup-ring" style="--value:@resumen.PorcentajeSeguimientosCerrados">
                <div>
                    <strong>@resumen.PorcentajeSeguimientosCerrados.ToString("N1")%</strong>
                    <span>cerrados</span>
                </div>
            </div>

            <div class="followup-legend">
                <span><i class="pending"></i>Pendientes <b>@resumen.SeguimientosPendientes</b></span>
                <span><i class="progress"></i>En proceso <b>@resumen.SeguimientosEnProceso</b></span>
                <span><i class="done"></i>Atendidos <b>@resumen.SeguimientosAtendidos</b></span>
                <span><i class="discarded"></i>Descartados <b>@resumen.SeguimientosDescartados</b></span>
            </div>
        </article>

        <article class="panel alerts-distribution">
            <div class="panel-header">
                <div>
                    <h2>Condiciones agrícolas</h2>
                    <p>Según los umbrales configurados</p>
                </div>
                <a class="btn-link" href="/configuracion-alertas">Umbrales</a>
            </div>

            @foreach (var item in resumen.DistribucionAlertas)
            {
                <div class="alert-distribution-row">
                    <span class="severity-dot @(item.Nivel == "CRITICA" ? "critical" : "attention")"></span>
                    <div><strong>@item.Nombre</strong><small>@item.Descripcion</small></div>
                    <b>@item.Cantidad</b>
                </div>
            }
        </article>

        <article class="panel departments-panel">
            <div class="panel-header">
                <div>
                    <h2>Cobertura territorial</h2>
                    <p>Principales departamentos</p>
                </div>
                <a class="btn-link" href="/mapa">Ver mapa</a>
            </div>

            @foreach (var item in resumen.Departamentos)
            {
                <div class="department-row">
                    <div><strong>@item.Departamento</strong><small>@item.Terrenos terrenos · @item.ExtensionManzanas.ToString("N2") Mz</small></div>
                    <div class="department-track"><span style="width:@item.CoberturaAnalisisPorcentaje%"></span></div>
                    <b>@item.CoberturaAnalisisPorcentaje.ToString("N1")%</b>
                </div>
            }
        </article>

        <article class="panel technicians-panel">
            <div class="panel-header">
                <div>
                    <h2>Carga de técnicos</h2>
                    <p>Seguimientos asignados</p>
                </div>
            </div>

            @if (resumen.Tecnicos.Count == 0)
            {
                <div class="dashboard-empty">No hay seguimientos asignados.</div>
            }
            else
            {
                @foreach (var tecnico in resumen.Tecnicos)
                {
                    <div class="technician-row">
                        <div class="technician-avatar">@Iniciales(tecnico.Nombre)</div>
                        <div><strong>@tecnico.Nombre</strong><small>@tecnico.Pendientes pendientes · @tecnico.EnProceso en proceso</small></div>
                        <b>@tecnico.TotalAbiertos abiertos</b>
                    </div>
                }
            }
        </article>

        <article class="panel quick-actions-panel">
            <div class="panel-header"><div><h2>Accesos rápidos</h2><p>Operación administrativa</p></div></div>
            <div class="quick-actions-grid">
                <a href="/alertas-agricolas"><i class="fa-solid fa-triangle-exclamation"></i><span>Centro de alertas</span></a>
                <a href="/seguimiento-alertas"><i class="fa-solid fa-list-check"></i><span>Seguimientos</span></a>
                <a href="/mapa"><i class="fa-solid fa-map"></i><span>Mapa inteligente</span></a>
                <a href="/dispositivos-conectados"><i class="fa-solid fa-laptop"></i><span>Dispositivos</span></a>
            </div>
        </article>
    </section>

    <section class="panel dashboard-alerts-table">
        <div class="panel-header">
            <div><h2>Terrenos que requieren atención</h2><p>Alertas recientes y estado del seguimiento</p></div>
            <a class="btn-link" href="/alertas-agricolas">Ver todas</a>
        </div>

        @if (resumen.AlertasRecientes.Count == 0)
        {
            <div class="dashboard-empty"><i class="fa-solid fa-circle-check"></i>No hay alertas activas para mostrar.</div>
        }
        else
        {
            <div class="responsive-table-wrapper">
                <table class="data-table">
                    <thead><tr><th>Nivel</th><th>Terreno</th><th>Ubicación</th><th>Condición</th><th>Seguimiento</th><th>Acción</th></tr></thead>
                    <tbody>
                        @foreach (var item in resumen.AlertasRecientes)
                        {
                            <tr>
                                <td><span class="executive-alert-badge @(item.Nivel == "CRITICA" ? "critical" : "attention")">@NivelTexto(item.Nivel)</span></td>
                                <td><strong>@item.CodigoTerreno</strong><small>@item.Propietario</small></td>
                                <td><strong>@item.Municipio</strong><small>@item.Departamento</small></td>
                                <td><strong>@item.Tipo</strong><small>@item.Valor?.ToString("N2") @item.Unidad</small></td>
                                <td>
                                    @if (item.SeguimientoId.HasValue)
                                    {
                                        <span class="followup-state">@EstadoTexto(item.EstadoSeguimiento)</span><small>@(item.Responsable ?? "Sin asignar")</small>
                                    }
                                    else
                                    {
                                        <span class="followup-state empty">Sin seguimiento</span>
                                    }
                                </td>
                                <td>
                                    <a class="table-action" href="@(item.SeguimientoId.HasValue ? $"/seguimiento-alertas?id={item.SeguimientoId}" : "/alertas-agricolas")">
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private DashboardEjecutivoResumen resumen = new();
    private bool cargando = true;
    private string? error;

    private string FechaConsultaTexto => resumen.FechaConsultaUtc == default
        ? DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")
        : DateTime.SpecifyKind(resumen.FechaConsultaUtc, DateTimeKind.Utc)
            .ToLocalTime().ToString("dd/MM/yyyy hh:mm tt");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await CargarDatos();
        StateHasChanged();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        error = null;
        try { resumen = await DashboardService.ObtenerResumenAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { cargando = false; }
    }

    private int Altura(int cantidad)
    {
        int maximo = Math.Max(1, resumen.AnalisisPorMes.Select(x => x.Cantidad).DefaultIfEmpty(0).Max());
        return Math.Max(6, (int)Math.Round(cantidad * 100d / maximo));
    }

    private static string Iniciales(string nombre) => string.Concat(nombre
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(x => char.ToUpperInvariant(x[0])));

    private static string NivelTexto(string nivel) => nivel == "CRITICA" ? "Crítica" : "Atención";

    private static string EstadoTexto(string? estado) => estado switch
    {
        "EN_PROCESO" => "En proceso",
        "ATENDIDA" => "Atendida",
        "DESCARTADA" => "Descartada",
        _ => "Pendiente"
    };
}
