@page "/parametros-agronomicos/rangos-nutricionales"
@page "/rangos-nutricionales"
@implements IDisposable
@inject AuthStateService AuthState
@inject ApiClientService Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Rangos nutricionales | CONATRADEC</PageTitle>

<section class="rn-page">
    <header class="rn-hero">
        <div>
            <span class="rn-eyebrow">Parámetros agronómicos</span>
            <h1>Rangos nutricionales por cultivo</h1>
            <p>
                Administra los límites de referencia utilizados para clasificar
                cada elemento químico y calcular el requerimiento anual.
            </p>
        </div>

        <div class="rn-actions">
            @if (PuedeActualizar)
            {
                <button class="rn-button secondary"
                        disabled="@procesando"
                        @onclick="AbrirCultivosEliminadosAsync">
                    <i class="fa-solid fa-trash-arrow-up"></i>
                    Eliminados
                </button>
            }

            <button class="rn-button secondary"
                    disabled="@procesando"
                    @onclick="ActualizarCultivosAsync">
                <i class="fa-solid fa-rotate"></i>
                Actualizar
            </button>

            @if (PuedeAgregar)
            {
                <button class="rn-button primary"
                        disabled="@procesando"
                        @onclick="AbrirCrearCultivo">
                    <i class="fa-solid fa-plus"></i>
                    Nuevo cultivo
                </button>
            }
        </div>
    </header>

    <aside class="rn-system-note">
        <i class="fa-solid fa-circle-info"></i>
        <div>
            <strong>Unidad oficial de administración: lb/Mz</strong>
            <span>
                La API convierte y conserva internamente los valores históricos
                en kg/Ha, pero esta pantalla siempre recibe y presenta libras
                por manzana. No escriba manualmente factores de conversión.
            </span>
        </div>
    </aside>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="rn-alert success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@mensaje</span>
            <button aria-label="Cerrar mensaje"
                    @onclick="LimpiarMensajes">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="rn-alert error">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@error</span>
            <button aria-label="Cerrar error"
                    @onclick="LimpiarMensajes">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (!PuedeLeer)
    {
        <section class="rn-empty">
            <i class="fa-solid fa-lock"></i>
            <h2>Sin permiso de lectura</h2>
            <p>
                Su rol no puede consultar los rangos nutricionales.
            </p>
        </section>
    }
    else
    {
        <section class="rn-summary">
            <article>
                <i class="fa-solid fa-wheat-awn"></i>
                <div>
                    <small>Cultivos registrados</small>
                    <strong>@cultivos.TotalRegistros</strong>
                </div>
            </article>

            <article>
                <i class="fa-solid fa-chart-simple"></i>
                <div>
                    <small>Rangos en esta página</small>
                    <strong>@TotalRangosPaginaCultivos</strong>
                </div>
            </article>

            <article>
                <i class="fa-solid fa-layer-group"></i>
                <div>
                    <small>Cultivos configurados</small>
                    <strong>@CultivosConfiguradosPagina</strong>
                </div>
            </article>

            <article>
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>
                    <small>Sin rangos en esta página</small>
                    <strong>@CultivosSinRangosPagina</strong>
                </div>
            </article>
        </section>

        <section class="rn-toolbar">
            <div class="rn-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="search"
                       maxlength="150"
                       placeholder="Buscar cultivo por nombre o descripción"
                       @bind="buscarCultivo"
                       @bind:event="oninput" />
            </div>

            <button class="rn-button primary"
                    disabled="@procesando"
                    @onclick="BuscarCultivosAsync">
                Buscar
            </button>

            <button class="rn-button ghost"
                    disabled="@procesando"
                    @onclick="LimpiarCultivosAsync">
                Limpiar
            </button>
        </section>

        @if (cargandoCultivos)
        {
            <LoadingState Mensaje="Cargando cultivos..." />
        }
        else if (cultivos.Items.Count == 0)
        {
            <section class="rn-empty">
                <i class="fa-solid fa-wheat-awn"></i>
                <h2>No se encontraron cultivos</h2>
                <p>
                    Registre o reactive un tipo de cultivo antes de configurar
                    sus rangos nutricionales.
                </p>
            </section>
        }
        else
        {
            <section class="rn-crop-grid">
                @foreach (RangoCultivoResumenModel cultivo in cultivos.Items)
                {
                    <article class="rn-crop-card @(cultivo.CantidadAportes == 0
                        ? "empty"
                        : string.Empty)">
                        <header>
                            <div class="rn-crop-icon">
                                <i class="fa-solid fa-seedling"></i>
                            </div>

                            <div>
                                <span>Tipo de cultivo</span>
                                <h2>@cultivo.NombreMostrar</h2>
                            </div>

                            <b class="rn-count">
                                @cultivo.CantidadAportes
                            </b>
                        </header>

                        <p>@cultivo.DescripcionMostrar</p>

                        <div class="rn-crop-status">
                            @if (cultivo.CantidadAportes > 0)
                            {
                                <i class="fa-solid fa-circle-check"></i>
                                <span>
                                    @cultivo.CantidadAportes rango(s)
                                    configurado(s)
                                </span>
                            }
                            else
                            {
                                <i class="fa-solid fa-circle-exclamation"></i>
                                <span>
                                    Sin elementos configurados
                                </span>
                            }
                        </div>

                        <div class="rn-crop-actions">
                            <button class="rn-button primary full"
                                    @onclick="() => AbrirCultivoAsync(cultivo)">
                                <i class="fa-solid fa-sliders"></i>
                                Administrar rangos
                            </button>

                            @if (PuedeEliminar)
                            {
                                <button class="rn-button danger"
                                        title="Eliminar tipo de cultivo"
                                        aria-label="Eliminar tipo de cultivo"
                                        disabled="@procesando"
                                        @onclick="() => EliminarCultivoAsync(cultivo)">
                                    <i class="fa-solid fa-trash-can"></i>
                                    <span>Eliminar cultivo</span>
                                </button>
                            }
                        </div>
                    </article>
                }
            </section>

            <Paginador Pagina="@cultivos.PaginaActual"
                       TotalPaginas="@cultivos.TotalPaginas"
                       TotalRegistros="@cultivos.TotalRegistros"
                       TamanoPagina="@cultivos.TamanoPagina"
                       Procesando="@procesando"
                       PaginaCambiada="CambiarPaginaCultivosAsync"
                       TamanoPaginaCambiado="CambiarTamanoCultivosAsync" />
        }
    }
</section>

@if (mostrarFormularioCultivo)
{
    <div class="rn-modal-backdrop top"
         @onclick="CerrarFormularioCultivoAsync">
        <article class="rn-form-modal"
                 @onclick:stopPropagation="true">
            <header>
                <div>
                    <span>Rangos nutricionales</span>
                    <h2>Crear tipo de cultivo</h2>
                </div>

                <button class="rn-close"
                        disabled="@procesando"
                        aria-label="Cerrar"
                        @onclick="CerrarFormularioCultivoAsync">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </header>

            <EditForm Model="formularioCultivo"
                      OnValidSubmit="GuardarCultivoAsync"
                      FormName="rango-nutriente-cultivo-form">
                <DataAnnotationsValidator />

                <div class="rn-form-body">
                    <div class="rn-form-note">
                        El cultivo se agregará al catálogo general y quedará
                        disponible para configurar sus rangos nutricionales.
                        El nombre se guardará en mayúsculas.
                    </div>

                    <div class="rn-form-grid">
                        <label class="full">
                            <span>Nombre del cultivo *</span>
                            <InputText class="rn-control"
                                       maxlength="80"
                                       @bind-Value="formularioCultivo.NombreTipoCultivo" />
                            <ValidationMessage
                                For="() => formularioCultivo.NombreTipoCultivo" />
                        </label>

                        <label class="full">
                            <span>Descripción</span>
                            <InputTextArea class="rn-control"
                                           rows="3"
                                           maxlength="150"
                                           @bind-Value="formularioCultivo.DescripcionTipoCultivo" />
                            <ValidationMessage
                                For="() => formularioCultivo.DescripcionTipoCultivo" />
                        </label>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorCultivo))
                    {
                        <div class="rn-form-error">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            @errorCultivo
                        </div>
                    }
                </div>

                <footer>
                    <button type="button"
                            class="rn-button ghost"
                            disabled="@procesando"
                            @onclick="CerrarFormularioCultivoAsync">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="rn-button primary"
                            disabled="@procesando">
                        <i class="fa-solid @(procesando
                            ? "fa-spinner fa-spin"
                            : "fa-floppy-disk")"></i>
                        @(procesando ? "Guardando..." : "Guardar cultivo")
                    </button>
                </footer>
            </EditForm>
        </article>
    </div>
}

@if (mostrarCultivosEliminados)
{
    <div class="rn-modal-backdrop top"
         @onclick="CerrarCultivosEliminados">
        <article class="rn-inactive-modal"
                 @onclick:stopPropagation="true">
            <header>
                <div>
                    <span>Papelera administrativa</span>
                    <h2>Tipos de cultivo eliminados</h2>
                </div>

                <button class="rn-close"
                        disabled="@procesando"
                        aria-label="Cerrar"
                        @onclick="CerrarCultivosEliminados">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </header>

            <div class="rn-form-body">
                <div class="rn-form-note">
                    La reactivación conserva rangos nutricionales y análisis
                    históricos relacionados con el mismo cultivo.
                </div>

                <div class="rn-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search"
                           placeholder="Buscar cultivo eliminado"
                           @bind="buscarCultivoEliminado"
                           @bind:event="oninput" />
                </div>

                @if (cargandoCultivosEliminados)
                {
                    <LoadingState
                        Mensaje="Cargando cultivos eliminados..." />
                }
                else if (CultivosEliminadosFiltrados.Count == 0)
                {
                    <section class="rn-empty compact">
                        <i class="fa-solid fa-trash-can"></i>
                        <h3>No hay cultivos eliminados</h3>
                    </section>
                }
                else
                {
                    <div class="rn-inactive-list">
                        @foreach (RangoEliminadoItemModel item
                            in CultivosEliminadosFiltrados)
                        {
                            <article>
                                <div class="rn-symbol small">
                                    <i class="fa-solid fa-seedling"></i>
                                </div>

                                <div>
                                    <h3>@item.Titulo</h3>
                                    <p>
                                        @(string.IsNullOrWhiteSpace(item.Subtitulo)
                                            ? item.Detalle
                                            : item.Subtitulo)
                                    </p>
                                </div>

                                <button class="rn-button primary"
                                        disabled="@procesando"
                                        @onclick="() => ReactivarCultivoAsync(item)">
                                    <i class="fa-solid fa-rotate-left"></i>
                                    Reactivar
                                </button>
                            </article>
                        }
                    </div>
                }
            </div>
        </article>
    </div>
}

@if (mostrarRangos && cultivoSeleccionado is not null)
{
    <div class="rn-modal-backdrop"
         @onclick="CerrarRangos">
        <article class="rn-ranges-modal"
                 @onclick:stopPropagation="true">
            <header class="rn-ranges-header">
                <div>
                    <span>Configuración agronómica</span>
                    <h2>@cultivoSeleccionado.NombreMostrar</h2>
                    <p>
                        @rangos.TotalRegistros elemento(s) con rango activo.
                    </p>
                </div>

                <div class="rn-actions">
                    @if (PuedeActualizar)
                    {
                        <button class="rn-button secondary"
                                disabled="@procesando"
                                @onclick="AbrirEliminadosAsync">
                            <i class="fa-solid fa-trash-arrow-up"></i>
                            Eliminados
                        </button>
                    }

                    @if (PuedeAgregar)
                    {
                        <button class="rn-button primary"
                                disabled="@procesando"
                                @onclick="AbrirCrear">
                            <i class="fa-solid fa-plus"></i>
                            Nuevo rango
                        </button>
                    }

                    <button class="rn-close"
                            aria-label="Cerrar"
                            disabled="@procesando"
                            @onclick="CerrarRangos">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </header>

            <section class="rn-ranges-toolbar">
                <div class="rn-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search"
                           maxlength="150"
                           placeholder="Buscar elemento, símbolo o descripción"
                           @bind="buscarRango"
                           @bind:event="oninput" />
                </div>

                <button class="rn-button primary"
                        disabled="@procesando"
                        @onclick="BuscarRangosAsync">
                    Buscar
                </button>

                <button class="rn-button ghost"
                        disabled="@procesando"
                        @onclick="LimpiarRangosAsync">
                    Limpiar
                </button>
            </section>

            <div class="rn-ranges-body">
                @if (cargandoRangos)
                {
                    <LoadingState Mensaje="Cargando rangos nutricionales..." />
                }
                else if (rangos.Items.Count == 0)
                {
                    <section class="rn-empty compact">
                        <i class="fa-solid fa-chart-simple"></i>
                        <h3>El cultivo no tiene rangos activos</h3>
                        <p>
                            Agregue los elementos que formarán la referencia
                            agronómica de este cultivo.
                        </p>
                    </section>
                }
                else
                {
                    <section class="rn-ranges-grid">
                        @foreach (RangoNutrienteItemModel item in rangos.Items)
                        {
                            <article class="rn-range-card">
                                <header>
                                    <div class="rn-symbol">
                                        @item.SimboloElementoQuimico
                                    </div>

                                    <div>
                                        <span>Elemento químico</span>
                                        <h3>@item.NombreElementoQuimico</h3>
                                    </div>

                                    <b>@item.UnidadBase</b>
                                </header>

                                <div class="rn-range-scale">
                                    <div>
                                        <small>Mínimo</small>
                                        <strong>
                                            @item.ValorMinimo.ToString("N2")
                                        </strong>
                                    </div>

                                    <i class="fa-solid fa-arrow-right"></i>

                                    <div>
                                        <small>Máximo</small>
                                        <strong>
                                            @item.ValorMaximo.ToString("N2")
                                        </strong>
                                    </div>
                                </div>

                                <div class="rn-width">
                                    <span>Amplitud del rango</span>
                                    <strong>
                                        @item.Amplitud.ToString("N2")
                                        @item.UnidadBase
                                    </strong>
                                </div>

                                <p>
                                    @(string.IsNullOrWhiteSpace(
                                        item.DescripcionParametro)
                                        ? "Sin descripción registrada."
                                        : item.DescripcionParametro)
                                </p>

                                <footer>
                                    <button class="rn-icon view"
                                            title="Ver detalle"
                                            @onclick="() => AbrirVer(item)">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>

                                    @if (PuedeActualizar)
                                    {
                                        <button class="rn-icon edit"
                                                title="Editar"
                                                @onclick="() => AbrirEditarAsync(item)">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                    }

                                    @if (PuedeEliminar)
                                    {
                                        <button class="rn-icon delete"
                                                title="Desactivar"
                                                @onclick="() => EliminarAsync(item)">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    }
                                </footer>
                            </article>
                        }
                    </section>

                    <Paginador Pagina="@rangos.PaginaActual"
                               TotalPaginas="@rangos.TotalPaginas"
                               TotalRegistros="@rangos.TotalRegistros"
                               TamanoPagina="@rangos.TamanoPagina"
                               Procesando="@procesando"
                               PaginaCambiada="CambiarPaginaRangosAsync"
                               TamanoPaginaCambiado="CambiarTamanoRangosAsync" />
                }
            </div>
        </article>
    </div>
}

@if (mostrarFormulario && cultivoSeleccionado is not null)
{
    <div class="rn-modal-backdrop top"
         @onclick="CerrarFormularioAsync">
        <article class="rn-form-modal"
                 @onclick:stopPropagation="true">
            <header>
                <div>
                    <span>@cultivoSeleccionado.NombreMostrar</span>
                    <h2>@TituloFormulario</h2>
                </div>

                <button class="rn-close"
                        disabled="@procesando"
                        aria-label="Cerrar"
                        @onclick="CerrarFormularioAsync">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </header>

            @if (modoFormulario == "ver")
            {
                <div class="rn-form-body">
                    <section class="rn-view-grid">
                        <article>
                            <small>Cultivo</small>
                            <strong>@cultivoSeleccionado.NombreMostrar</strong>
                        </article>

                        <article>
                            <small>Elemento</small>
                            <strong>@ElementoFormularioTexto</strong>
                        </article>

                        <article>
                            <small>Valor mínimo</small>
                            <strong>
                                @formulario.ValorMinimo.ToString("N2")
                                lb/Mz
                            </strong>
                        </article>

                        <article>
                            <small>Valor máximo</small>
                            <strong>
                                @formulario.ValorMaximo.ToString("N2")
                                lb/Mz
                            </strong>
                        </article>

                        <article class="full">
                            <small>Descripción</small>
                            <span>@formulario.DescripcionParametro</span>
                        </article>
                    </section>
                </div>

                <footer>
                    <button class="rn-button secondary"
                            @onclick="CerrarFormularioAsync">
                        Cerrar
                    </button>
                </footer>
            }
            else
            {
                <EditForm Model="formulario"
                          OnValidSubmit="GuardarAsync"
                          FormName="rango-nutriente-form">
                    <DataAnnotationsValidator />

                    <div class="rn-form-body">
                        <div class="rn-form-note">
                            Los valores se capturan en lb/Mz. El máximo debe
                            ser estrictamente mayor que el mínimo.
                        </div>

                        <div class="rn-form-grid">
                            <label class="full">
                                <span>Cultivo</span>
                                <input class="rn-control"
                                       value="@cultivoSeleccionado.NombreMostrar"
                                       disabled />
                            </label>

                            <label class="full">
                                <span>Elemento químico *</span>
                                <InputSelect class="rn-control"
                                             @bind-Value="formulario.ElementoQuimicosId">
                                    <option value="0">Seleccione</option>

                                    @foreach (ElementoRangoDisponibleModel elemento
                                        in elementosDisponibles)
                                    {
                                        <option value="@elemento.ElementoQuimicosId">
                                            @elemento.Texto
                                        </option>
                                    }
                                </InputSelect>
                                <ValidationMessage
                                    For="() => formulario.ElementoQuimicosId" />
                            </label>

                            <label>
                                <span>Valor mínimo (lb/Mz) *</span>
                                <InputNumber class="rn-control"
                                             min="0.0001"
                                             step="0.01"
                                             @bind-Value="formulario.ValorMinimo" />
                                <ValidationMessage
                                    For="() => formulario.ValorMinimo" />
                            </label>

                            <label>
                                <span>Valor máximo (lb/Mz) *</span>
                                <InputNumber class="rn-control"
                                             min="0.0001"
                                             step="0.01"
                                             @bind-Value="formulario.ValorMaximo" />
                                <ValidationMessage
                                    For="() => formulario.ValorMaximo" />
                            </label>

                            <label class="full">
                                <span>Descripción *</span>
                                <InputTextArea class="rn-control"
                                               rows="3"
                                               maxlength="150"
                                               @bind-Value="formulario.DescripcionParametro" />
                                <ValidationMessage
                                    For="() => formulario.DescripcionParametro" />
                            </label>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorFormulario))
                        {
                            <div class="rn-form-error">
                                <i class="fa-solid fa-circle-exclamation"></i>
                                @errorFormulario
                            </div>
                        }
                    </div>

                    <footer>
                        <button type="button"
                                class="rn-button ghost"
                                disabled="@procesando"
                                @onclick="CerrarFormularioAsync">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="rn-button primary"
                                disabled="@procesando">
                            <i class="fa-solid @(procesando
                                ? "fa-spinner fa-spin"
                                : "fa-floppy-disk")"></i>
                            @(procesando ? "Guardando..." : "Guardar")
                        </button>
                    </footer>
                </EditForm>
            }
        </article>
    </div>
}

@if (mostrarEliminados && cultivoSeleccionado is not null)
{
    <div class="rn-modal-backdrop top"
         @onclick="CerrarEliminados">
        <article class="rn-inactive-modal"
                 @onclick:stopPropagation="true">
            <header>
                <div>
                    <span>Papelera administrativa</span>
                    <h2>
                        Rangos eliminados ·
                        @cultivoSeleccionado.NombreMostrar
                    </h2>
                </div>

                <button class="rn-close"
                        disabled="@procesando"
                        aria-label="Cerrar"
                        @onclick="CerrarEliminados">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </header>

            <div class="rn-form-body">
                <div class="rn-form-note">
                    La reactivación conserva el identificador histórico. El
                    cultivo y el elemento químico deben permanecer activos.
                </div>

                <div class="rn-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="search"
                           placeholder="Buscar elemento eliminado"
                           @bind="buscarEliminado"
                           @bind:event="oninput" />
                </div>

                @if (cargandoEliminados)
                {
                    <LoadingState Mensaje="Cargando rangos eliminados..." />
                }
                else if (EliminadosFiltrados.Count == 0)
                {
                    <section class="rn-empty compact">
                        <i class="fa-solid fa-trash-can"></i>
                        <h3>No hay rangos eliminados para este cultivo</h3>
                    </section>
                }
                else
                {
                    <div class="rn-inactive-list">
                        @foreach (RangoEliminadoItemModel item
                            in EliminadosFiltrados)
                        {
                            <article>
                                <div class="rn-symbol small">
                                    @item.Codigo
                                </div>

                                <div>
                                    <h3>@item.Titulo</h3>
                                    <p>@item.Detalle</p>
                                </div>

                                <button class="rn-button primary"
                                        disabled="@procesando"
                                        @onclick="() => ReactivarAsync(item)">
                                    <i class="fa-solid fa-rotate-left"></i>
                                    Reactivar
                                </button>
                            </article>
                        }
                    </div>
                }
            </div>
        </article>
    </div>
}

