    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!AuthState.IsAuthenticated ||
            !AuthState.TienePermisoLectura(PermisosWeb.Portal) ||
            !AuthState.TienePermisoLectura(PermisosWeb.PortalPropietario))
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        referenciaDotNet = DotNetObjectReference.Create(this);

        await Task.WhenAll(
            CargarCatalogosAsync(),
            CargarDatosAsync(false));

        if (datos?.Vinculado == true)
        {
            await InicializarMapaAsync();
            await RenderizarMapaAsync(false, false);
            await CentrarNicaraguaAsync();
        }
    }

    private async Task CargarCatalogosAsync()
    {
        try
        {
            municipios = await MapaService.ObtenerMunicipiosAsync();
            departamentos = municipios
                .GroupBy(x => new
                {
                    x.DepartamentoId,
                    x.NombreDepartamento
                })
                .Select(x => new CatalogoSimple
                {
                    Id = x.Key.DepartamentoId,
                    Nombre = x.Key.NombreDepartamento
                })
                .OrderBy(x => x.Nombre)
                .ToList();
        }
        catch
        {
            municipios = [];
            departamentos = [];
        }
    }

    private async Task CargarDatosAsync(bool forzarClima)
    {
        cargando = true;
        error = string.Empty;
        StateHasChanged();

        try
        {
            datos = await Servicio.ObtenerMiCentroGeoespacialAsync(forzarClima);

            if (datos is null)
            {
                error = "El servidor no devolvió información geoespacial.";
                return;
            }

            ClimaMapaRespuesta climaCompleto =
                ConvertirClima(datos.Clima);

            climaNacional = LimitarClimaATerrenos(
                climaCompleto,
                datos.Terrenos);

            climaActual = climaNacional;
        }
        catch (UnauthorizedAccessException)
        {
            await AuthState.CerrarSesionAsync();
            Navigation.NavigateTo("/login", replace: true);
        }
        catch (Exception ex)
        {
            error = string.IsNullOrWhiteSpace(ex.Message)
                ? "No fue posible cargar el Centro Geoespacial."
                : ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task InicializarMapaAsync()
    {
        if (mapaInicializado)
            return;

        await JS.InvokeVoidAsync(
            "conatradecMapaInteligente.inicializar",
            "mapaTerrenosPropietario",
            referenciaDotNet);

        mapaInicializado = true;
    }

    private async Task RenderizarMapaAsync(
        bool ajustarTerrenos,
        bool ajustarTerritorio)
    {
        if (!mapaInicializado || datos is null)
            return;

        List<TerrenoMapaItem> terrenosMapa =
            TerrenosFiltrados.Select(ConvertirTerrenoMapa).ToList();

        await JS.InvokeVoidAsync(
            "conatradecMapaInteligente.mostrarTerrenos",
            "mapaTerrenosPropietario",
            terrenosMapa,
            ajustarTerrenos);

        await JS.InvokeVoidAsync(
            "conatradecMapaInteligente.mostrarClima",
            "mapaTerrenosPropietario",
            climaNacional);

        await AplicarFiltroTerritorialEnMapaAsync(ajustarTerritorio);

        await JS.InvokeVoidAsync(
            "conatradecMapaInteligente.aplicarCapas",
            "mapaTerrenosPropietario",
            capasActivas);

        if (!string.IsNullOrWhiteSpace(capaSueloActiva))
            await MostrarCapaSueloAsync(capaSueloActiva);
    }

    private async Task AplicarFiltroTerritorialEnMapaAsync(bool ajustarVista)
    {
        string departamento = DepartamentoSeleccionado?.Nombre ?? string.Empty;
        string municipio = MunicipioSeleccionado?.NombreMunicipio ?? string.Empty;

        ClimaMapaRespuesta? filtrado =
            await JS.InvokeAsync<ClimaMapaRespuesta?>(
                "conatradecMapaInteligente.aplicarFiltroTerritorial",
                "mapaTerrenosPropietario",
                departamento,
                municipio,
                ajustarVista);

        climaActual = filtrado ?? climaNacional;
        StateHasChanged();
    }

