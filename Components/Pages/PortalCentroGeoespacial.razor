            TemperaturaMinima = clima.TemperaturaMinima,
            TemperaturaMaxima = clima.TemperaturaMaxima,
            HumedadMinima = clima.HumedadMinima,
            HumedadMaxima = clima.HumedadMaxima,
            PrecipitacionMaxima = clima.PrecipitacionMaxima,
            VientoMaximo = clima.VientoMaximo,
