    private async Task CargarCatalogosAsync()
    {
        try
        {
            elementosCatalogo =
                await ApiClient.GetAsync<
                    List<ElementoQuimicoFuenteOptionModel>>(
                    "api/elemento-quimico/listar",
                    cancellation.Token) ??
                new();
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"No fue posible cargar los elementos químicos. {ex.Message}",
                true);
        }
    }

    private async Task CargarActivasAsync(int paginaSolicitada)
    {
        cargando = true;
        mostrarMatriz = false;
        composicion.Clear();

        try
        {
            string ruta =
                "api/fuente-nutriente/buscar" +
                $"?buscar={Uri.EscapeDataString(busqueda.Trim())}" +
                $"&categoria={Uri.EscapeDataString(categoria)}" +
                $"&pagina={Math.Max(1, paginaSolicitada)}" +
                $"&tamanoPagina={tamanoPagina}";

            pagina =
                await ApiClient.GetAsync<
                    FuenteNutrientePaginaModel>(
                    ruta,
                    cancellation.Token) ??
                new FuenteNutrientePaginaModel();

            if (pagina.TamanoPagina > 0)
            {
                tamanoPagina =
                    pagina.TamanoPagina;
            }
        }
        catch (Exception ex)
        {
            pagina =
                new FuenteNutrientePaginaModel();

            MostrarMensaje(
                $"No fue posible cargar las fuentes. {ex.Message}",
                true);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarInactivasAsync()
    {
