@page "/seguimiento-alertas"
@inject AuthStateService AuthState
@inject SeguimientoAlertasService Service
@inject NavigationManager Navigation

<PageTitle>Seguimiento de alertas | CONATRADEC</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Gestión técnica</p>
        <h1>Seguimiento de alertas</h1>
        <p>Asigna responsables, documenta acciones y consulta el historial.</p>
    </div>
    <div class="page-header-actions">
        <a class="btn-secondary" href="/alertas-agricolas">Alertas detectadas</a>
        <a class="btn-secondary" href="/reportes">Reportes</a>
        <button class="btn-primary" @onclick="Cargar">Actualizar</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError ? "alert-error" : "alert-success")">@mensaje</div>
}

@if (cargando)
{
    <LoadingState Mensaje="Cargando seguimientos..." />
}
else
{
    <section class="followup-grid">
        @foreach (SeguimientoAlertaItem item in seguimientos)
        {
            <article class="followup-card">
                <div class="followup-card-header">
                    <div>
                        <span class="executive-alert-badge @ClaseNivel(item.Nivel)">@item.Nivel</span>
                        <h3>@item.TipoAlerta</h3>
                    </div>
                    <span class="followup-status @item.Estado.ToLowerInvariant()">
                        @EstadoTexto(item.Estado)
                    </span>
                </div>
                <dl>
                    <div><dt>Terreno</dt><dd>#@item.TerrenoId</dd></div>
                    <div><dt>Responsable</dt><dd>@(item.UsuarioAsignado ?? "Sin asignar")</dd></div>
                    <div><dt>Último cambio</dt><dd>@item.FechaUltimaModificacionUtc.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</dd></div>
                </dl>
                <p>@(string.IsNullOrWhiteSpace(item.Observacion) ? "Sin observaciones." : item.Observacion)</p>
                <button class="btn-secondary" @onclick="() => Editar(item)">
                    Actualizar e historial
                </button>
            </article>
        }
    </section>
}

@if (editando is not null)
{
    <div class="modal-backdrop">
        <div class="modal-card modal-card-large">
            <div class="modal-header">
                <div>
                    <h2>Seguimiento técnico</h2>
                    <p>@editando.TipoAlerta · Terreno #@editando.TerrenoId</p>
                </div>
                <button class="modal-close" @onclick="CerrarModal">×</button>
            </div>

            <div class="form-group">
                <label>Estado</label>
                <InputSelect class="form-control" @bind-Value="formulario.Estado">
                    <option value="PENDIENTE">Pendiente</option>
                    <option value="EN_PROCESO">En proceso</option>
                    <option value="ATENDIDA">Atendida</option>
                    <option value="DESCARTADA">Descartada</option>
                </InputSelect>
            </div>

            <div class="form-group">
                <label>Técnico responsable</label>
                <InputSelect class="form-control" @bind-Value="formulario.UsuarioAsignadoId">
                    <option value="">Sin asignar</option>
                    @foreach (TecnicoAlertaItem tecnico in tecnicos)
                    {
                        <option value="@tecnico.UsuarioId">@tecnico.Etiqueta</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label>Observación técnica</label>
                <InputTextArea class="form-control followup-observation"
                               @bind-Value="formulario.Observacion" />
            </div>

            <div class="modal-actions">
                <button class="btn-link" @onclick="CerrarModal">Cancelar</button>
                <button class="btn-primary" @onclick="Guardar" disabled="@guardando">
                    Guardar cambios
                </button>
            </div>

            <h3>Historial</h3>
            <div class="timeline">
                @if (historial.Count == 0)
                {
                    <p>No hay movimientos registrados.</p>
                }
                @foreach (HistorialAlertaItem item in historial)
                {
                    <article class="timeline-item">
                        <strong>@item.Accion · @item.Usuario</strong>
                        <p>@item.Detalle</p>
                        <small>@item.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</small>
                    </article>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<SeguimientoAlertaItem> seguimientos = [];
    private List<TecnicoAlertaItem> tecnicos = [];
    private List<HistorialAlertaItem> historial = [];
    private SeguimientoAlertaItem? editando;
    private ActualizarSeguimientoAlerta formulario = new();
    private bool cargando = true;
    private bool guardando;
    private string? mensaje;
    private bool esError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        await Cargar();
        StateHasChanged();
    }

    private async Task Cargar()
    {
        cargando = true;
        try
        {
            var seguimientosTask = Service.ListarAsync();
            var tecnicosTask = Service.TecnicosAsync();
            await Task.WhenAll(seguimientosTask, tecnicosTask);
            seguimientos = await seguimientosTask;
            tecnicos = await tecnicosTask;
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Editar(SeguimientoAlertaItem item)
    {
        editando = item;
        formulario = new ActualizarSeguimientoAlerta
        {
            Estado = item.Estado,
            UsuarioAsignadoId = item.UsuarioAsignadoId,
            Observacion = item.Observacion,
            UsuarioAccionId = AuthState.Usuario?.UsuarioId ?? 0
        };
        historial = await Service.HistorialAsync(item.SeguimientoAlertaAgricolaId);
    }

    private void CerrarModal()
    {
        editando = null;
        historial = [];
    }

    private async Task Guardar()
    {
        if (editando is null) return;
        guardando = true;
        try
        {
            await Service.ActualizarAsync(
                editando.SeguimientoAlertaAgricolaId, formulario);
            historial = await Service.HistorialAsync(
                editando.SeguimientoAlertaAgricolaId);
            mensaje = "Seguimiento actualizado correctamente.";
            esError = false;
            seguimientos = await Service.ListarAsync();
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
        finally
        {
            guardando = false;
        }
    }

    private static string ClaseNivel(string nivel) =>
        nivel == "CRITICA" ? "critical" : "attention";

    private static string EstadoTexto(string estado) =>
        estado switch
        {
            "EN_PROCESO" => "En proceso",
            "ATENDIDA" => "Atendida",
            "DESCARTADA" => "Descartada",
            _ => "Pendiente"
        };
}
