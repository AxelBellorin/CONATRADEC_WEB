@if (TotalRegistros > 0)
{
    <section class="admin-pager" aria-label="Paginación">
        <div class="admin-pager-summary">
            <strong>@PrimerRegistro-@UltimoRegistro</strong>
            <span>de @TotalRegistros registros</span>
        </div>

        <div class="admin-pager-controls">
            <button type="button"
                    class="btn-secondary"
                    disabled="@(Pagina <= 1 || Procesando)"
                    @onclick="IrAnterior">
                <i class="fa-solid fa-chevron-left"></i>
                Anterior
            </button>

            <span class="admin-pager-current">
                Página <strong>@Pagina</strong>
                de <strong>@Math.Max(1, TotalPaginas)</strong>
            </span>

            <button type="button"
                    class="btn-secondary"
                    disabled="@(Pagina >= TotalPaginas || Procesando)"
                    @onclick="IrSiguiente">
                Siguiente
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>

        <label class="admin-pager-size">
            <span>Mostrar</span>
            <select class="form-control"
                    value="@TamanoPagina"
                    disabled="@Procesando"
                    @onchange="CambiarTamano">
                @foreach (int opcion in OpcionesTamano)
                {
                    <option value="@opcion">@opcion</option>
                }
            </select>
        </label>
    </section>
}

@code {
    [Parameter]
    public int Pagina { get; set; } = 1;

    [Parameter]
    public int TotalPaginas { get; set; }

    [Parameter]
    public int TotalRegistros { get; set; }

    [Parameter]
    public int TamanoPagina { get; set; } = 12;

    [Parameter]
    public bool Procesando { get; set; }

    [Parameter]
    public int[] OpcionesTamano { get; set; } =
        [12, 24, 48, 96];

    [Parameter]
    public EventCallback<int> PaginaCambiada { get; set; }

    [Parameter]
    public EventCallback<int> TamanoPaginaCambiado { get; set; }

    private int PrimerRegistro =>
        TotalRegistros == 0
            ? 0
            : ((Pagina - 1) * TamanoPagina) + 1;

    private int UltimoRegistro =>
        Math.Min(
            Pagina * TamanoPagina,
            TotalRegistros);

    private Task IrAnterior() =>
        PaginaCambiada.InvokeAsync(
            Math.Max(1, Pagina - 1));

    private Task IrSiguiente() =>
        PaginaCambiada.InvokeAsync(
            Math.Min(TotalPaginas, Pagina + 1));

    private async Task CambiarTamano(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int valor))
            await TamanoPaginaCambiado.InvokeAsync(valor);
    }
}
