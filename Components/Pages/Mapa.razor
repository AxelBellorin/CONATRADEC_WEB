        return Task.CompletedTask;
    }

    private async Task CambiarCapaAsync(string clave, ChangeEventArgs args)
    {
        bool activa = args.Value is bool valor && valor;
        modoActivo = "PERSONALIZADO";

        if (activa && ClavesClima.Contains(clave))
        {
            foreach (string otraCapa in ClavesClima.Where(item =>
                         !item.Equals(clave, StringComparison.OrdinalIgnoreCase)))
            {
                capasActivas[otraCapa] = false;
            }
        }

        if (activa && EsCapaSuelo(clave))
        {
            foreach (MapaCapaDisponible otraCapa in CapasDisponibles.Where(item =>
                         item.Categoria.Equals(
                             "SUELOS",
                             StringComparison.OrdinalIgnoreCase) &&
                         !item.Clave.Equals(
                             clave,
                             StringComparison.OrdinalIgnoreCase)))
            {
                capasActivas[otraCapa.Clave] = false;
            }
        }

        capasActivas[clave] = activa;

        if (activa && ClavesClima.Contains(clave) && !climaConsultado)
            await CargarClimaAsync();

        if (activa && EsCapaSuelo(clave))
            await CargarCapaSueloAsync(clave);

        await JS.InvokeVoidAsync(
            "conatradecMapaInteligente.aplicarCapas",
            "mapaTerrenos",
            capasActivas);
    }

    private async Task AplicarModoAsync(string modo)
    {
        modoActivo = modo;

        foreach (string clave in capasActivas.Keys.ToList())
            capasActivas[clave] = false;

        capasActivas["departamentos"] = true;

        switch (modo)
        {
            case "AGRICOLA":
                panelFiltroActivo = "AGRICOLA";
                capasActivas["terrenos"] = true;
                capasActivas["alertas"] = true;
                capasActivas["ph"] = true;
                break;

            case "SUELO":
                panelFiltroActivo = "SUELO";
                capasActivas["terrenos"] = true;
                capasActivas["ph"] = true;
                break;

            case "CLIMA":
                panelFiltroActivo = "CLIMA";
                capasActivas["temperatura"] = true;
                break;

            default:
                panelFiltroActivo = "TERRITORIO";
                capasActivas["terrenos"] = true;
                capasActivas["alertas"] = true;
                break;
        }

        if (modo == "CLIMA" && !climaConsultado)
            await CargarClimaAsync();

        if (modo is "AGRICOLA" or "SUELO")
            await CargarCapaSueloAsync("ph");

        await JS.InvokeVoidAsync(
            "conatradecMapaInteligente.aplicarCapas",
            "mapaTerrenos",
            capasActivas);
    }

