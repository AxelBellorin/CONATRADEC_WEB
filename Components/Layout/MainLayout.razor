@inherits LayoutComponentBase
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject AuthStateService AuthState
@inject WebActivityService Actividad
@inject ApiClientService ApiClient
@inject PortalPropietarioService PortalPropietario
@inject NavigationManager Navigation
@inject IJSRuntime JS

@if (!AuthState.IsAuthenticated)
{
    <main class="public-layout">
        @Body
    </main>
}
else if (!TieneAccesoPortalWeb)
{
    <main class="portal-access-pending">
        <div>
            <i class="fa-solid fa-lock"></i>
            <h2>Acceso web no habilitado</h2>
            <p>
                Su sesión será cerrada porque el rol no tiene
                el permiso “Acceso al portal web”.
            </p>
        </div>
    </main>
}
else
{
    <div class="admin-shell">
        <aside class="sidebar @(menuAbierto ? "open" : string.Empty)">
            <div class="brand">
                <div class="brand-icon">
                    <i class="fa-solid fa-seedling"></i>
                </div>

                <div>
                    <strong>CONATRADEC</strong>
                    <span>
                        @(EsPortalPropietarioExclusivo
                            ? "Portal del propietario"
                            : "Portal administrativo")
                    </span>
                </div>
            </div>

            <nav class="nav-menu"
                 @onclick="CerrarMenuMovil">

                @if (EsPortalPropietarioExclusivo)
                {
                    <div class="nav-section">
                        Mi información
                    </div>

                    <NavLink href="/mi-portal"
                             Match="NavLinkMatch.All">
                        <i class="fa-solid fa-house-chimney-user"></i>
                        <span>Mi información y terrenos</span>
                    </NavLink>

                    @if (PuedeMostrarClimaLabores)
                    {
                        <NavLink href="/mi-portal/clima-labores">
                            <i class="fa-solid fa-cloud-sun-rain"></i>
                            <span>Clima y labores</span>
                        </NavLink>
                    }

                    @if (PuedeMostrarMiCentroGeoespacial)
                    {
                        <NavLink href="/mi-portal/centro-geoespacial">
                            <i class="fa-solid fa-map-location-dot"></i>
                            <span>Mi Centro Geoespacial</span>
                        </NavLink>
                    }
                }
                else
                {
                    <NavLink href="/"
                             Match="NavLinkMatch.All">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Dashboard</span>
                    </NavLink>

                    @if (TienePortalPropietario)
                    {
                        <NavLink href="/mi-portal">
                            <i class="fa-solid fa-house-chimney-user"></i>
                            <span>Mi información y terrenos</span>
                        </NavLink>

                        @if (PuedeMostrarClimaLabores)
                        {
                            <NavLink href="/mi-portal/clima-labores">
                                <i class="fa-solid fa-cloud-sun-rain"></i>
                                <span>Clima y labores</span>
                            </NavLink>
                        }

                        @if (PuedeMostrarMiCentroGeoespacial)
                        {
                            <NavLink href="/mi-portal/centro-geoespacial">
                                <i class="fa-solid fa-map-location-dot"></i>
                                <span>Mi Centro Geoespacial</span>
                            </NavLink>
                        }
                    }

                    @if (AuthState.TienePermisoLectura("TerrenoPage") ||
                         AuthState.TienePermisoLectura("terrenoPage") ||
                         AuthState.TienePermisoLectura("MapaTerrenosWeb") ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/mapa">
                            <i class="fa-solid fa-map-location-dot"></i>
                            <span>Centro Geoespacial nacional</span>
                        </NavLink>
                    }

                    @if (PuedeVerSupervision)
                    {
                        <div class="nav-section">
                            Supervisión agrícola
                        </div>
                    }

                    @if (AuthState.TienePermisoLectura(PermisosWeb.Alertas) ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/alertas-agricolas">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <span>Centro de alertas</span>
                        </NavLink>
                    }

                    @if (AuthState.TienePermisoLectura(
                             PermisosWeb.SeguimientoAlertas) ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/seguimiento-alertas">
                            <i class="fa-solid fa-list-check"></i>
                            <span>Seguimiento</span>
                        </NavLink>
                    }

                    @if (AuthState.TienePermisoLectura(
                             PermisosWeb.ConfiguracionAlertas) ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/configuracion-alertas">
                            <i class="fa-solid fa-sliders"></i>
                            <span>Umbrales</span>
                        </NavLink>
                    }

                    @if (PuedeAdministrarReglasClima)
                    {
                        <NavLink href="/configuracion/reglas-clima">
                            <i class="fa-solid fa-cloud-sun"></i>
                            <span>Reglas de labores</span>
                        </NavLink>
                    }

                    @if (AuthState.TienePermisoLectura(
                             PermisosWeb.AuditoriaAnalisis) ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/control-analisis">
                            <i class="fa-solid fa-magnifying-glass-chart"></i>
                            <span>Control de análisis</span>
                        </NavLink>
                    }

                    @if (PuedeVerReportes)
                    {
                        <NavLink href="/reportes">
                            <i class="fa-solid fa-file-lines"></i>
                            <span>Centro de reportes</span>
                        </NavLink>
                    }

                    @if (PuedeVerPropietarios ||
                         PuedeVerTerrenos ||
                         PuedeVerFotosTerreno ||
                         PuedeVerParametrizacionAcceso)
                    {
                        <div class="nav-section">
                            Propietarios y cobertura
                        </div>

                        @if (PuedeVerPropietarios)
                        {
                            <NavLink href="/propietarios">
                                <i class="fa-solid fa-address-card"></i>
                                <span>Propietarios</span>
                            </NavLink>
                        }

                        @if (PuedeVerTerrenos)
                        {
                            <NavLink href="/terrenos">
                                <i class="fa-solid fa-map-location-dot"></i>
                                <span>Terrenos</span>
                            </NavLink>
                        }

                        @if (PuedeVerFotosTerreno)
                        {
                            <NavLink href="/terrenos/fotografias">
                                <i class="fa-solid fa-images"></i>
                                <span>Fotografías de terrenos</span>
                            </NavLink>
                        }

                        @if (PuedeVerParametrizacionAcceso)
                        {
                            <NavLink href="/parametrizacion-acceso">
                                <i class="fa-solid fa-people-roof"></i>
                                <span>Acceso a terrenos</span>
                            </NavLink>
                        }
                    }

                    @if (PuedeVerParametrosAgronomicos)
                    {
                        <div class="nav-section">
                            Parámetros agronómicos
                        </div>

                        @if (PuedeVerElementosQuimicos)
                        {
                            <NavLink href="/parametros-agronomicos/elementos-quimicos">
                                <i class="fa-solid fa-flask"></i>
                                <span>Elementos químicos</span>
                            </NavLink>
                        }

                        @if (PuedeVerTiposCultivo)
                        {
                            <NavLink href="/parametros-agronomicos/tipos-cultivo">
                                <i class="fa-solid fa-wheat-awn"></i>
                                <span>Tipos de cultivo</span>
                            </NavLink>
                        }

                        @if (PuedeVerTiposAnalisis)
                        {
                            <NavLink href="/parametros-agronomicos/tipos-analisis-suelo">
                                <i class="fa-solid fa-vials"></i>
                                <span>Tipos de análisis</span>
                            </NavLink>
                        }

                        @if (PuedeVerFuentesNutrientes)
                        {
                            <NavLink href="/parametros-agronomicos/fuentes-nutrientes">
                                <i class="fa-solid fa-flask-vial"></i>
                                <span>Fuentes de nutrientes</span>
                            </NavLink>
                        }

                        @if (PuedeVerExtraccionNutrientes)
                        {
                            <NavLink href="/parametros-agronomicos/extraccion-nutrientes">
                                <i class="fa-solid fa-arrow-up-right-dots"></i>
                                <span>Extracción de nutrientes</span>
                            </NavLink>
                        }

                        @if (PuedeVerRangosNutrientes)
                        {
                            <NavLink href="/parametros-agronomicos/rangos-nutricionales">
                                <i class="fa-solid fa-chart-simple"></i>
                                <span>Rangos nutricionales</span>
                            </NavLink>
                        }

                        @if (PuedeVerUnidadesConversiones)
                        {
                            <NavLink href="/parametros-agronomicos/unidades-conversiones">
                                <i class="fa-solid fa-right-left"></i>
                                <span>Unidades y conversiones</span>
                            </NavLink>
                        }
                    }

                    @if (PuedeVerUbicaciones)
                    {
                        <div class="nav-section">
                            Catálogos generales
                        </div>

                        <NavLink href="/configuracion/ubicaciones">
                            <i class="fa-solid fa-earth-americas"></i>
                            <span>Ubicaciones geográficas</span>
                        </NavLink>
                    }

                    @if (PuedeVerContenidoAdministrativo)
                    {
                        <div class="nav-section">
                            Contenido
                        </div>

                        @if (PuedeAdministrarNoticias)
                        {
                            <NavLink href="/contenido/publicaciones">
                                <i class="fa-solid fa-newspaper"></i>
                                <span>Noticias y publicaciones</span>
                            </NavLink>
                        }

                        @if (PuedeVerCategoriasPublicacion)
                        {
                            <NavLink href="/contenido/tipos-publicacion">
                                <i class="fa-solid fa-tags"></i>
                                <span>Tipos de publicación</span>
                            </NavLink>
                        }

                        @if (PuedeVerAlbumBotanico)
                        {
                            <NavLink href="/contenido/album-botanico">
                                <i class="fa-solid fa-seedling"></i>
                                <span>Álbum botánico</span>
                            </NavLink>
                        }
                    }

                    <div class="nav-section">
                        Administración
                    </div>

                    @if (AuthState.TienePermisoLectura("UsuarioPage") ||
                         AuthState.TienePermisoLectura("userPage") ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/usuarios">
                            <i class="fa-solid fa-users"></i>
                            <span>Usuarios</span>
                        </NavLink>
                    }

                    @if (AuthState.TienePermisoLectura(PermisosWeb.Roles) ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/roles">
                            <i class="fa-solid fa-user-shield"></i>
                            <span>Roles</span>
                        </NavLink>
                    }

                    @if (AuthState.TienePermisoLectura(PermisosWeb.Matriz) ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/matriz-permisos">
                            <i class="fa-solid fa-table-cells"></i>
                            <span>Matriz de permisos</span>
                        </NavLink>
                    }

                    @if (AuthState.TienePermisoLectura(
                             "dispositivosConectadosPage") ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/dispositivos-conectados">
                            <i class="fa-solid fa-laptop"></i>
                            <span>Dispositivos conectados</span>
                        </NavLink>
                    }

                    @if (AuthState.TienePermisoLectura(
                             PermisosWeb.Actualizaciones) ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/actualizaciones">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                            <span>Actualizaciones</span>
                        </NavLink>
                    }

                    @if (AuthState.TienePermisoLectura(
                             PermisosWeb.LlavesDescarga) ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/actualizaciones/llaves">
                            <i class="fa-solid fa-key"></i>
                            <span>Llaves de descarga</span>
                        </NavLink>
                    }

                    @if (AuthState.TienePermisoLectura("BitacoraPage") ||
                         AuthState.TienePermisoLectura("bitacoraPage") ||
                         AuthState.EsAdministrador)
                    {
                        <NavLink href="/bitacora">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            <span>Bitácora</span>
                        </NavLink>
                    }

                    <NavLink href="/configuracion">
                        <i class="fa-solid fa-gear"></i>
                        <span>Configuración</span>
                    </NavLink>
                }
            </nav>

            <div class="sidebar-user">
                <div class="avatar">
                    @ObtenerIniciales()
                </div>

                <div class="sidebar-user-data">
                    <strong>
                        @AuthState.Usuario?.NombreCompletoUsuario
                    </strong>

                    <span>
                        @AuthState.Usuario?.RolNombre
                    </span>
                </div>

                <button class="icon-button"
                        title="Cerrar sesión"
                        @onclick="CerrarSesionAsync">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </button>
            </div>
        </aside>

        @if (menuAbierto)
        {
            <button class="sidebar-overlay"
                    aria-label="Cerrar menú"
                    @onclick="ToggleMenu">
            </button>
        }

        <section class="content-shell">
            <header class="topbar">
                <button class="menu-button"
                        @onclick="ToggleMenu"
                        aria-label="Abrir menú">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <div class="topbar-title">
                    <span>
                        @(EsPortalPropietarioExclusivo
                            ? "Información de mis terrenos"
                            : "Administración y monitoreo")
                    </span>
                </div>

                <div class="topbar-user">
                    <i class="fa-regular fa-circle-user"></i>

                    <span>
                        @AuthState.Usuario?.NombreUsuario
                    </span>
                </div>
            </header>

            <main class="page-content @(EsRutaMapaNacional
                ? "map-page-content"
                : string.Empty)">
                @if (PuedeMostrarContenidoActual)
                {
                    @Body

                    @if (EsInicioPortalPropietario)
                    {
                        <ResumenPoligonosPropietario />
                    }
                }
                else
                {
                    <div class="route-guard-loading">
                        <div>
                            <i class="fa-solid fa-shield-halved"></i>
                            <h2>Validando acceso</h2>
                            <p>
                                Estamos dirigiendo su sesión
                                al espacio autorizado.
                            </p>
                        </div>
                    </div>
                }
            </main>
        </section>
    </div>

    <!--
        Carga las delimitaciones según el contexto:
        administración o terrenos propios del propietario.
    -->
    <TerrenoPoligonosGlobal />

    <!--
        Se activa únicamente en /mapa. No modifica Mi Centro Geoespacial
        del propietario.
    -->
    <ResumenTerritorialGlobal />
}

@code {
    private const string PermisoReglasClima =
        "ReglasAgricolasClimaPage";

    private const string PermisoAlbumBotanico =
        "albumFotosPage";

    private const string PermisoTerrenos =
        "terrenoPage";

    private const string PermisoElementosQuimicos =
        "elementoQuimicoPage";

    private const string PermisoTiposCultivo =
        "tipoCultivoPage";

    private const string PermisoTiposAnalisis =
        "tipoAnalisisSueloPage";

    private const string PermisoFuentesNutrientes =
        "fuenteNutrientePage";

    private const string PermisoExtraccionNutrientes =
        "extraccionNutrientePage";

    private const string PermisoRangosNutrientes =
        "rangoNutrientePage";

    private const string PermisoPaises =
        "paisPage";

    private const string PermisoDepartamentos =
        "departamentoPage";

    private const string PermisoMunicipios =
        "municipioPage";

    private const string PermisoNoticias =
        "noticiasPage";

    private const string PermisoCategoriasPublicacion =
        "categoriaPublicacionPage";

    private const string PermisoUnidadesConversiones =
        "unidadesConversionesPage";

    private const string PermisoReportes =
        "reportesPage";

    private bool menuAbierto;
    private bool monitorInactividadActivo;
    private bool cerrandoPorFaltaPermiso;
    private bool aplicandoProteccion;
    private bool resumenPortalConsultado;
    private bool? tieneTerrenosPropios;
    private DotNetObjectReference<MainLayout>? referenciaDotNet;

    private bool TieneAccesoPortalWeb =>
        AuthState.TienePermisoLectura(
            PermisosWeb.Portal);

    private bool TienePortalPropietario =>
        AuthState.TienePermisoLectura(
            PermisosWeb.PortalPropietario);

    private bool PuedeMostrarMiCentroGeoespacial =>
        TienePortalPropietario &&
        tieneTerrenosPropios == true;

    private bool PuedeMostrarClimaLabores =>
        TienePortalPropietario &&
        tieneTerrenosPropios == true;

    private bool PuedeAdministrarReglasClima =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoReglasClima);

    private bool PuedeVerAlbumBotanico =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoAlbumBotanico);

    private bool PuedeVerUbicaciones =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoPaises) ||
        AuthState.TienePermisoLectura(
            PermisoDepartamentos) ||
        AuthState.TienePermisoLectura(
            PermisoMunicipios);

    private bool PuedeAdministrarNoticias =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoAgregar(
            PermisoNoticias) ||
        AuthState.TienePermisoActualizar(
            PermisoNoticias) ||
        AuthState.TienePermisoEliminar(
            PermisoNoticias);

    private bool PuedeVerCategoriasPublicacion =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoCategoriasPublicacion);

    private bool PuedeVerContenidoAdministrativo =>
        PuedeAdministrarNoticias ||
        PuedeVerCategoriasPublicacion ||
        PuedeVerAlbumBotanico;

    private bool PuedeVerPropietarios =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisosWeb.Propietarios);

    private bool PuedeVerReportes =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoReportes);

    private bool PuedeVerFotosTerreno =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisosWeb.FotosTerreno);

    private bool PuedeVerTerrenos =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoTerrenos) ||
        AuthState.TienePermisoLectura(
            "TerrenoPage");

    private bool PuedeVerElementosQuimicos =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoElementosQuimicos);

    private bool PuedeVerTiposCultivo =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoTiposCultivo);

    private bool PuedeVerTiposAnalisis =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoTiposAnalisis);

    private bool PuedeVerFuentesNutrientes =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoFuentesNutrientes);

    private bool PuedeVerExtraccionNutrientes =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoExtraccionNutrientes);

    private bool PuedeVerRangosNutrientes =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoRangosNutrientes);

    private bool PuedeVerUnidadesConversiones =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisoUnidadesConversiones);

    private bool PuedeVerParametrosAgronomicos =>
        PuedeVerElementosQuimicos ||
        PuedeVerTiposCultivo ||
        PuedeVerTiposAnalisis ||
        PuedeVerFuentesNutrientes ||
        PuedeVerExtraccionNutrientes ||
        PuedeVerRangosNutrientes ||
        PuedeVerUnidadesConversiones;

    private bool EsPortalPropietarioExclusivo =>
        TienePortalPropietario &&
        !TieneFuncionesAdministrativas;

    private bool TieneFuncionesAdministrativas =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura("TerrenoPage") ||
        AuthState.TienePermisoLectura("terrenoPage") ||
        AuthState.TienePermisoLectura("MapaTerrenosWeb") ||
        AuthState.TienePermisoLectura(PermisosWeb.Alertas) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.SeguimientoAlertas) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.ConfiguracionAlertas) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.AuditoriaAnalisis) ||
        AuthState.TienePermisoLectura(
            PermisoReglasClima) ||
        AuthState.TienePermisoLectura(
            PermisoAlbumBotanico) ||
        PuedeVerUbicaciones ||
        PuedeAdministrarNoticias ||
        PuedeVerCategoriasPublicacion ||
        PuedeVerReportes ||
        PuedeVerFotosTerreno ||
        PuedeVerUnidadesConversiones ||
        AuthState.TienePermisoLectura(
            PermisoElementosQuimicos) ||
        AuthState.TienePermisoLectura(
            PermisoTiposCultivo) ||
        AuthState.TienePermisoLectura(
            PermisoTiposAnalisis) ||
        AuthState.TienePermisoLectura(
            PermisoFuentesNutrientes) ||
        AuthState.TienePermisoLectura(
            PermisoExtraccionNutrientes) ||
        AuthState.TienePermisoLectura(
            PermisoRangosNutrientes) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.ParametrizacionAcceso) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.Propietarios) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.UsuarioPropietario) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.AsignacionTerreno) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.CoberturaTerritorial) ||
        AuthState.TienePermisoLectura("UsuarioPage") ||
        AuthState.TienePermisoLectura("userPage") ||
        AuthState.TienePermisoLectura(PermisosWeb.Roles) ||
        AuthState.TienePermisoLectura(PermisosWeb.Matriz) ||
        AuthState.TienePermisoLectura(
            "dispositivosConectadosPage") ||
        AuthState.TienePermisoLectura(
            PermisosWeb.Actualizaciones) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.LlavesDescarga) ||
        AuthState.TienePermisoLectura("BitacoraPage") ||
        AuthState.TienePermisoLectura("bitacoraPage");

    private bool PuedeVerSupervision =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            PermisosWeb.Alertas) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.SeguimientoAlertas) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.ConfiguracionAlertas) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.AuditoriaAnalisis) ||
        AuthState.TienePermisoLectura(
            PermisoReglasClima) ||
        PuedeVerReportes;

    private bool PuedeVerParametrizacionAcceso =>
        AuthState.TienePermisoLectura(
            PermisosWeb.ParametrizacionAcceso) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.Propietarios) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.UsuarioPropietario) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.AsignacionTerreno) ||
        AuthState.TienePermisoLectura(
            PermisosWeb.CoberturaTerritorial);

    private bool EsRutaMapaNacional =>
        ObtenerRutaActual().Equals(
            "mapa",
            StringComparison.OrdinalIgnoreCase);

    private bool EsRutaPortalPropietario =>
        ObtenerRutaActual()
            .StartsWith(
                "mi-portal",
                StringComparison.OrdinalIgnoreCase);

    private bool EsInicioPortalPropietario =>
        ObtenerRutaActual().Equals(
            "mi-portal",
            StringComparison.OrdinalIgnoreCase);

    private bool EsRutaCentroPropietario =>
        ObtenerRutaActual().Equals(
            "mi-portal/centro-geoespacial",
            StringComparison.OrdinalIgnoreCase);

    private bool EsRutaClimaLabores =>
        ObtenerRutaActual().Equals(
            "mi-portal/clima-labores",
            StringComparison.OrdinalIgnoreCase);

    private bool EsRutaReglasClima =>
        ObtenerRutaActual().Equals(
            "configuracion/reglas-clima",
            StringComparison.OrdinalIgnoreCase);

    private bool PuedeMostrarContenidoActual
    {
        get
        {
            if (!TieneAccesoPortalWeb)
                return false;

            if (EsPortalPropietarioExclusivo)
                return EsRutaPortalPropietario;

            if (EsRutaPortalPropietario &&
                !TienePortalPropietario)
            {
                return false;
            }

            if ((EsRutaCentroPropietario ||
                 EsRutaClimaLabores) &&
                tieneTerrenosPropios == false)
            {
                return false;
            }

            if (EsRutaReglasClima &&
                !PuedeAdministrarReglasClima)
            {
                return false;
            }

            return true;
        }
    }

    protected override void OnInitialized()
    {
        Navigation.LocationChanged +=
            Navigation_LocationChanged;
    }

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (firstRender &&
            AuthState.IsAuthenticated &&
            TienePortalPropietario)
        {
            await CargarEstadoPortalPropietarioAsync();
        }

        await AplicarProteccionDeRutasAsync();

        if (AuthState.IsAuthenticated &&
            TieneAccesoPortalWeb &&
            !monitorInactividadActivo)
        {
            referenciaDotNet ??=
                DotNetObjectReference.Create(this);

            int minutos = Math.Clamp(
                AuthState.Usuario?.MinutosInactividad ?? 15,
                1,
                1440);

            await JS.InvokeVoidAsync(
                "conatradecSessionInactivity.start",
                referenciaDotNet,
                minutos * 60_000);

            monitorInactividadActivo = true;
        }
        else if ((!AuthState.IsAuthenticated ||
                  !TieneAccesoPortalWeb) &&
                 monitorInactividadActivo)
        {
            await DetenerMonitorInactividadAsync();
        }
    }

    private async Task AplicarProteccionDeRutasAsync()
    {
        if (!AuthState.IsAuthenticated ||
            aplicandoProteccion)
        {
            return;
        }

        aplicandoProteccion = true;

        try
        {
            if (!TieneAccesoPortalWeb)
            {
                if (cerrandoPorFaltaPermiso)
                    return;

                cerrandoPorFaltaPermiso = true;

                await DetenerMonitorInactividadAsync();
                await AuthState.CerrarSesionAsync();

                Navigation.NavigateTo(
                    "/login",
                    forceLoad: false,
                    replace: true);

                return;
            }

            if (EsPortalPropietarioExclusivo &&
                !EsRutaPortalPropietario)
            {
                Navigation.NavigateTo(
                    "/mi-portal",
                    forceLoad: false,
                    replace: true);

                return;
            }

            if (EsRutaPortalPropietario &&
                !TienePortalPropietario)
            {
                Navigation.NavigateTo(
                    "/",
                    forceLoad: false,
                    replace: true);

                return;
            }

            if ((EsRutaCentroPropietario ||
                 EsRutaClimaLabores) &&
                tieneTerrenosPropios == false)
            {
                Navigation.NavigateTo(
                    "/mi-portal",
                    forceLoad: false,
                    replace: true);

                return;
            }

            if (EsRutaReglasClima &&
                !PuedeAdministrarReglasClima)
            {
                Navigation.NavigateTo(
                    "/",
                    forceLoad: false,
                    replace: true);
            }
        }
        finally
        {
            aplicandoProteccion = false;
        }
    }

    private async Task CargarEstadoPortalPropietarioAsync()
    {
        if (resumenPortalConsultado ||
            !TienePortalPropietario)
        {
            return;
        }

        resumenPortalConsultado = true;

        try
        {
            PortalPropietarioResumen? resumen =
                await PortalPropietario.ObtenerMiResumenAsync();

            tieneTerrenosPropios =
                resumen?.Vinculado == true &&
                resumen.Terrenos.Count > 0;
        }
        catch (UnauthorizedAccessException)
        {
            tieneTerrenosPropios = null;
        }
        catch (HttpRequestException)
        {
            tieneTerrenosPropios = null;
        }
        catch (TaskCanceledException)
        {
            tieneTerrenosPropios = null;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async void Navigation_LocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await AplicarProteccionDeRutasAsync();
        });
    }

    [JSInvokable]
    public async Task RegistrarActividadNavegadorAsync()
    {
        if (!AuthState.IsAuthenticated ||
            !TieneAccesoPortalWeb)
        {
            return;
        }

        Actividad.RegistrarActividad();

        try
        {
            await ApiClient.GetAsync<object>(
                "api/sesion/validar");
        }
        catch (UnauthorizedAccessException)
        {
        }
        catch (HttpRequestException)
        {
        }
        catch (TaskCanceledException)
        {
        }
    }

    [JSInvokable]
    public async Task CerrarSesionPorInactividadAsync()
    {
        if (!AuthState.IsAuthenticated)
            return;

        await DetenerMonitorInactividadAsync();
        await AuthState.CerrarSesionAsync();

        Navigation.NavigateTo(
            "/login",
            forceLoad: false,
            replace: true);
    }

    private string ObtenerRutaActual()
    {
        string relativa =
            Navigation.ToBaseRelativePath(
                Navigation.Uri);

        int indiceQuery =
            relativa.IndexOfAny(
                ['?', '#']);

        if (indiceQuery >= 0)
            relativa = relativa[..indiceQuery];

        return relativa.Trim('/');
    }

    private void ToggleMenu()
    {
        menuAbierto = !menuAbierto;
    }

    private void CerrarMenuMovil()
    {
        menuAbierto = false;
    }

    private string ObtenerIniciales()
    {
        string? nombre =
            AuthState.Usuario?
                .NombreCompletoUsuario;

        if (string.IsNullOrWhiteSpace(nombre))
            return "U";

        return string.Concat(
            nombre
                .Split(
                    ' ',
                    StringSplitOptions
                        .RemoveEmptyEntries)
                .Take(2)
                .Select(item =>
                    char.ToUpperInvariant(
                        item[0])));
    }

    private async Task CerrarSesionAsync()
    {
        await DetenerMonitorInactividadAsync();
        await AuthState.CerrarSesionAsync();

        Navigation.NavigateTo(
            "/login",
            forceLoad: false);
    }

    private async Task DetenerMonitorInactividadAsync()
    {
        if (!monitorInactividadActivo)
            return;

        try
        {
            await JS.InvokeVoidAsync(
                "conatradecSessionInactivity.stop");
        }
        catch (JSDisconnectedException)
        {
        }

        monitorInactividadActivo = false;
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -=
            Navigation_LocationChanged;

        try
        {
            await DetenerMonitorInactividadAsync();
        }
        catch
        {
        }

        referenciaDotNet?.Dispose();
        referenciaDotNet = null;
    }
}
