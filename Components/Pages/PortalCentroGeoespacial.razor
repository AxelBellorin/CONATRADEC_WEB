    [JSInvokable]
    public async Task SeleccionarDepartamentoMapa(string nombre)
    {
        CatalogoSimple? departamento = departamentos.FirstOrDefault(x =>
            Normalizar(x.Nombre) == Normalizar(nombre));

        if (departamento is null)
            return;

        departamentoId = departamento.Id;
        municipioId = null;
        terrenoIdSeleccionado = 0;
        capasActivas["municipios"] = true;
        await RenderizarMapaAsync(false, true);
    }

    [JSInvokable]
    public async Task SeleccionarMunicipioMapa(
        string municipio,
        string departamento)
    {
        MunicipioSelectorItem? encontrado = municipios.FirstOrDefault(x =>
            Normalizar(x.NombreMunicipio) == Normalizar(municipio) &&
            (string.IsNullOrWhiteSpace(departamento) ||
             Normalizar(x.NombreDepartamento) == Normalizar(departamento)));

        if (encontrado is null)
            return;

        departamentoId = encontrado.DepartamentoId;
