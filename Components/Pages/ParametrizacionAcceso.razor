@page "/parametrizacion-acceso"
@using CONATRADEC.AdminWeb.Models
@using Microsoft.JSInterop
@inject AuthStateService AuthState
@inject ParametrizacionAccesoService Servicio
@inject IJSRuntime JS

<PageTitle>Propietarios y acceso | CONATRADEC</PageTitle>

<div class="access-page-header">
    <div>
        <p class="eyebrow">Parametrización por permisos</p>
        <h1>Propietarios y acceso a terrenos</h1>
        <p>
            Administra propietarios, cuentas del portal, acceso a terrenos
            y coberturas territoriales sin depender del nombre del rol.
        </p>
    </div>

    <button class="btn-primary"
            disabled="@cargando"
            @onclick="CargarTodoAsync">
        <i class="fa-solid fa-rotate @(cargando ? "fa-spin" : string.Empty)"></i>
        Actualizar
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="access-message @(esError ? "error" : "success")">
        <i class="fa-solid @(esError ? "fa-circle-exclamation" : "fa-circle-check")"></i>
        <span>@mensaje</span>
    </div>
}

@if (!PuedeVerModulo)
{
    <div class="access-empty">
        <i class="fa-solid fa-lock"></i>
        <h2>Sin permisos de lectura</h2>
        <p>El usuario no tiene habilitada ninguna parametrización de acceso.</p>
    </div>
}
else
{
    <div class="access-tabs">
        @if (PuedeLeerPropietarios)
        {
            <button class="@ClaseTab("PROPIETARIOS")"
                    @onclick='() => CambiarTab("PROPIETARIOS")'>
                Propietarios
            </button>
        }

        @if (PuedeLeerVinculaciones)
        {
            <button class="@ClaseTab("PORTAL")"
                    @onclick='() => CambiarTab("PORTAL")'>
                Usuarios del portal
            </button>
        }

        @if (PuedeLeerAsignaciones)
        {
            <button class="@ClaseTab("ASIGNACIONES")"
                    @onclick='() => CambiarTab("ASIGNACIONES")'>
                Acceso a terrenos
            </button>
        }

        @if (PuedeLeerCoberturas)
        {
            <button class="@ClaseTab("COBERTURAS")"
                    @onclick='() => CambiarTab("COBERTURAS")'>
                Coberturas
            </button>
        }
    </div>

    @if (tab == "PROPIETARIOS" && PuedeLeerPropietarios)
    {
        <section class="access-grid">
            <article class="access-card">
                <div class="access-card-title">
                    <div>
                        <span>Gestión</span>
                        <h2>
                            @if (!formularioVisible)
                            {
                                <text>Administrar propietarios</text>
                            }
                            else if (formulario.PropietarioId > 0)
                            {
                                <text>Editar propietario</text>
                            }
                            else
                            {
                                <text>Nuevo propietario</text>
                            }
                        </h2>
                    </div>

                    @if (formularioVisible)
                    {
                        <button type="button"
                                class="btn-link"
                                @onclick="CancelarFormulario">
                            Cancelar
                        </button>
                    }
                </div>

                @if (!formularioVisible)
                {
                    <div class="access-empty">
                        <i class="fa-solid fa-address-card"></i>
                        <h3>Seleccione una acción</h3>
                        <p>
                            Use Ver, Editar o Eliminar en el directorio. El clic
                            sobre la tarjeta ya no abre automáticamente la edición.
                        </p>

                        @if (PuedeAgregarPropietarios)
                        {
                            <button type="button"
                                    class="btn-primary"
                                    @onclick="NuevoPropietario">
                                <i class="fa-solid fa-user-plus"></i>
                                Nuevo propietario
                            </button>
                        }
                    </div>
                }
                else
                {
                    <EditForm Model="formulario"
                              OnValidSubmit="GuardarPropietarioAsync">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form-group">
                            <label>Identificación</label>
                            <InputText class="form-control"
                                       @bind-Value="formulario.Identificacion" />
                        </div>

                        <div class="form-group">
                            <label>Nombre completo</label>
                            <InputText class="form-control"
                                       @bind-Value="formulario.NombreCompleto" />
                        </div>

                        <div class="access-two-columns">
                            <div class="form-group">
                                <label>Teléfono</label>
                                <InputText class="form-control"
                                           @bind-Value="formulario.Telefono" />
                            </div>

                            <div class="form-group">
                                <label>Correo</label>
                                <InputText class="form-control"
                                           @bind-Value="formulario.Correo" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Dirección</label>
                            <InputTextArea class="form-control"
                                           @bind-Value="formulario.Direccion" />
                        </div>

                        <div class="access-message success">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>
                                El estado activo no se modifica desde el formulario.
                                La desactivación se realiza únicamente mediante Eliminar.
                            </span>
                        </div>

                        <button class="btn-primary"
                                disabled="@(!PuedeGuardarPropietario || cargando)">
                            <i class="fa-solid fa-floppy-disk"></i>
                            @(formulario.PropietarioId > 0
                                ? "Actualizar"
                                : "Guardar")
                        </button>
                    </EditForm>
                }
            </article>

            <article class="access-card access-list-card">
                <div class="access-card-title">
                    <div>
                        <span>Directorio</span>
                        <h2>Propietarios registrados</h2>
                    </div>
                    <strong>@propietarios.Count</strong>
                </div>

                <div class="access-search">
                    <input class="form-control"
                           placeholder="Buscar por nombre, identificación o correo"
                           @bind="buscarPropietario"
                           @bind:event="oninput" />
                    <button type="button"
                            class="btn-secondary"
                            @onclick="CargarPropietariosAsync">
                        Buscar
                    </button>
                </div>

                <div class="access-list">
                    @foreach (PropietarioAccesoItem item in propietarios)
                    {
                        <div class="access-list-item static">
                            <span class="access-avatar">
                                @Iniciales(item.NombreCompleto)
                            </span>

                            <span>
                                <strong>@item.NombreCompleto</strong>
                                <small>
                                    @item.Identificacion ·
                                    @item.TotalTerrenos terreno(s)
                                </small>
                                <small>
                                    Portal:
                                    @(string.IsNullOrWhiteSpace(item.UsuarioPortal)
                                        ? "Sin usuario"
                                        : item.UsuarioPortal)
                                </small>
                            </span>

                            <div class="access-inline-actions">
                                <button type="button"
                                        class="btn-secondary"
                                        title="Visualizar"
                                        @onclick="() => VerPropietarioAsync(item)">
                                    <i class="fa-solid fa-eye"></i>
                                    Ver
                                </button>

                                @if (PuedeActualizarPropietarios)
                                {
                                    <button type="button"
                                            class="btn-primary"
                                            title="Editar"
                                            @onclick="() => EditarPropietario(item)">
                                        <i class="fa-solid fa-pen"></i>
                                        Editar
                                    </button>
                                }

                                @if (PuedeEliminarPropietarios)
                                {
                                    <button type="button"
                                            class="access-danger-button"
                                            title="Eliminar"
                                            @onclick="() => EliminarPropietarioAsync(item)">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </article>
        </section>

        @if (cargandoDetalle)
        {
            <div class="owner-detail-backdrop">
                <div class="owner-detail-loading">
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    <strong>Cargando propietario...</strong>
                </div>
            </div>
        }

        @if (detalleSeleccionado is not null && !cargandoDetalle)
        {
            <div class="owner-detail-backdrop"
                 @onclick="CerrarDetalle">
                <section class="access-card access-owner-detail owner-detail-modal"
                         @onclick:stopPropagation="true">
                    <div class="access-card-title owner-detail-header">
                        <div>
                            <span>Detalle del propietario</span>
                            <h2>@detalleSeleccionado.Propietario.NombreCompleto</h2>
                            <small>
                                @detalleSeleccionado.Propietario.Identificacion ·
                                @(detalleSeleccionado.Propietario.Correo ?? "Sin correo")
                            </small>
                        </div>

                        <div class="access-inline-actions">
                            @if (PuedeActualizarPropietarios)
                            {
                                <button type="button"
                                        class="btn-primary"
                                        @onclick="EditarPropietarioDesdeDetalle">
                                    <i class="fa-solid fa-pen"></i>
                                    Editar
                                </button>
                            }

                            <button type="button"
                                    class="btn-secondary"
                                    @onclick="CerrarDetalle">
                                <i class="fa-solid fa-xmark"></i>
                                Cerrar
                            </button>
                        </div>
                    </div>

                    <div class="owner-detail-data-grid">
                        <div>
                            <small>Identificación</small>
                            <strong>@detalleSeleccionado.Propietario.Identificacion</strong>
                        </div>
                        <div>
                            <small>Teléfono</small>
                            <strong>@(detalleSeleccionado.Propietario.Telefono ?? "Sin teléfono")</strong>
                        </div>
                        <div>
                            <small>Correo</small>
                            <strong>@(detalleSeleccionado.Propietario.Correo ?? "Sin correo")</strong>
                        </div>
                        <div>
                            <small>Dirección</small>
                            <strong>@(detalleSeleccionado.Propietario.Direccion ?? "Sin dirección")</strong>
                        </div>
                    </div>

                    <div class="owner-detail-section-title">
                        <div>
                            <span>Terrenos vinculados</span>
                            <strong>@detalleSeleccionado.Terrenos.Count</strong>
                        </div>
                    </div>

                    @if (PuedeActualizarPropietarios)
                    {
                        <div class="owner-terrain-linker">
                            <div class="access-picker-section compact">
                                <label>
                                    <i class="fa-solid fa-map-location-dot"></i>
                                    Agregar terreno
                                </label>

                                <div class="access-entity-combobox">
                                    <div class="access-entity-search-box">
                                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                                        <input class="form-control"
                                               type="search"
                                               placeholder="Buscar por código, propietario o dirección"
                                               autocomplete="off"
                                               value="@buscarTerrenoPropietario"
                                               @oninput="BuscarTerrenoPropietarioCambiado" />

                                        @if (!string.IsNullOrWhiteSpace(buscarTerrenoPropietario) || terrenoParaPropietarioId > 0)
                                        {
                                            <button type="button"
                                                    class="access-entity-clear"
                                                    title="Limpiar terreno"
                                                    @onclick="LimpiarTerrenoPropietario">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        }
                                    </div>

                                    <div class="access-entity-options owner-terrain-options" role="listbox" aria-label="Terrenos disponibles">
                                        @if (!TerrenosParaPropietarioFiltrados.Any())
                                        {
                                            <div class="access-entity-no-results">
                                                <i class="fa-solid fa-map-location-dot"></i>
                                                <span>No se encontraron terrenos disponibles.</span>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (TerrenoAccesoCatalogo terreno in TerrenosParaPropietarioFiltrados.Take(20))
                                            {
                                                <button type="button"
                                                        class="access-entity-option @(terreno.TerrenoId == terrenoParaPropietarioId ? "selected" : string.Empty)"
                                                        @onclick="() => SeleccionarTerrenoPropietario(terreno)">
                                                    <span class="access-avatar"><i class="fa-solid fa-map-pin"></i></span>
                                                    <span class="access-entity-option-text">
                                                        <strong>@terreno.CodigoTerreno</strong>
                                                        <small>@terreno.PropietarioActual · @terreno.Direccion</small>
                                                    </span>
                                                    @if (terreno.TerrenoId == terrenoParaPropietarioId)
                                                    {
                                                        <i class="fa-solid fa-check access-entity-selected-icon"></i>
                                                    }
                                                </button>
                                            }

                                            @if (TerrenosParaPropietarioFiltrados.Count() > 20)
                                            {
                                                <div class="access-entity-more-results">
                                                    Mostrando 20 de @TerrenosParaPropietarioFiltrados.Count() coincidencias. Escriba más para refinar la búsqueda.
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                            <button type="button"
                                    class="btn-primary owner-terrain-submit"
                                    @onclick="VincularTerrenoAsync"
                                    disabled="@(terrenoParaPropietarioId <= 0 || !TerrenoPropietarioSeleccionadoVisible)">
                                <i class="fa-solid fa-link"></i>
                                Vincular terreno
                            </button>
                        </div>
                    }

                    @if (detalleSeleccionado.Terrenos.Count == 0)
                    {
                        <div class="owner-detail-empty">
                            <i class="fa-solid fa-map-location-dot"></i>
                            <span>Este propietario no tiene terrenos vinculados.</span>
                        </div>
                    }
                    else
                    {
                        <div class="access-table-wrap owner-detail-table">
                            <table class="access-table">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Dirección</th>
                                        <th>Extensión</th>
                                        <th>Producción</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (TerrenoPropietarioItem terreno
                                              in detalleSeleccionado.Terrenos)
                                    {
                                        <tr>
                                            <td>@terreno.CodigoTerreno</td>
                                            <td>@terreno.DireccionTerreno</td>
                                            <td>@terreno.ExtensionManzanas.ToString("N2") Mz</td>
                                            <td>@terreno.QuintalesOro.ToString("N2") qq</td>
                                            <td>
                                                @if (PuedeEliminarPropietarios)
                                                {
                                                    <button type="button"
                                                            class="access-danger-button"
                                                            title="Desvincular"
                                                            @onclick="() => DesvincularTerrenoAsync(terreno)">
                                                        <i class="fa-solid fa-link-slash"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </section>
            </div>
        }
    }

    @if (tab == "PORTAL" && PuedeLeerVinculaciones)
    {
        <section class="access-card portal-manager">
            <div class="access-card-title coverage-title">
                <div>
                    <span>Representación digital</span>
                    <h2>Usuario del portal y propietario</h2>
                    <p>
                        Seleccione primero una cuenta del portal. Después podrá consultar,
                        vincular o cambiar únicamente el propietario de esa persona.
                    </p>
                </div>
            </div>

            <div class="access-picker-section">
                <label for="portal-user-search">
                    <i class="fa-solid fa-user"></i>
                    Usuario a configurar
                </label>

                <div class="access-entity-combobox">
                    <div class="access-entity-search-box">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <input id="portal-user-search"
                               class="form-control"
                               type="search"
                               placeholder="Buscar por nombre, usuario o correo"
                               autocomplete="off"
                               value="@buscarUsuarioPortal"
                               @oninput="BuscarUsuarioPortalCambiado" />

                        @if (!string.IsNullOrWhiteSpace(buscarUsuarioPortal) || usuarioPortalId > 0)
                        {
                            <button type="button"
                                    class="access-entity-clear"
                                    title="Limpiar selección"
                                    aria-label="Limpiar usuario seleccionado"
                                    @onclick="LimpiarUsuarioPortal">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        }
                    </div>

                    <div class="access-entity-options" role="listbox" aria-label="Usuarios disponibles">
                        @if (!UsuariosPortalFiltrados.Any())
                        {
                            <div class="access-entity-no-results">
                                <i class="fa-solid fa-user-slash"></i>
                                <span>No se encontraron usuarios.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (UsuarioAccesoCatalogo usuario in UsuariosPortalFiltrados.Take(20))
                            {
                                <button type="button"
                                        class="access-entity-option @(usuario.UsuarioId == usuarioPortalId ? "selected" : string.Empty)"
                                        role="option"
                                        aria-selected="@(usuario.UsuarioId == usuarioPortalId)"
                                        @onclick="() => SeleccionarUsuarioPortal(usuario)">
                                    <span class="access-avatar">@Iniciales(usuario.NombreCompletoUsuario)</span>
                                    <span class="access-entity-option-text">
                                        <strong>@usuario.NombreCompletoUsuario</strong>
                                        <small>
                                            @usuario.NombreUsuario
                                            @if (!string.IsNullOrWhiteSpace(usuario.CorreoUsuario))
                                            {
                                                <text> · @usuario.CorreoUsuario</text>
                                            }
                                        </small>
                                    </span>
                                    @if (usuario.UsuarioId == usuarioPortalId)
                                    {
                                        <i class="fa-solid fa-check access-entity-selected-icon"></i>
                                    }
                                </button>
                            }

                            @if (UsuariosPortalFiltrados.Count() > 20)
                            {
                                <div class="access-entity-more-results">
                                    Mostrando 20 de @UsuariosPortalFiltrados.Count() coincidencias. Escriba más para refinar la búsqueda.
                                </div>
                            }
                        }
                    </div>
                </div>

                <small class="access-picker-help">
                    Escriba parte del nombre, usuario o correo para filtrar la lista.
                </small>
            </div>

            @if (usuarioPortalId <= 0)
            {
                <div class="coverage-empty-state">
                    <i class="fa-solid fa-link"></i>
                    <div>
                        <strong>Seleccione un usuario para comenzar</strong>
                        <span>Se mostrará únicamente su relación actual con un propietario.</span>
                    </div>
                </div>
            }
            else if (UsuarioPortalSeleccionado is not null)
            {
                <div class="coverage-user-summary">
                    <span class="access-avatar">@Iniciales(UsuarioPortalSeleccionado.NombreCompletoUsuario)</span>
                    <div>
                        <strong>@UsuarioPortalSeleccionado.NombreCompletoUsuario</strong>
                        <small>@UsuarioPortalSeleccionado.NombreUsuario · @UsuarioPortalSeleccionado.Rol</small>
                    </div>
                    <span class="coverage-count">
                        @(PropietarioUsuarioPortalActual is null ? "Sin propietario" : "Propietario vinculado")
                    </span>
                </div>

                @if (PropietarioUsuarioPortalActual is not null)
                {
                    <div class="access-current-relation">
                        <div>
                            <small>Propietario actual</small>
                            <strong>@PropietarioUsuarioPortalActual.NombreCompleto</strong>
                            <span>@PropietarioUsuarioPortalActual.Identificacion</span>
                        </div>
                        @if (PuedeEliminarVinculacion)
                        {
                            <button type="button"
                                    class="access-danger-link"
                                    @onclick="DesvincularUsuarioPortalActualAsync">
                                <i class="fa-solid fa-user-xmark"></i>
                                Retirar vínculo
                            </button>
                        }
                    </div>
                }

                @if (PuedeGuardarVinculacion)
                {
                    <div class="access-action-card">
                        <div class="coverage-section-heading">
                            <div>
                                <span>@(PropietarioUsuarioPortalActual is null ? "Vinculación" : "Cambio de propietario")</span>
                                <strong>Seleccione un propietario</strong>
                            </div>
                        </div>

                        <div class="access-picker-section compact">
                            <div class="access-entity-combobox">
                                <div class="access-entity-search-box">
                                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                                    <input class="form-control"
                                           type="search"
                                           placeholder="Buscar por nombre, identificación o correo"
                                           autocomplete="off"
                                           value="@buscarPropietarioVinculacion"
                                           @oninput="BuscarPropietarioPortalCambiado" />

                                    @if (!string.IsNullOrWhiteSpace(buscarPropietarioVinculacion) || propietarioPortalId > 0)
                                    {
                                        <button type="button"
                                                class="access-entity-clear"
                                                title="Limpiar selección"
                                                @onclick="LimpiarPropietarioPortal">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    }
                                </div>

                                <div class="access-entity-options" role="listbox" aria-label="Propietarios disponibles">
                                    @if (!PropietariosParaVincular.Any())
                                    {
                                        <div class="access-entity-no-results">
                                            <i class="fa-solid fa-address-card"></i>
                                            <span>No se encontraron propietarios.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (PropietarioAccesoItem propietario in PropietariosParaVincular.Take(20))
                                        {
                                            <button type="button"
                                                    class="access-entity-option @(propietario.PropietarioId == propietarioPortalId ? "selected" : string.Empty)"
                                                    @onclick="() => SeleccionarPropietarioPortal(propietario)">
                                                <span class="access-avatar">@Iniciales(propietario.NombreCompleto)</span>
                                                <span class="access-entity-option-text">
                                                    <strong>@propietario.NombreCompleto</strong>
                                                    <small>
                                                        @propietario.Identificacion · Portal:
                                                        @(string.IsNullOrWhiteSpace(propietario.UsuarioPortal) ? "Sin usuario" : propietario.UsuarioPortal)
                                                    </small>
                                                </span>
                                                @if (propietario.PropietarioId == propietarioPortalId)
                                                {
                                                    <i class="fa-solid fa-check access-entity-selected-icon"></i>
                                                }
                                            </button>
                                        }

                                        @if (PropietariosParaVincular.Count() > 20)
                                        {
                                            <div class="access-entity-more-results">
                                                Mostrando 20 de @PropietariosParaVincular.Count() coincidencias. Escriba más para refinar la búsqueda.
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <button type="button"
                                class="btn-primary access-action-submit"
                                disabled="@(propietarioPortalId <= 0 || !PropietarioSeleccionadoVisible)"
                                @onclick="VincularUsuarioPropietarioAsync">
                            <i class="fa-solid fa-link"></i>
                            @(PropietarioUsuarioPortalActual is null ? "Vincular propietario" : "Cambiar propietario")
                        </button>
                    </div>
                }
            }
        </section>
    }

    @if (tab == "ASIGNACIONES" && PuedeLeerAsignaciones)
    {
        <section class="access-card assignment-manager">
            <div class="access-card-title coverage-title">
                <div>
                    <span>Acceso de propietario</span>
                    <h2>Acceso del propietario a sus terrenos</h2>
                    <p>
                        Seleccione un propietario para definir cuáles de sus terrenos activos
                        estarán habilitados en la cuenta del portal.
                    </p>
                </div>
            </div>

            <div class="access-picker-section">
                <label for="assignment-user-search">
                    <i class="fa-solid fa-user"></i>
                    Propietario a configurar
                </label>

                <div class="access-entity-combobox">
                    <div class="access-entity-search-box">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <input id="assignment-user-search"
                               class="form-control"
                               type="search"
                               placeholder="Buscar propietario por nombre, identificación, correo o usuario"
                               autocomplete="off"
                               value="@buscarUsuarioAsignacion"
                               @oninput="BuscarUsuarioAsignacionCambiado" />

                        @if (!string.IsNullOrWhiteSpace(buscarUsuarioAsignacion) || usuarioAsignacionSeleccionadoId > 0)
                        {
                            <button type="button"
                                    class="access-entity-clear"
                                    title="Limpiar selección"
                                    @onclick="LimpiarUsuarioAsignacionAsync">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        }
                    </div>

                    <div class="access-entity-options" role="listbox" aria-label="Usuarios disponibles">
                        @if (!UsuariosAsignacionFiltrados.Any())
                        {
                            <div class="access-entity-no-results">
                                <i class="fa-solid fa-user-slash"></i>
                                <span>No se encontraron propietarios con usuario vinculado.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (UsuarioAccesoCatalogo usuario in UsuariosAsignacionFiltrados.Take(20))
                            {
                                PropietarioAccesoItem? propietarioOpcion =
                                    ObtenerPropietarioAsignacion(usuario.UsuarioId);

                                <button type="button"
                                        class="access-entity-option @(usuario.UsuarioId == usuarioAsignacionSeleccionadoId ? "selected" : string.Empty)"
                                        @onclick="() => SeleccionarUsuarioAsignacionAsync(usuario)">
                                    <span class="access-avatar">@Iniciales(propietarioOpcion?.NombreCompleto ?? usuario.NombreCompletoUsuario)</span>
                                    <span class="access-entity-option-text">
                                        <strong>@(propietarioOpcion?.NombreCompleto ?? usuario.NombreCompletoUsuario)</strong>
                                        <small>
                                            @if (!string.IsNullOrWhiteSpace(propietarioOpcion?.Identificacion))
                                            {
                                                <text>@propietarioOpcion.Identificacion · </text>
                                            }
                                            Portal: @usuario.NombreUsuario
                                            @if (!string.IsNullOrWhiteSpace(usuario.CorreoUsuario))
                                            {
                                                <text> · @usuario.CorreoUsuario</text>
                                            }
                                        </small>
                                    </span>
                                    @if (usuario.UsuarioId == usuarioAsignacionSeleccionadoId)
                                    {
                                        <i class="fa-solid fa-check access-entity-selected-icon"></i>
                                    }
                                </button>
                            }

                            @if (UsuariosAsignacionFiltrados.Count() > 20)
                            {
                                <div class="access-entity-more-results">
                                    Mostrando 20 de @UsuariosAsignacionFiltrados.Count() coincidencias. Escriba más para refinar la búsqueda.
                                </div>
                            }
                        }
                    </div>
                </div>

                <small class="access-picker-help">
                    Busque por los datos del propietario o por su cuenta del portal vinculada.
                </small>
            </div>

            @if (usuarioAsignacionSeleccionadoId <= 0)
            {
                <div class="coverage-empty-state">
                    <i class="fa-solid fa-list-check"></i>
                    <div>
                        <strong>Seleccione un propietario para comenzar</strong>
                        <span>Se cargarán únicamente los terrenos asociados a su propietario.</span>
                    </div>
                </div>
            }
            else if (cargandoAsignacionesUsuario)
            {
                <div class="coverage-empty-state">
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    <div>
                        <strong>Cargando terrenos...</strong>
                        <span>Consultando los terrenos de este propietario.</span>
                    </div>
                </div>
            }
            else
            {
                @if (UsuarioAsignacionSeleccionado is not null)
                {
                    PropietarioAccesoItem? propietarioSeleccionado =
                        ObtenerPropietarioAsignacion(UsuarioAsignacionSeleccionado.UsuarioId);

                    <div class="coverage-user-summary">
                        <span class="access-avatar">@Iniciales(propietarioSeleccionado?.NombreCompleto ?? UsuarioAsignacionSeleccionado.NombreCompletoUsuario)</span>
                        <div>
                            <strong>@(propietarioSeleccionado?.NombreCompleto ?? PropietarioUsuarioAsignacion?.Propietario ?? "Propietario")</strong>
                            <small>
                                Portal: @UsuarioAsignacionSeleccionado.NombreUsuario
                                @if (!string.IsNullOrWhiteSpace(propietarioSeleccionado?.Identificacion))
                                {
                                    <text> · @propietarioSeleccionado.Identificacion</text>
                                }
                            </small>
                        </div>
                        <span class="coverage-count">@TotalTerrenosPropietario terreno(s) activo(s)</span>
                    </div>

                    <div class="assignment-status-grid" aria-label="Resumen de acceso a terrenos">
                        <div class="assignment-status-card">
                            <span>Terrenos activos</span>
                            <strong>@TotalTerrenosPropietario</strong>
                            <small>Vinculados actualmente al propietario.</small>
                        </div>
                        <div class="assignment-status-card enabled">
                            <span>Habilitados en portal</span>
                            <strong>@asignaciones.Count</strong>
                            <small>Terrenos que esta cuenta ya puede consultar.</small>
                        </div>
                        <div class="assignment-status-card pending">
                            <span>Disponibles para habilitar</span>
                            <strong>@TotalTerrenosDisponibles</strong>
                            <small>Terrenos activos que aún no están habilitados.</small>
                        </div>
                    </div>
                }

                @if (PuedeAgregarAsignaciones)
                {
                    <div class="access-action-card">
                        <div class="coverage-section-heading">
                            <div>
                                <span>Habilitar acceso</span>
                                <strong>Seleccione un terreno que todavía no esté habilitado en el portal</strong>
                            </div>
                        </div>

                        <div class="access-picker-section compact">
                            <div class="access-entity-combobox">
                                <div class="access-entity-search-box">
                                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                                    <input class="form-control"
                                           type="search"
                                           placeholder="Buscar entre los terrenos disponibles por código o dirección"
                                           autocomplete="off"
                                           value="@buscarTerrenoAsignacion"
                                           @oninput="BuscarTerrenoAsignacionCambiado" />

                                    @if (!string.IsNullOrWhiteSpace(buscarTerrenoAsignacion) || nuevaAsignacion.TerrenoId > 0)
                                    {
                                        <button type="button"
                                                class="access-entity-clear"
                                                title="Limpiar terreno"
                                                @onclick="LimpiarTerrenoAsignacion">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    }
                                </div>

                                <div class="access-entity-options" role="listbox" aria-label="Terrenos disponibles">
                                    @if (!TerrenosAsignacionFiltrados.Any())
                                    {
                                        <div class="access-entity-no-results">
                                            <i class="fa-solid fa-map-location-dot"></i>
                                            <span>@(TotalTerrenosDisponibles == 0
                                                ? "Todos los terrenos activos del propietario ya están habilitados."
                                                : "No hay terrenos disponibles que coincidan con la búsqueda.")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (TerrenoAccesoCatalogo terreno in TerrenosAsignacionFiltrados.Take(20))
                                        {
                                            <button type="button"
                                                    class="access-entity-option @(terreno.TerrenoId == nuevaAsignacion.TerrenoId ? "selected" : string.Empty)"
                                                    @onclick="() => SeleccionarTerrenoAsignacion(terreno)">
                                                <span class="access-avatar"><i class="fa-solid fa-map-pin"></i></span>
                                                <span class="access-entity-option-text">
                                                    <strong>@terreno.CodigoTerreno</strong>
                                                    <small>@terreno.PropietarioActual · @terreno.Direccion</small>
                                                </span>
                                                @if (terreno.TerrenoId == nuevaAsignacion.TerrenoId)
                                                {
                                                    <i class="fa-solid fa-check access-entity-selected-icon"></i>
                                                }
                                            </button>
                                        }

                                        @if (TerrenosAsignacionFiltrados.Count() > 20)
                                        {
                                            <div class="access-entity-more-results">
                                                Mostrando 20 de @TerrenosAsignacionFiltrados.Count() coincidencias. Escriba más para refinar la búsqueda.
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="assignment-form-grid">
                            <div class="form-group assignment-observation">
                                <label>Observación</label>
                                <input class="form-control"
                                       placeholder="Observación opcional"
                                       @bind="nuevaAsignacion.Observacion" />
                            </div>

                            <button type="button"
                                    class="btn-primary assignment-submit"
                                    disabled="@(nuevaAsignacion.TerrenoId <= 0 || !TerrenoAsignacionSeleccionadoVisible)"
                                    @onclick="CrearAsignacionAsync">
                                <i class="fa-solid fa-key"></i>
                                Habilitar terreno
                            </button>
                        </div>
                    </div>
                }

                <div class="coverage-current-header">
                    <div>
                        <span>Acceso actual</span>
                        <strong>Terrenos habilitados para la cuenta del portal</strong>
                    </div>
                    <b>@asignaciones.Count</b>
                </div>

                @if (asignaciones.Count == 0)
                {
                    <div class="coverage-empty-state compact">
                        <i class="fa-regular fa-map"></i>
                        <div>
                            <strong>Sin terrenos habilitados</strong>
                            <span>La cuenta del portal todavía no tiene acceso a ningún terreno de este propietario.</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="access-table-wrap">
                        <table class="access-table">
                            <thead>
                                <tr>
                                    <th>Terreno</th>
                                    <th>Propietario</th>
                                    <th>Observación</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (AsignacionTerrenoItem item in asignaciones)
                                {
                                    <tr>
                                        <td>@item.CodigoTerreno</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Propietario) ? "—" : item.Propietario)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Observacion) ? "—" : item.Observacion)</td>
                                        <td>
                                            @if (PuedeEliminarAsignaciones)
                                            {
                                                <button type="button"
                                                        class="access-danger-button"
                                                        title="Retirar acceso al terreno"
                                                        @onclick="() => EliminarAsignacionAsync(item)">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    }

    @if (tab == "COBERTURAS" && PuedeLeerCoberturas)
    {
        <section class="access-card coverage-manager">
            <div class="access-card-title coverage-title">
                <div>
                    <span>Alcance de información</span>
                    <h2>Cobertura territorial por usuario</h2>
                    <p>
                        Seleccione una persona para consultar y administrar únicamente
                        sus coberturas activas.
                    </p>
                </div>
            </div>

            <div class="coverage-user-picker">
                <label for="coverage-user-search">
                    <i class="fa-solid fa-user"></i>
                    Usuario a configurar
                </label>

                <div class="coverage-user-combobox">
                    <div class="coverage-user-search-box">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <input id="coverage-user-search"
                               class="form-control"
                               type="search"
                               placeholder="Buscar por nombre, usuario o correo"
                               autocomplete="off"
                               value="@buscarUsuarioCobertura"
                               @oninput="BuscarUsuarioCoberturaCambiado" />

                        @if (!string.IsNullOrWhiteSpace(buscarUsuarioCobertura) ||
                             usuarioCoberturaSeleccionadoId > 0)
                        {
                            <button type="button"
                                    class="coverage-user-clear"
                                    title="Limpiar selección"
                                    aria-label="Limpiar usuario seleccionado"
                                    @onclick="LimpiarUsuarioCoberturaAsync">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        }
                    </div>

                    <div class="coverage-user-options" role="listbox" aria-label="Usuarios disponibles">
                        @if (!UsuariosCoberturaFiltrados.Any())
                        {
                            <div class="coverage-user-no-results">
                                <i class="fa-solid fa-user-slash"></i>
                                <span>No se encontraron usuarios.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (UsuarioAccesoCatalogo usuario in UsuariosCoberturaFiltrados.Take(20))
                            {
                                <button type="button"
                                        class="coverage-user-option @(usuario.UsuarioId == usuarioCoberturaSeleccionadoId ? "selected" : string.Empty)"
                                        role="option"
                                        aria-selected="@(usuario.UsuarioId == usuarioCoberturaSeleccionadoId)"
                                        @onclick="() => SeleccionarUsuarioCoberturaAsync(usuario)">
                                    <span class="access-avatar">
                                        @Iniciales(usuario.NombreCompletoUsuario)
                                    </span>
                                    <span class="coverage-user-option-text">
                                        <strong>@usuario.NombreCompletoUsuario</strong>
                                        <small>
                                            @usuario.NombreUsuario
                                            @if (!string.IsNullOrWhiteSpace(usuario.CorreoUsuario))
                                            {
                                                <text> · @usuario.CorreoUsuario</text>
                                            }
                                        </small>
                                    </span>
                                    @if (usuario.UsuarioId == usuarioCoberturaSeleccionadoId)
                                    {
                                        <i class="fa-solid fa-check coverage-user-selected-icon"></i>
                                    }
                                </button>
                            }

                            @if (UsuariosCoberturaFiltrados.Count() > 20)
                            {
                                <div class="coverage-user-more-results">
                                    Mostrando 20 de @UsuariosCoberturaFiltrados.Count() coincidencias. Escriba más para refinar la búsqueda.
                                </div>
                            }
                        }
                    </div>
                </div>

                <small class="coverage-user-search-help">
                    Escriba parte del nombre, usuario o correo para filtrar la lista.
                </small>
            </div>

            @if (usuarioCoberturaSeleccionadoId <= 0)
            {
                <div class="coverage-empty-state">
                    <i class="fa-solid fa-location-dot"></i>
                    <div>
                        <strong>Seleccione un usuario para comenzar</strong>
                        <span>
                            Al cambiar de usuario se cargarán solamente sus coberturas.
                        </span>
                    </div>
                </div>
            }
            else if (cargandoCoberturasUsuario)
            {
                <div class="coverage-empty-state">
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    <div>
                        <strong>Cargando coberturas...</strong>
                        <span>Consultando el alcance territorial del usuario.</span>
                    </div>
                </div>
            }
            else
            {
                @if (UsuarioCoberturaSeleccionado is not null)
                {
                    <div class="coverage-user-summary">
                        <span class="access-avatar">
                            @Iniciales(UsuarioCoberturaSeleccionado.NombreCompletoUsuario)
                        </span>
                        <div>
                            <strong>@UsuarioCoberturaSeleccionado.NombreCompletoUsuario</strong>
                            <small>
                                @UsuarioCoberturaSeleccionado.NombreUsuario ·
                                @UsuarioCoberturaSeleccionado.Rol
                            </small>
                        </div>
                        <span class="coverage-count">
                            @coberturas.Count cobertura(s)
                        </span>
                    </div>
                }

                @if (PropietarioUsuarioCobertura is not null)
                {
                    <div class="coverage-inline-warning">
                        <i class="fa-solid fa-circle-info"></i>
                        <div>
                            <strong>Este usuario accede como propietario</strong>
                            <span>
                                Está asociado a @PropietarioUsuarioCobertura.NombreCompleto.
                                Para asignarle cobertura territorial primero debe retirar
                                esa vinculación.
                            </span>
                        </div>
                    </div>
                }

                @if (TieneCoberturasDuplicadas)
                {
                    <div class="coverage-inline-warning duplicate">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <div>
                            <strong>Se encontraron coberturas repetidas</strong>
                            <span>
                                Puede retirar las filas marcadas como repetidas. El sistema
                                ya no permitirá crear nuevamente la misma cobertura.
                            </span>
                        </div>
                    </div>
                }

                @if (PuedeAgregarCoberturas && PropietarioUsuarioCobertura is null)
                {
                    <div class="coverage-form-card">
                        <div class="coverage-section-heading">
                            <div>
                                <span>Nueva cobertura</span>
                                <strong>Defina el alcance territorial</strong>
                            </div>
                        </div>

                        <div class="access-form-grid coverage-form-grid">
                            <select class="form-control"
                                    value="@nuevaCobertura.TipoCobertura"
                                    @onchange="TipoCoberturaCambiadoAsync">
                                <option value="NACIONAL">Todo Nicaragua</option>
                                <option value="DEPARTAMENTO">Un departamento</option>
                                <option value="MUNICIPIO">Un municipio</option>
                            </select>

                            @if (nuevaCobertura.TipoCobertura != "NACIONAL")
                            {
                                <select class="form-control"
                                        value="@nuevaCobertura.DepartamentoId"
                                        @onchange="DepartamentoCoberturaCambiadoAsync">
                                    <option value="">Seleccione un departamento</option>
                                    @foreach (DepartamentoAccesoCatalogo departamento in departamentos)
                                    {
                                        <option value="@departamento.DepartamentoId">
                                            @departamento.Nombre
                                        </option>
                                    }
                                </select>
                            }

                            @if (nuevaCobertura.TipoCobertura == "MUNICIPIO")
                            {
                                <select class="form-control"
                                        @bind="nuevaCobertura.MunicipioId">
                                    <option value="">Seleccione un municipio</option>
                                    @foreach (MunicipioAccesoCatalogo municipio in municipios)
                                    {
                                        <option value="@municipio.MunicipioId">
                                            @municipio.Nombre
                                        </option>
                                    }
                                </select>
                            }

                            <input class="form-control"
                                   placeholder="Observación opcional"
                                   @bind="nuevaCobertura.Observacion" />

                            <button type="button"
                                    class="btn-primary coverage-add-button"
                                    disabled="@(!FormularioCoberturaCompleto)"
                                    @onclick="CrearCoberturaAsync">
                                <i class="fa-solid fa-plus"></i>
                                Agregar cobertura
                            </button>
                        </div>
                    </div>
                }

                <div class="coverage-current-header">
                    <div>
                        <span>Coberturas actuales</span>
                        <strong>Alcance autorizado para este usuario</strong>
                    </div>
                    <b>@coberturas.Count</b>
                </div>

                @if (coberturas.Count == 0)
                {
                    <div class="coverage-empty-state compact">
                        <i class="fa-regular fa-map"></i>
                        <div>
                            <strong>Sin cobertura territorial</strong>
                            <span>Este usuario no tiene territorios asignados actualmente.</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="access-table-wrap">
                        <table class="access-table coverage-table">
                            <thead>
                                <tr>
                                    <th>Alcance</th>
                                    <th>Departamento</th>
                                    <th>Municipio</th>
                                    <th>Observación</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (CoberturaTerritorialItem item in coberturas)
                                {
                                    <tr>
                                        <td>
                                            <div class="coverage-scope-cell">
                                                <strong>@NombreTipoCobertura(item.TipoCobertura)</strong>
                                                @if (EsCoberturaDuplicada(item))
                                                {
                                                    <span class="coverage-duplicate-badge">
                                                        Repetida
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                        <td>@(item.Departamento ?? "Todos")</td>
                                        <td>@(item.Municipio ?? "Todos")</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Observacion) ? "—" : item.Observacion)</td>
                                        <td>
                                            @if (PuedeEliminarCoberturas)
                                            {
                                                <button type="button"
                                                        class="access-danger-button"
                                                        title="Retirar cobertura"
                                                        @onclick="() => EliminarCoberturaAsync(item)">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </section>
    }
}


<style>
    .owner-detail-backdrop {
        position: fixed;
        inset: 0;
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(2px);
    }

    .owner-detail-modal {
        width: min(1050px, 96vw);
        max-height: 90vh;
        overflow: auto;
        margin: 0;
        background: #fff;
        box-shadow: 0 24px 70px rgba(15, 23, 42, 0.28);
    }

    .owner-detail-loading {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 1.2rem 1.5rem;
        border-radius: 14px;
        background: #fff;
        color: #315f55;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.24);
    }

    .owner-detail-loading i {
        font-size: 1.4rem;
    }

    .owner-detail-header {
        align-items: flex-start;
        gap: 1rem;
    }

    .owner-detail-data-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
        margin: 1rem 0;
    }

    .owner-detail-data-grid > div {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.9rem 1rem;
        border: 1px solid #dbe7e2;
        border-radius: 12px;
        background: #f8fbfa;
    }

    .owner-detail-data-grid small,
    .owner-detail-section-title span {
        color: #64748b;
        font-size: 0.78rem;
    }

    .owner-detail-section-title {
        margin: 1rem 0 0.7rem;
    }

    .owner-detail-section-title > div {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .owner-detail-section-title strong {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        height: 32px;
        border-radius: 999px;
        background: #315f55;
        color: #fff;
    }

    .owner-detail-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
