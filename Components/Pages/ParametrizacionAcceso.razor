    }

    private async Task CargarPropietariosAsync()
    {
        try
        {
            Task<List<PropietarioAccesoItem>?> filtradosTask =
                Servicio.ListarPropietariosAsync(
                    buscarPropietario,
                    incluirInactivos: false);

            Task<List<PropietarioAccesoItem>?> catalogoTask =
                string.IsNullOrWhiteSpace(buscarPropietario)
                    ? filtradosTask
                    : Servicio.ListarPropietariosAsync(
                        incluirInactivos: false);

            await Task.WhenAll(filtradosTask, catalogoTask);

            propietarios = filtradosTask.Result ?? [];
            propietariosCatalogo = catalogoTask.Result ?? [];
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task CargarUsuariosPropietariosAsignacionAsync()
    {
        if (!PuedeLeerAsignaciones)
        {
            usuariosPropietariosAsignacion = [];
            return;
        }

        usuariosPropietariosAsignacion =
            await Servicio.ListarUsuariosPropietariosAsignacionAsync() ?? [];

        if (usuarioAsignacionSeleccionadoId > 0 &&
            !usuariosPropietariosAsignacion.Any(
                item => item.UsuarioId == usuarioAsignacionSeleccionadoId))
        {
            await LimpiarUsuarioAsignacionAsync();
        }
    }

    private void NuevoPropietario()
    {
        if (!PuedeAgregarPropietarios)
            return;

        formulario = new PropietarioAccesoFormulario
        {
            Activo = true
        };

        formularioVisible = true;
        detalleSeleccionado = null;
        terrenoParaPropietarioId = 0;
        buscarTerrenoPropietario = string.Empty;
        LimpiarMensaje();
    }

    private void EditarPropietario(PropietarioAccesoItem item)
    {
        if (!PuedeActualizarPropietarios)
            return;

        detalleSeleccionado = null;
        terrenoParaPropietarioId = 0;
        buscarTerrenoPropietario = string.Empty;
        formulario = CrearFormulario(item);
        formularioVisible = true;
        LimpiarMensaje();
    }

    private void EditarPropietarioDesdeDetalle()
    {
        if (detalleSeleccionado is null)
            return;

        PropietarioAccesoItem propietario =
            detalleSeleccionado.Propietario;

        EditarPropietario(propietario);
    }

    private async Task VerPropietarioAsync(PropietarioAccesoItem item)
    {
        formularioVisible = false;
        formulario = new();
        detalleSeleccionado = null;
        terrenoParaPropietarioId = 0;
        buscarTerrenoPropietario = string.Empty;
        cargandoDetalle = true;
        LimpiarMensaje();

        try
        {
            PropietarioDetalleRespuesta? detalle =
                await Servicio.ObtenerPropietarioAsync(
                    item.PropietarioId);

            if (detalle is null)
            {
                MostrarError(
                    "No fue posible cargar el detalle del propietario.");
                return;
            }

            detalleSeleccionado = detalle;
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
        finally
        {
            cargandoDetalle = false;
        }
    }

    private async Task GuardarPropietarioAsync()
    {
        if (!PuedeGuardarPropietario)
            return;

        cargando = true;
        LimpiarMensaje();

        try
        {
            /*
             * Activo no es un campo administrable desde la interfaz.
             * Crear y editar conservan el registro activo.
             */
            formulario.Activo = true;

            ApiOperacionAccesoRespuesta? respuesta =
                formulario.PropietarioId > 0
                    ? await Servicio.ActualizarPropietarioAsync(formulario)
                    : await Servicio.CrearPropietarioAsync(formulario);

            if (respuesta?.Success == false)
            {
                MostrarError(respuesta.Message);
                return;
            }

            MostrarExito(
                respuesta?.Message ??
                "Operación realizada correctamente.");

            CancelarFormulario();
            await CargarPropietariosAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task EliminarPropietarioAsync(PropietarioAccesoItem item)
    {
        if (!PuedeEliminarPropietarios)
            return;

        if (item.TotalTerrenos > 0)
        {
            await VerPropietarioAsync(item);

            MostrarError(
                "No se puede eliminar el propietario porque tiene terrenos " +
                "vinculados. Reasigne los terrenos a otro propietario antes " +
                "de continuar.");

            return;
        }

        bool confirmar =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"¿Desea eliminar a {item.NombreCompleto}? " +
                "El registro se desactivará y su historial se conservará.");

        if (!confirmar)
            return;

        cargando = true;
        LimpiarMensaje();

        try
        {
            await Servicio.EliminarPropietarioAsync(item.PropietarioId);

            if (detalleSeleccionado?.Propietario.PropietarioId ==
                item.PropietarioId)
            {
                detalleSeleccionado = null;
            }

            propietarios.RemoveAll(x =>
                x.PropietarioId == item.PropietarioId);

            MostrarExito("Propietario eliminado correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task VincularTerrenoAsync()
    {
        if (detalleSeleccionado is null ||
            terrenoParaPropietarioId <= 0)
        {
            return;
        }

        try
        {
            await Servicio.VincularTerrenoAsync(
                detalleSeleccionado.Propietario.PropietarioId,
                terrenoParaPropietarioId);

            detalleSeleccionado =
                await Servicio.ObtenerPropietarioAsync(
                    detalleSeleccionado.Propietario.PropietarioId);

            terrenoParaPropietarioId = 0;
            buscarTerrenoPropietario = string.Empty;
            MostrarExito("Terreno vinculado correctamente.");
            await CargarPropietariosAsync();

            if (PropietarioUsuarioAsignacion?.PropietarioId ==
                detalleSeleccionado?.Propietario.PropietarioId)
            {
                await CargarAsignacionesUsuarioAsync();
            }
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task DesvincularTerrenoAsync(
        TerrenoPropietarioItem terreno)
    {
        if (detalleSeleccionado is null)
            return;

        try
        {
            int propietarioId =
                detalleSeleccionado.Propietario.PropietarioId;

            await Servicio.DesvincularTerrenoAsync(
                propietarioId,
                terreno.TerrenoId);

            detalleSeleccionado =
                await Servicio.ObtenerPropietarioAsync(propietarioId);

            MostrarExito("Terreno desvinculado correctamente.");
            await CargarPropietariosAsync();

            if (PropietarioUsuarioAsignacion?.PropietarioId == propietarioId)
                await CargarAsignacionesUsuarioAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private IEnumerable<UsuarioAccesoCatalogo> FiltrarUsuarios(string filtro)
    {
        IEnumerable<UsuarioAccesoCatalogo> consulta = usuarios;
        string texto = filtro.Trim();

        if (!string.IsNullOrWhiteSpace(texto))
        {
            consulta = consulta.Where(item =>
                ContieneTexto(item.NombreCompletoUsuario, texto) ||
                ContieneTexto(item.NombreUsuario, texto) ||
                ContieneTexto(item.CorreoUsuario, texto) ||
                ContieneTexto(TextoUsuario(item), texto));
        }

        return consulta
            .OrderBy(item => item.NombreCompletoUsuario)
            .ThenBy(item => item.NombreUsuario);
    }

    private IEnumerable<TerrenoAccesoCatalogo> FiltrarTerrenos(string filtro)
    {
        IEnumerable<TerrenoAccesoCatalogo> consulta = terrenos;
        string texto = filtro.Trim();

        if (!string.IsNullOrWhiteSpace(texto))
        {
            consulta = consulta.Where(item =>
                ContieneTexto(item.CodigoTerreno, texto) ||
                ContieneTexto(item.PropietarioActual, texto) ||
                ContieneTexto(item.Direccion, texto) ||
                ContieneTexto(TextoTerreno(item), texto));
        }

        return consulta
            .OrderBy(item => item.CodigoTerreno)
            .ThenBy(item => item.PropietarioActual);
    }

    private static bool ContieneTexto(string? valor, string filtro) =>
        !string.IsNullOrWhiteSpace(valor) &&
        valor.Contains(filtro, StringComparison.OrdinalIgnoreCase);

    private static string TextoUsuario(UsuarioAccesoCatalogo usuario) =>
        string.IsNullOrWhiteSpace(usuario.NombreUsuario)
            ? usuario.NombreCompletoUsuario
            : $"{usuario.NombreCompletoUsuario} ({usuario.NombreUsuario})";

    private PropietarioAccesoItem? ObtenerPropietarioAsignacion(int usuarioId)
    {
        UsuarioPropietarioAsignacionCatalogo? relacion =
            usuariosPropietariosAsignacion.FirstOrDefault(
                item => item.UsuarioId == usuarioId);

        if (relacion is null)
            return null;

        return propietariosCatalogo.FirstOrDefault(
            item => item.PropietarioId == relacion.PropietarioId);
    }

    private string TextoUsuarioAsignacion(UsuarioAccesoCatalogo usuario)
    {
        PropietarioAccesoItem? propietario =
            ObtenerPropietarioAsignacion(usuario.UsuarioId);

        if (propietario is null)
            return TextoUsuario(usuario);

        return string.IsNullOrWhiteSpace(usuario.NombreUsuario)
            ? propietario.NombreCompleto
            : $"{propietario.NombreCompleto} ({usuario.NombreUsuario})";
    }

    private static string TextoPropietario(PropietarioAccesoItem propietario) =>
        $"{propietario.NombreCompleto} · {propietario.Identificacion}";

    private static string TextoTerreno(TerrenoAccesoCatalogo terreno) =>
        string.IsNullOrWhiteSpace(terreno.PropietarioActual)
            ? terreno.CodigoTerreno
            : $"{terreno.CodigoTerreno} · {terreno.PropietarioActual}";

