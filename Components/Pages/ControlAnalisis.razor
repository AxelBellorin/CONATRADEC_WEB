        {
            cargandoPdf = false;
        }
    }

    private void CerrarPdf()
    {
        mostrandoPdf = false;
        pdfDataUri = null;
    }

    private void AbrirAccion(AuditoriaAnalisisItem item, bool recuperar)
    {
        itemAccion = item;
        accionRecuperar = recuperar;
        motivoAccion = string.Empty;
        mostrandoAccion = true;
    }

    private void AbrirAccionDesdeDetalle(bool recuperar)
    {
        if (detalle is null)
            return;

        itemAccion = new AuditoriaAnalisisItem
        {
            AnalisisSueloId = detalle.Resumen.AnalisisSueloId,
            AnalisisSueloCalculoId = detalle.Resumen.AnalisisSueloCalculoId,
            Identificador = detalle.Resumen.Identificador,
            Activo = detalle.Resumen.Activo
        };
        accionRecuperar = recuperar;
        motivoAccion = string.Empty;
        mostrandoAccion = true;
    }

    private void CerrarAccion()
    {
        if (procesandoAccion)
            return;

        mostrandoAccion = false;
        itemAccion = null;
        motivoAccion = string.Empty;
    }

    private async Task ConfirmarAccion()
    {
        if (itemAccion is null || motivoAccion.Trim().Length < 5)
            return;

        procesandoAccion = true;
        error = null;

        try
        {
            if (accionRecuperar)
                await ControlService.RecuperarAsync(itemAccion.AnalisisSueloId, motivoAccion.Trim());
            else
                await ControlService.EliminarAsync(itemAccion.AnalisisSueloId, motivoAccion.Trim());

            mostrandoAccion = false;
            mostrandoDetalle = false;
            itemAccion = null;
            detalle = null;
            motivoAccion = string.Empty;
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesandoAccion = false;
        }
    }

    private static string FechaLocal(DateTime fecha) =>
        fecha.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt");

    private static string FechaUtcLocal(DateTime fechaUtc) =>
        DateTime.SpecifyKind(fechaUtc, DateTimeKind.Utc)
            .ToLocalTime()
            .ToString("dd/MM/yyyy hh:mm:ss tt");

    private static string FechaUtcLocal(DateTime? fechaUtc) =>
        fechaUtc.HasValue ? FechaUtcLocal(fechaUtc.Value) : "—";

    private static string Numero(decimal? valor) =>
        valor.HasValue ? valor.Value.ToString("N4") : "—";

    private static string ClaseEstado(string estado) =>
        estado.ToUpperInvariant() switch
        {
            "CORRECTO" => "correct",
            "ACTIVO" => "correct",
            "INACTIVO" => "inactive",
            "INCONSISTENTE" => "inconsistent",
            _ => "neutral"
        };

    private static string NombreEstado(string estado) =>
        estado.ToUpperInvariant() switch
        {
            "CORRECTO" => "Correcto",
            "ACTIVO" => "Activo",
            "INACTIVO" => "Inactivo",
            "INCONSISTENTE" => "Inconsistente",
            _ => estado
        };

    private static string DescripcionFormula(AuditoriaFormula? formula) =>
        formula is null
            ? "No calculada"
            : $"{formula.NombreFormula} · {formula.MezclaTotalQq:N2} qq";

    private static string DescripcionEnmienda(AuditoriaEnmienda? enmienda) =>
        enmienda is null
            ? "No calculada"
            : $"{enmienda.NecesidadEncaladoLbMz:N2} lb/mz";

    private static string DescripcionMixta(AuditoriaMixta? mixta) =>
        mixta is null
            ? "No calculada"
            : $"{mixta.CantidadFuentes} fuentes · {mixta.CantidadDetalles} aportes";

    private static string IconoOperacion(string operacion) =>
        operacion.ToUpperInvariant() switch
        {
            "CREAR" => "fa-plus",
            "ACTUALIZAR" => "fa-pen",
            "ELIMINAR" => "fa-trash",
            _ => "fa-clock-rotate-left"
        };

    private static string NombreOperacion(string operacion) =>
        operacion.ToUpperInvariant() switch
        {
            "CREAR" => "Creación",
            "ACTUALIZAR" => "Actualización",
            "ELIMINAR" => "Eliminación",
            _ => operacion
        };

    private static string NombreActor(AuditoriaHistorialItem evento) =>
        string.IsNullOrWhiteSpace(evento.UsuarioNombre)
            ? evento.UsuarioId.HasValue
                ? $"Usuario #{evento.UsuarioId}"
                : "Sistema"
            : evento.UsuarioNombre;
}
