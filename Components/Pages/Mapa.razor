    private IEnumerable<IGrouping<string, MapaCapaDisponible>> CapasAgrupadas =>
        CapasDisponibles
            .OrderBy(item => item.Orden)
            .GroupBy(item => item.Categoria)
            .OrderBy(grupo => OrdenCategoria(grupo.Key));

    private IEnumerable<IGrouping<string, MapaCapaDisponible>> CapasDelPanel =>
        CapasAgrupadas.Where(grupo =>
            panelFiltroActivo switch
            {
                "TERRITORIO" => CategoriaEs(grupo.Key, "BASE"),
                "SUELO" => CategoriaEs(grupo.Key, "SUELOS"),
                "CLIMA" => CategoriaEs(grupo.Key, "CLIMA"),
                _ => !CategoriaEs(grupo.Key, "BASE") &&
                     !CategoriaEs(grupo.Key, "SUELOS") &&
                     !CategoriaEs(grupo.Key, "CLIMA")
            });

