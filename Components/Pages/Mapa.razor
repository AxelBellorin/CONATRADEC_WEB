    [JSInvokable]
    public async Task SeleccionarDepartamentoMapa(string nombre)
    {
        CatalogoSimple? departamento = departamentos.FirstOrDefault(item =>
            NormalizarTexto(item.Nombre) == NormalizarTexto(nombre));

        if (departamento is null)
            return;

        filtro.DepartamentoId = departamento.Id;
        filtro.MunicipioId = null;
        capasActivas["municipios"] = true;
        panelControlesAbierto = false;

        await CargarMapaAsync();
    }

    [JSInvokable]
    public async Task SeleccionarMunicipioMapa(
        string municipio,
        string departamento)
    {
        MunicipioSelectorItem? encontrado = municipios.FirstOrDefault(item =>
            NormalizarTexto(item.NombreMunicipio) ==
                NormalizarTexto(municipio) &&
            (string.IsNullOrWhiteSpace(departamento) ||
             NormalizarTexto(item.NombreDepartamento) ==
                NormalizarTexto(departamento)));

        if (encontrado is null)
            return;

        filtro.DepartamentoId = encontrado.DepartamentoId;
        filtro.MunicipioId = encontrado.MunicipioId;
        capasActivas["municipios"] = true;
        panelControlesAbierto = false;

        await CargarMapaAsync();
    }

