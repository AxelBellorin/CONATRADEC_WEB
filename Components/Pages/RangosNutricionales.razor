    private async Task CerrarFormularioAsync()
    {
        if (procesando)
            return;

        if (modoFormulario != "ver" &&
            HayCambios())
        {
            bool salir =
                await JS.InvokeAsync<bool>(
                    "confirm",
                    "Hay cambios sin guardar. ¿Desea cerrar el formulario?");

            if (!salir)
                return;
        }

        mostrarFormulario = false;
        itemVista = null;
        formulario = new RangoNutrienteFormModel();
        elementosDisponibles.Clear();
        errorFormulario = null;
    }

    private async Task GuardarAsync()
    {
        if (procesando ||
            cultivoSeleccionado is null)
        {
            return;
        }

        errorFormulario = null;

        formulario.TipoCultivoId =
            cultivoSeleccionado.TipoCultivoId;

        formulario.UnidadBase =
            "lb/Mz";

        formulario.DescripcionParametro =
            (formulario.DescripcionParametro ??
             string.Empty)
            .ReplaceLineEndings(" ")
            .Trim();

        if (formulario.ElementoQuimicosId <= 0)
        {
            errorFormulario =
                "Seleccione un elemento químico.";
            return;
        }

        if (formulario.ValorMinimo <= 0)
        {
            errorFormulario =
                "El valor mínimo debe ser mayor que cero.";
            return;
        }

        if (formulario.ValorMaximo <=
            formulario.ValorMinimo)
        {
            errorFormulario =
                "El valor máximo debe ser mayor que el mínimo.";
            return;
        }

        if (string.IsNullOrWhiteSpace(
                formulario.DescripcionParametro))
        {
            errorFormulario =
                "Ingrese una descripción.";
            return;
        }

        if (modoFormulario == "editar" &&
            !HayCambios())
        {
            errorFormulario =
                "No hay cambios para guardar.";
            return;
        }

        bool confirmar =
            await JS.InvokeAsync<bool>(
                "confirm",
                modoFormulario == "editar"
                    ? "¿Desea actualizar este rango nutricional?"
                    : "¿Desea crear este rango nutricional?");

        if (!confirmar)
            return;

        procesando = true;
        LimpiarMensajes();

        try
        {
            RangoMutationResponseModel? respuesta;

            if (modoFormulario == "editar")
            {
                respuesta =
                    await Api.PutAsync<
                        RangoNutrienteFormModel,
                        RangoMutationResponseModel>(
                        "api/configuracion/rangos-nutrientes/" +
                        formulario
                            .ParametroRangoNutrienteCultivoId,
                        formulario,
                        cancellation.Token);
            }
            else
            {
                /*
                 * El backend reactiva automáticamente el registro histórico
                 * cuando existe la misma combinación cultivo-elemento
                 * eliminada.
                 */
                respuesta =
                    await Api.PostAsync<
                        RangoNutrienteFormModel,
                        RangoMutationResponseModel>(
                        "api/configuracion/rangos-nutrientes",
                        formulario,
                        cancellation.Token);
            }

            mostrarFormulario = false;

            await CargarRangosAsync(
                modoFormulario == "crear"
                    ? 1
                    : rangos.PaginaActual);

            await ActualizarConteoCultivoSeleccionadoAsync();

            mensaje =
                respuesta?.Mensaje ??
                "Rango nutricional guardado correctamente.";
        }
        catch (Exception ex)
        {
            errorFormulario = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task EliminarAsync(
        RangoNutrienteItemModel item)
    {
        bool confirmar =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"¿Desea desactivar el rango de " +
                $"\"{item.ElementoMostrar}\"?");

        if (!confirmar)
            return;

        procesando = true;
        LimpiarMensajes();

        try
        {
            await Api.PutSinContenidoAsync(
                "api/configuracion/rangos-nutrientes/" +
                $"{item.ParametroRangoNutrienteCultivoId}/eliminar",
                cancellationToken:
                    cancellation.Token);

            await CargarRangosAsync(
                rangos.PaginaActual);

            if (rangos.Items.Count == 0 &&
                rangos.PaginaActual > 1)
            {
                await CargarRangosAsync(
                    rangos.PaginaActual - 1);
            }

            await ActualizarConteoCultivoSeleccionadoAsync();

            mensaje =
                "Rango nutricional desactivado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task ActualizarConteoCultivoSeleccionadoAsync()
    {
        if (cultivoSeleccionado is null)
            return;

        cultivoSeleccionado.CantidadAportes =
            rangos.TotalRegistros;

        RangoCultivoResumenModel? cultivoPagina =
            cultivos.Items.FirstOrDefault(item =>
                item.TipoCultivoId ==
                cultivoSeleccionado.TipoCultivoId);

        if (cultivoPagina is not null)
        {
            cultivoPagina.CantidadAportes =
                rangos.TotalRegistros;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task AbrirEliminadosAsync()
    {
        mostrarEliminados = true;
        buscarEliminado = string.Empty;
        cargandoEliminados = true;
        LimpiarMensajes();

        try
        {
            RangoCatalogoResponseModel<
                List<RangoEliminadoItemModel>>? respuesta =
                    await Api.GetAsync<
                        RangoCatalogoResponseModel<
                            List<RangoEliminadoItemModel>>>(
                        $"api/catalogos-eliminados/{CodigoEliminados}",
                        AuthState.CrearEncabezadosSesion(),
                        cancellation.Token);

            eliminados.Clear();

            if (respuesta?.Data is not null)
                eliminados.AddRange(respuesta.Data);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargandoEliminados = false;
        }
    }

    private void CerrarEliminados()
    {
        if (procesando)
            return;

        mostrarEliminados = false;
        eliminados.Clear();
    }

    private async Task ReactivarAsync(
        RangoEliminadoItemModel item)
    {
        bool confirmar =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"¿Desea reactivar \"{item.Titulo}\"?");

        if (!confirmar)
            return;

        procesando = true;
        LimpiarMensajes();

        try
        {
            await Api.PutSinContenidoAsync(
                $"api/catalogos-eliminados/{CodigoEliminados}/" +
                $"{item.Id}/reactivar",
                AuthState.CrearEncabezadosSesion(),
                cancellation.Token);

            eliminados.Remove(item);

            await CargarRangosAsync(1);
            await ActualizarConteoCultivoSeleccionadoAsync();

            mensaje =
                "Rango nutricional reactivado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private bool HayCambios() =>
        formulario.ElementoQuimicosId !=
            original.ElementoQuimicosId ||
        formulario.ValorMinimo !=
            original.ValorMinimo ||
        formulario.ValorMaximo !=
            original.ValorMaximo ||
        !string.Equals(
            formulario.DescripcionParametro.Trim(),
            original.DescripcionParametro.Trim(),
            StringComparison.Ordinal);

    private static RangoNutrienteFormModel CrearFormulario(
        RangoNutrienteItemModel item) =>
        new()
        {
            ParametroRangoNutrienteCultivoId =
                item.ParametroRangoNutrienteCultivoId,

            TipoCultivoId =
                item.TipoCultivoId,

            ElementoQuimicosId =
                item.ElementoQuimicosId,

            ValorMinimo =
                item.ValorMinimo,

            ValorMaximo =
                item.ValorMaximo,

            UnidadBase =
                "lb/Mz",

            DescripcionParametro =
                item.DescripcionParametro
        };

    private bool HayCambiosCultivo() =>
        !string.Equals(
            formularioCultivo.NombreTipoCultivo.Trim(),
            cultivoOriginal.NombreTipoCultivo.Trim(),
            StringComparison.OrdinalIgnoreCase) ||
        !string.Equals(
            formularioCultivo.DescripcionTipoCultivo.Trim(),
            cultivoOriginal.DescripcionTipoCultivo.Trim(),
            StringComparison.Ordinal);

    private static RangoCultivoFormModel CopiarCultivo(
        RangoCultivoFormModel valor) =>
        new()
        {
            NombreTipoCultivo =
                valor.NombreTipoCultivo,

            DescripcionTipoCultivo =
                valor.DescripcionTipoCultivo
        };

    private static RangoNutrienteFormModel Copiar(
        RangoNutrienteFormModel valor) =>
        new()
        {
            ParametroRangoNutrienteCultivoId =
                valor.ParametroRangoNutrienteCultivoId,

            TipoCultivoId =
                valor.TipoCultivoId,

            ElementoQuimicosId =
                valor.ElementoQuimicosId,

            ValorMinimo =
                valor.ValorMinimo,

            ValorMaximo =
                valor.ValorMaximo,

            UnidadBase =
                valor.UnidadBase,

            DescripcionParametro =
                valor.DescripcionParametro
        };

    private void LimpiarMensajes()
    {
        mensaje = null;
        error = null;
        errorFormulario = null;
        errorCultivo = null;
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}
