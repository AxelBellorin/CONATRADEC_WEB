    private async Task VincularUsuarioPropietarioAsync()
    {
        try
        {
            if (PuedeLeerCoberturas)
            {
                List<CoberturaTerritorialItem> coberturasUsuario =
                    await Servicio.ListarCoberturasAsync(usuarioPortalId) ?? [];

                if (coberturasUsuario.Count > 0)
                {
                    MostrarError("Este usuario ya tiene cobertura territorial. " +
                                 "Retírela antes de asociarlo a un propietario.");
                    return;
                }
            }

            await Servicio.VincularUsuarioPropietarioAsync(
                usuarioPortalId,
                propietarioPortalId);

            propietarioPortalId = 0;
            buscarPropietarioVinculacion = string.Empty;
            MostrarExito("Usuario vinculado correctamente.");
            await CargarPropietariosAsync();
            await CargarUsuariosPropietariosAsignacionAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task DesvincularUsuarioPortalActualAsync()
    {
        if (PropietarioUsuarioPortalActual is null)
            return;

        await DesvincularUsuarioAsync(PropietarioUsuarioPortalActual);
    }

    private async Task DesvincularUsuarioAsync(
        PropietarioAccesoItem propietario)
    {
        if (!propietario.UsuarioPortalId.HasValue)
            return;

        try
        {
            await Servicio.DesvincularUsuarioPropietarioAsync(
                propietario.UsuarioPortalId.Value);

            MostrarExito("Usuario desvinculado correctamente.");
            await CargarPropietariosAsync();
            await CargarUsuariosPropietariosAsignacionAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task CrearAsignacionAsync()
    {
        if (nuevaAsignacion.UsuarioId <= 0 ||
            nuevaAsignacion.TerrenoId <= 0)
        {
            MostrarError("Seleccione usuario y terreno.");
            return;
        }

        try
        {
            nuevaAsignacion.TipoAsignacion = "PROPIETARIO";
            nuevaAsignacion.EsResponsablePrincipal = true;

            await Servicio.CrearAsignacionAsync(nuevaAsignacion);

            nuevaAsignacion = new AsignarUsuarioTerrenoRequest
            {
                UsuarioId = usuarioAsignacionSeleccionadoId,
                TipoAsignacion = "PROPIETARIO",
                EsResponsablePrincipal = true
            };
            buscarTerrenoAsignacion = string.Empty;
            await CargarAsignacionesUsuarioAsync();
            MostrarExito("Terreno asignado al propietario correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

