@page "/contenido/publicaciones"
@using System.ComponentModel.DataAnnotations
@inject AuthStateService AuthState
@inject ApiClientService Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Noticias y publicaciones | CONATRADEC</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Contenido y comunicación</p>
        <h1>Noticias y publicaciones</h1>
        <p>
            Crea borradores, programa publicaciones, administra eventos,
            portadas, estados y contenido destacado.
        </p>
    </div>

    <div class="page-header-actions">
        <a class="btn-secondary"
           href="/contenido/tipos-publicacion">
            <i class="fa-solid fa-tags"></i>
            Tipos de publicación
        </a>

        @if (PuedeAgregar)
        {
            <button class="btn-primary"
                    @onclick="AbrirCrear">
                <i class="fa-solid fa-plus"></i>
                Nueva publicación
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success-custom">
        <i class="fa-solid fa-circle-check"></i>
        <span>@mensaje</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@error</span>
    </div>
}

@if (!PuedeAdministrar)
{
    <section class="panel empty-state compact-empty">
        <i class="fa-solid fa-lock"></i>
        <h2>Sin permiso administrativo</h2>
        <p>
            Para ingresar a este módulo el rol debe tener permiso de agregar,
            actualizar o eliminar en Noticias e intereses.
        </p>
    </section>
}
else
{
    <section class="panel toolbar-panel">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input class="form-control"
                   placeholder="Buscar por título, resumen o contenido"
                   @bind="buscar"
                   @bind:event="oninput" />
        </div>

        <select class="form-control"
                @bind="categoriaFiltro">
            <option value="0">Todas las categorías</option>
            @foreach (CategoriaItem categoria in categorias)
            {
                <option value="@categoria.CategoriaPublicacionId">
                    @categoria.Nombre
                </option>
            }
        </select>

        <select class="form-control"
                @bind="estadoFiltro">
            <option value="">Todos los estados</option>
            <option value="BORRADOR">Borradores</option>
            <option value="PUBLICADA">Publicadas</option>
            <option value="PROGRAMADA">Programadas</option>
            <option value="VENCIDA">Vencidas</option>
            <option value="ARCHIVADA">Archivadas</option>
        </select>

        <button class="btn-primary"
                disabled="@procesando"
                @onclick="BuscarAsync">
            Buscar
        </button>

        <button class="btn-secondary"
                disabled="@procesando"
                @onclick="LimpiarAsync">
            Limpiar
        </button>

        <div class="toolbar-summary">
            <strong>@pagina.TotalRegistros</strong>
            <span>publicaciones</span>
        </div>
    </section>

    @if (cargando)
    {
        <LoadingState Mensaje="Cargando publicaciones..." />
    }
    else if (pagina.Items.Count == 0)
    {
        <section class="panel empty-state compact-empty">
            <i class="fa-solid fa-newspaper"></i>
            <h2>No se encontraron publicaciones</h2>
            <p>Puede crear un borrador para comenzar.</p>
        </section>
    }
    else
    {
        <section class="panel">
            <div class="responsive-table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Publicación</th>
                            <th>Categoría</th>
                            <th>Estado</th>
                            <th>Inicio</th>
                            <th>Autor</th>
                            <th>Destacada</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (PublicacionItem item in pagina.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Titulo</strong>
                                    <small style="display:block">
                                        @item.Resumen
                                    </small>
                                </td>

                                <td>
                                    <span class="badge"
                                          style="border-left:4px solid @item.ColorCategoria">
                                        @item.Categoria
                                    </span>
                                </td>

                                <td>
                                    <span class="status-label @ClaseEstado(item.EstadoVisual)">
                                        @item.EstadoVisual
                                    </span>
                                </td>

                                <td>
                                    @FormatearFecha(
                                        item.FechaInicioPublicacionUtc)
                                </td>

                                <td>@item.Autor</td>

                                <td>
                                    @if (item.Destacada)
                                    {
                                        <i class="fa-solid fa-star"
                                           title="Destacada"></i>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>

                                <td>
                                    <div class="security-actions">
                                        <button class="table-action"
                                                title="Ver o editar"
                                                @onclick="() => AbrirEditarAsync(item.PublicacionId)">
                                            <i class="fa-regular fa-eye"></i>
                                        </button>

                                        @if (PuedeActualizar)
                                        {
                                            <button class="table-action"
                                                    title="Alternar destacada"
                                                    @onclick="() => CambiarDestacadaAsync(item)">
                                                <i class="fa-solid fa-star"></i>
                                            </button>

                                            @if (item.EstadoPublicacion != "PUBLICADA")
                                            {
                                                <button class="btn-secondary"
                                                        @onclick='() => CambiarEstadoAsync(item, "PUBLICADA")'>
                                                    Publicar
                                                </button>
                                            }

                                            @if (item.EstadoPublicacion != "BORRADOR")
                                            {
                                                <button class="btn-secondary"
                                                        @onclick='() => CambiarEstadoAsync(item, "BORRADOR")'>
                                                    Borrador
                                                </button>
                                            }

                                            @if (item.EstadoPublicacion != "ARCHIVADA")
                                            {
                                                <button class="btn-secondary"
                                                        @onclick='() => CambiarEstadoAsync(item, "ARCHIVADA")'>
                                                    Archivar
                                                </button>
                                            }
                                        }

                                        @if (PuedeEliminar)
                                        {
                                            <button class="table-action danger"
                                                    title="Eliminar"
                                                    @onclick="() => EliminarAsync(item)">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Paginador Pagina="pagina.Pagina"
                       TotalPaginas="pagina.TotalPaginas"
                       TotalRegistros="pagina.TotalRegistros"
                       TamanoPagina="pagina.TamanoPagina"
                       Procesando="@procesando"
                       PaginaCambiada="CambiarPaginaAsync"
                       TamanoPaginaCambiado="CambiarTamanoPaginaAsync" />
        </section>
    }
}

@if (mostrarFormulario)
{
    <div class="modal-backdrop"
         @onclick="CerrarFormulario">
        <article class="modal-card user-form-modal"
                 style="max-width:1050px"
                 @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <p class="eyebrow">Contenido institucional</p>
                    <h2>
                        @(formulario.PublicacionId > 0
                            ? "Editar publicación"
                            : "Nueva publicación")
                    </h2>
                </div>

                <button class="modal-close"
                        disabled="@procesando"
                        @onclick="CerrarFormulario">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <EditForm Model="formulario"
                      OnValidSubmit="GuardarAsync"
                      FormName="publicacion-administrativa-form">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="user-form-grid">
                    <div class="form-group">
                        <label>Categoría *</label>
                        <InputSelect class="form-control"
                                     @bind-Value="formulario.CategoriaPublicacionId">
                            <option value="0">Seleccione</option>

                            @foreach (CategoriaItem categoria in categorias)
                            {
                                <option value="@categoria.CategoriaPublicacionId">
                                    @categoria.Nombre
                                </option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-group">
                        <label>Estado *</label>
                        <InputSelect class="form-control"
                                     @bind-Value="formulario.EstadoPublicacion">
                            <option value="BORRADOR">Borrador</option>
                            <option value="PUBLICADA">Publicada</option>
                            <option value="ARCHIVADA">Archivada</option>
                        </InputSelect>
                    </div>

                    <div class="form-group full-width">
                        <label>Título *</label>
                        <InputText class="form-control"
                                   maxlength="180"
                                   @bind-Value="formulario.Titulo" />
                    </div>

                    <div class="form-group full-width">
                        <label>Resumen *</label>
                        <InputTextArea class="form-control"
                                       maxlength="500"
                                       @bind-Value="formulario.Resumen" />
                    </div>

                    <div class="form-group full-width">
                        <label>Contenido *</label>
                        <InputTextArea class="form-control"
                                       style="min-height:180px"
                                       @bind-Value="formulario.Contenido" />
                    </div>

                    <div class="form-group">
                        <label>Inicio de publicación *</label>
                        <InputDate class="form-control"
                                   Type="InputDateType.DateTimeLocal"
                                   @bind-Value="formulario.FechaInicioPublicacion" />
                    </div>

                    <div class="form-group">
                        <label>Fin de publicación</label>
                        <InputDate class="form-control"
                                   Type="InputDateType.DateTimeLocal"
                                   @bind-Value="formulario.FechaFinPublicacion" />
                    </div>

                    <div class="form-group">
                        <label>Inicio del evento</label>
                        <InputDate class="form-control"
                                   Type="InputDateType.DateTimeLocal"
                                   @bind-Value="formulario.FechaEventoInicio" />
                    </div>

                    <div class="form-group">
                        <label>Fin del evento</label>
                        <InputDate class="form-control"
                                   Type="InputDateType.DateTimeLocal"
                                   @bind-Value="formulario.FechaEventoFin" />
                    </div>

                    <div class="form-group full-width">
                        <label>Ubicación</label>
                        <InputText class="form-control"
                                   maxlength="300"
                                   @bind-Value="formulario.Ubicacion" />
                    </div>

                    <div class="form-group">
                        <label>Enlace externo</label>
                        <InputText class="form-control"
                                   maxlength="1000"
                                   @bind-Value="formulario.EnlaceExterno" />
                    </div>

                    <div class="form-group">
                        <label>Texto del enlace</label>
                        <InputText class="form-control"
                                   maxlength="120"
                                   @bind-Value="formulario.TextoEnlace" />
                    </div>

                    <div class="form-group">
                        <label>Portada</label>
                        <InputFile class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   OnChange="SeleccionarPortada" />
                    </div>

                    <div class="form-group">
                        <label class="album-check">
                            <InputCheckbox
                                @bind-Value="formulario.Destacada" />
                            <span>Publicación destacada</span>
                        </label>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(
                        formulario.RutaImagenPortada))
                {
                    <div class="alert alert-info">
                        La publicación ya tiene una portada. Seleccione otra
                        imagen únicamente para reemplazarla.
                    </div>
                }

                <div class="modal-actions">
                    <button type="button"
                            class="btn-secondary"
                            disabled="@procesando"
                            @onclick="CerrarFormulario">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn-primary"
                            disabled="@procesando">
                        @(procesando
                            ? "Guardando..."
                            : "Guardar publicación")
                    </button>
                </div>
            </EditForm>
        </article>
    </div>
}

@code {
    private const string CodigoPermiso =
        "noticiasPage";

    private readonly List<CategoriaItem> categorias = [];
    private PublicacionPagina pagina = new();
    private PublicacionFormulario formulario = new();
    private IBrowserFile? portadaPendiente;

    private bool cargando = true;
    private bool procesando;
    private bool mostrarFormulario;
    private string buscar = string.Empty;
    private int categoriaFiltro;
    private string estadoFiltro = string.Empty;
    private string? mensaje;
    private string? error;

    private bool PuedeAgregar =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoAgregar(
            CodigoPermiso);

    private bool PuedeActualizar =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoActualizar(
            CodigoPermiso);

    private bool PuedeEliminar =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoEliminar(
            CodigoPermiso);

    private bool PuedeAdministrar =>
        AuthState.EsAdministrador ||
        PuedeAgregar ||
        PuedeActualizar ||
        PuedeEliminar;

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (PuedeAdministrar)
        {
            await CargarCategoriasAsync();
            await CargarAsync();
        }
        else
        {
            cargando = false;
        }

        StateHasChanged();
    }

    private async Task CargarCategoriasAsync()
    {
        ApiRespuesta<List<CategoriaItem>>? respuesta =
            await Api.GetAsync<
                ApiRespuesta<List<CategoriaItem>>>(
                "api/publicacion/categorias");

        categorias.Clear();

        if (respuesta?.Data is not null)
            categorias.AddRange(respuesta.Data);
    }

    private async Task CargarAsync()
    {
        cargando = true;
        LimpiarMensajes();

        try
        {
            string url =
                "api/publicacion/administrar" +
                $"?pagina={Math.Max(1, pagina.Pagina)}" +
                $"&tamanoPagina={pagina.TamanoPagina}";

            if (categoriaFiltro > 0)
            {
                url +=
                    $"&categoriaId={categoriaFiltro}";
            }

            if (!string.IsNullOrWhiteSpace(
                    estadoFiltro))
            {
                url +=
                    "&estado=" +
                    Uri.EscapeDataString(
                        estadoFiltro);
            }

            if (!string.IsNullOrWhiteSpace(
                    buscar))
            {
                url +=
                    "&buscar=" +
                    Uri.EscapeDataString(
                        buscar.Trim());
            }

            ApiRespuesta<PublicacionPagina>? respuesta =
                await Api.GetAsync<
                    ApiRespuesta<PublicacionPagina>>(
                    url);

            pagina = respuesta?.Data ?? new();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarAsync()
    {
        pagina.Pagina = 1;
        await CargarAsync();
    }

    private async Task LimpiarAsync()
    {
        buscar = string.Empty;
        categoriaFiltro = 0;
        estadoFiltro = string.Empty;
        pagina.Pagina = 1;
        await CargarAsync();
    }

    private async Task CambiarPaginaAsync(
        int nuevaPagina)
    {
        pagina.Pagina = nuevaPagina;
        await CargarAsync();
    }

    private async Task CambiarTamanoPaginaAsync(
        int nuevoTamano)
    {
        pagina.TamanoPagina = nuevoTamano;
        pagina.Pagina = 1;
        await CargarAsync();
    }

    private void AbrirCrear()
    {
        formulario = new PublicacionFormulario
        {
            FechaInicioPublicacion =
                DateTime.Now.AddMinutes(5),
            EstadoPublicacion =
                "BORRADOR"
        };

        portadaPendiente = null;
        mostrarFormulario = true;
        LimpiarMensajes();
    }

    private async Task AbrirEditarAsync(
        int id)
    {
        procesando = true;
        LimpiarMensajes();

        try
        {
            ApiRespuesta<PublicacionDetalle>? respuesta =
                await Api.GetAsync<
                    ApiRespuesta<PublicacionDetalle>>(
                    $"api/publicacion/administrar/{id}");

            PublicacionDetalle? item =
                respuesta?.Data;

            if (item is null)
            {
                throw new InvalidOperationException(
                    "La API no devolvió la publicación.");
            }

            formulario =
                PublicacionFormulario.Desde(item);

            portadaPendiente = null;
            mostrarFormulario = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private void SeleccionarPortada(
        InputFileChangeEventArgs args)
    {
        portadaPendiente = args.File;
    }

    private void CerrarFormulario()
    {
        if (procesando)
            return;

        mostrarFormulario = false;
        formulario = new();
        portadaPendiente = null;
    }

    private async Task GuardarAsync()
    {
        procesando = true;
        LimpiarMensajes();

        try
        {
            PublicacionGuardar datos =
                formulario.CrearPayload();

            int publicacionId =
                formulario.PublicacionId;

            if (publicacionId <= 0)
            {
                ApiRespuesta<PublicacionCreada>? respuesta =
                    await Api.PostAsync<
                        PublicacionGuardar,
                        ApiRespuesta<PublicacionCreada>>(
                        "api/publicacion/crear",
                        datos);

                publicacionId =
                    respuesta?.Data?.PublicacionId ?? 0;

                if (publicacionId <= 0)
                {
                    throw new InvalidOperationException(
                        "La API no devolvió el identificador de la publicación.");
                }
            }
            else
            {
                await Api.PutAsync<
                    PublicacionGuardar,
                    ApiRespuesta<object>>(
                    $"api/publicacion/actualizar/{publicacionId}",
                    datos);
            }

            if (portadaPendiente is not null)
            {
                await Api.SubirFormularioArchivoAsync<
                    ApiRespuesta<PortadaRespuesta>>(
                    $"api/publicacion/{publicacionId}/portada",
                    portadaPendiente,
                    nombreCampo: "archivo",
                    tamanoMaximo:
                        8 * 1024 * 1024);
            }

            mostrarFormulario = false;
            formulario = new();
            portadaPendiente = null;

            await CargarAsync();

            mensaje =
                "Publicación guardada correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task CambiarEstadoAsync(
        PublicacionItem item,
        string estado)
    {
        procesando = true;
        LimpiarMensajes();

        try
        {
            await Api.PatchAsync<
                CambiarEstado,
                ApiRespuesta<object>>(
                $"api/publicacion/cambiar-estado/{item.PublicacionId}",
                new CambiarEstado
                {
                    EstadoPublicacion = estado
                });

            await CargarAsync();

            mensaje =
                "Estado actualizado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task CambiarDestacadaAsync(
        PublicacionItem item)
    {
        procesando = true;
        LimpiarMensajes();

        try
        {
            await Api.PatchAsync<
                CambiarDestacada,
                ApiRespuesta<object>>(
                $"api/publicacion/cambiar-destacada/{item.PublicacionId}",
                new CambiarDestacada
                {
                    Destacada = !item.Destacada
                });

            await CargarAsync();

            mensaje =
                "Destacado actualizado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task EliminarAsync(
        PublicacionItem item)
    {
        bool confirmar =
            await JS.InvokeAsync<bool>(
                "confirm",
                "¿Desea eliminar la publicación \"" +
                item.Titulo +
                "\"?");

        if (!confirmar)
            return;

        procesando = true;
        LimpiarMensajes();

        try
        {
            await Api.EliminarAsync(
                $"api/publicacion/eliminar/{item.PublicacionId}");

            await CargarAsync();

            mensaje =
                "Publicación eliminada correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private static string FormatearFecha(
        DateTime fecha) =>
        fecha == default
            ? "Sin fecha"
            : DateTime.SpecifyKind(
                    fecha,
                    DateTimeKind.Utc)
                .ToLocalTime()
                .ToString("dd/MM/yyyy HH:mm");

    private static string ClaseEstado(
        string? estado) =>
        (estado ?? string.Empty)
            .ToUpperInvariant() switch
        {
            "PUBLICADA" => "success",
            "PROGRAMADA" => "warning",
            "VENCIDA" => "danger",
            "ARCHIVADA" => "danger",
            _ => "neutral"
        };

    private void LimpiarMensajes()
    {
        mensaje = null;
        error = null;
    }

    private sealed class ApiRespuesta<T>
    {
        public bool Success { get; set; }

        public string Message { get; set; } =
            string.Empty;

        public T? Data { get; set; }
    }

    private sealed class CategoriaItem
    {
        public int CategoriaPublicacionId
        {
            get;
            set;
        }

        public string Nombre { get; set; } =
            string.Empty;

        public string Descripcion { get; set; } =
            string.Empty;

        public string ColorHex { get; set; } =
            "#3B655B";

        public int Orden { get; set; }
    }

    private sealed class PublicacionPagina
    {
        public List<PublicacionItem> Items
        {
            get;
            set;
        } = [];

        public int Pagina { get; set; } = 1;

        public int TamanoPagina { get; set; } = 20;

        public int TotalRegistros { get; set; }

        public int TotalPaginas { get; set; } = 1;
    }

    private class PublicacionItem
    {
        public int PublicacionId { get; set; }

        public int CategoriaPublicacionId
        {
            get;
            set;
        }

        public string Categoria { get; set; } =
            string.Empty;

        public string ColorCategoria { get; set; } =
            "#3B655B";

        public string Titulo { get; set; } =
            string.Empty;

        public string Resumen { get; set; } =
            string.Empty;

        public string RutaImagenPortada { get; set; } =
            string.Empty;

        public string Ubicacion { get; set; } =
            string.Empty;

        public DateTime? FechaEventoInicioUtc
        {
            get;
            set;
        }

        public DateTime? FechaEventoFinUtc
        {
            get;
            set;
        }

        public DateTime FechaInicioPublicacionUtc
        {
            get;
            set;
        }

        public DateTime? FechaFinPublicacionUtc
        {
            get;
            set;
        }

        public string EstadoPublicacion { get; set; } =
            string.Empty;

        public string EstadoVisual { get; set; } =
            string.Empty;

        public bool Destacada { get; set; }

        public string Autor { get; set; } =
            string.Empty;

        public string UltimoEditor { get; set; } =
            string.Empty;
    }

    private sealed class PublicacionDetalle :
        PublicacionItem
    {
        public string Contenido { get; set; } =
            string.Empty;

        public string EnlaceExterno { get; set; } =
            string.Empty;

        public string TextoEnlace { get; set; } =
            string.Empty;

        public bool Activo { get; set; }
    }

    private sealed class PublicacionFormulario
    {
        public int PublicacionId { get; set; }

        [Range(
            1,
            int.MaxValue,
            ErrorMessage =
                "Seleccione una categoría.")]
        public int CategoriaPublicacionId
        {
            get;
            set;
        }

        [Required(
            ErrorMessage =
                "El título es obligatorio.")]
        [MaxLength(180)]
        public string Titulo { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "El resumen es obligatorio.")]
        [MaxLength(500)]
        public string Resumen { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "El contenido es obligatorio.")]
        public string Contenido { get; set; } =
            string.Empty;

        public string EnlaceExterno { get; set; } =
            string.Empty;

        public string TextoEnlace { get; set; } =
            string.Empty;

        public string Ubicacion { get; set; } =
            string.Empty;

        [Required]
        public DateTime FechaInicioPublicacion
        {
            get;
            set;
        } = DateTime.Now;

        public DateTime? FechaFinPublicacion
        {
            get;
            set;
        }

        public DateTime? FechaEventoInicio
        {
            get;
            set;
        }

        public DateTime? FechaEventoFin
        {
            get;
            set;
        }

        [Required]
        public string EstadoPublicacion { get; set; } =
            "BORRADOR";

        public bool Destacada { get; set; }

        public string RutaImagenPortada { get; set; } =
            string.Empty;

        public PublicacionGuardar CrearPayload() =>
            new()
            {
                PublicacionId =
                    PublicacionId,
                CategoriaPublicacionId =
                    CategoriaPublicacionId,
                Titulo =
                    Titulo,
                Resumen =
                    Resumen,
                Contenido =
                    Contenido,
                EnlaceExterno =
                    EnlaceExterno,
                TextoEnlace =
                    TextoEnlace,
                Ubicacion =
                    Ubicacion,
                FechaEventoInicio =
                    AOffset(FechaEventoInicio),
                FechaEventoFin =
                    AOffset(FechaEventoFin),
                FechaInicioPublicacion =
                    AOffset(
                        FechaInicioPublicacion),
                FechaFinPublicacion =
                    AOffset(
                        FechaFinPublicacion),
                EstadoPublicacion =
                    EstadoPublicacion,
                Destacada =
                    Destacada
            };

        public static PublicacionFormulario Desde(
            PublicacionDetalle item) =>
            new()
            {
                PublicacionId =
                    item.PublicacionId,
                CategoriaPublicacionId =
                    item.CategoriaPublicacionId,
                Titulo =
                    item.Titulo,
                Resumen =
                    item.Resumen,
                Contenido =
                    item.Contenido,
                EnlaceExterno =
                    item.EnlaceExterno,
                TextoEnlace =
                    item.TextoEnlace,
                Ubicacion =
                    item.Ubicacion,
                FechaEventoInicio =
                    ALocal(
                        item.FechaEventoInicioUtc),
                FechaEventoFin =
                    ALocal(
                        item.FechaEventoFinUtc),
                FechaInicioPublicacion =
                    ALocal(
                        item.FechaInicioPublicacionUtc),
                FechaFinPublicacion =
                    ALocal(
                        item.FechaFinPublicacionUtc),
                EstadoPublicacion =
                    item.EstadoPublicacion,
                Destacada =
                    item.Destacada,
                RutaImagenPortada =
                    item.RutaImagenPortada
            };

        private static DateTimeOffset AOffset(
            DateTime value) =>
            new(
                DateTime.SpecifyKind(
                    value,
                    DateTimeKind.Local));

        private static DateTimeOffset? AOffset(
            DateTime? value) =>
            value.HasValue
                ? AOffset(value.Value)
                : null;

        private static DateTime ALocal(
            DateTime value) =>
            DateTime.SpecifyKind(
                    value,
                    DateTimeKind.Utc)
                .ToLocalTime();

        private static DateTime? ALocal(
            DateTime? value) =>
            value.HasValue
                ? ALocal(value.Value)
                : null;
    }

