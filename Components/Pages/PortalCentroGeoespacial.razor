    private static PortalCentroElemento? ObtenerElemento(
        PortalCentroTerreno terreno,
        string clave)
    {
        string valorId = clave.Replace(
            "nutriente-",
            string.Empty,
            StringComparison.OrdinalIgnoreCase);

        return int.TryParse(valorId, out int elementoId)
            ? terreno.Elementos.FirstOrDefault(x =>
                x.ElementoQuimicosId == elementoId)
            : null;
    }

    private static string ClasificarPromedio(
        string clave,
        decimal promedio,
        IEnumerable<string> clasificaciones)
    {
        if (clave.StartsWith("nutriente-", StringComparison.OrdinalIgnoreCase))
        {
            return clasificaciones
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .GroupBy(x => x.Trim().ToUpperInvariant())
                .OrderByDescending(x => x.Count())
                .Select(x => x.Key)
                .FirstOrDefault() ?? "SIN CLASIFICAR";
        }

        return clave switch
        {
            "ph" when promedio < 5.3m => "BAJO",
            "ph" when promedio <= 6.5m => "ADECUADO",
            "ph" => "ALTO",
            "materia-organica" when promedio <= 3m => "BAJO",
            "materia-organica" when promedio <= 5m => "MEDIO",
            "materia-organica" => "ALTO",
            "acidez-total" when promedio >= 1m => "ALTO",
            "acidez-total" when promedio >= 0.5m => "MEDIO",
            "acidez-total" => "BAJO",
            "cice" when promedio < 5m => "BAJO",
            "cice" when promedio < 10m => "MEDIO",
            "cice" => "ALTO",
            "saturacion-bases" when promedio < 40m => "BAJO",
            "saturacion-bases" when promedio < 60m => "MEDIO",
            "saturacion-bases" => "ALTO",
            _ => "SIN CLASIFICAR"
        };
    }

    private static string ColorClasificacion(
        string clave,
        decimal promedio,
        string clasificacion)
    {
        string normal = clasificacion.ToUpperInvariant();

        if (clave == "ph")
        {
            if (promedio < 4.8m) return "#B91C1C";
            if (promedio < 5.3m) return "#F97316";
            if (promedio < 6.5m) return "#2F855A";
            if (promedio < 7.2m) return "#0EA5E9";
            return "#6D28D9";
        }

        if (normal.Contains("BAJO")) return "#EF4444";
        if (normal.Contains("MEDIO")) return "#F2C94C";
        if (normal.Contains("ADECUADO")) return "#3B655B";
        if (normal.Contains("ALTO")) return "#3B82F6";
        return "#64748B";
    }

