@page "/reportes"
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<PageTitle>Centro de reportes | CONATRADEC</PageTitle>
<div class="page-header">
    <div>
        <p class="eyebrow">Informes de gestión</p>
        <h1>Centro de reportes</h1>
        <p>Consulta indicadores y resultados institucionales; exporta los registros autorizados a Excel.</p>
    </div>
</div>

@if (cargando)
{
    <LoadingState Mensaje="Preparando centro de reportes..." />
}
else if (!PuedeLeer)
{
    <section class="panel empty-state compact-empty">
        <i class="fa-solid fa-lock"></i>
        <h2>Sin permiso para reportes</h2>
        <p>Solicita al administrador acceso al Centro de reportes.</p>
    </section>
}
else
{
    <ReportesAvanzados />
}

@code {
    private bool cargando = true;
    private bool PuedeLeer => AuthState.EsAdministrador || AuthState.TienePermisoLectura("reportesPage");

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return Task.CompletedTask;

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return Task.CompletedTask;
        }

        cargando = false;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
