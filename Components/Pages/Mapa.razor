            "lluvia", "Precipitación", "CLIMA",
            "fa-solid fa-cloud-rain", 320),
        CrearCapaRespaldo(
            "viento", "Velocidad del viento", "CLIMA",
            "fa-solid fa-wind", 330)
    ];

    private static MapaCapaDisponible CrearCapaRespaldo(
        string clave,
        string nombre,
        string categoria,
        string icono,
        int orden,
        bool activaPorDefecto = false) =>
        new()
        {
            Clave = clave,
            Nombre = nombre,
            Categoria = categoria,
            Icono = icono,
            Descripcion = "Capa del Centro Geoespacial CONATRADEC.",
            Disponible = true,
            ActivaPorDefecto = activaPorDefecto,
            Orden = orden
        };

    public async ValueTask DisposeAsync()
    {
        if (mapaInicializado)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "conatradecMapaInteligente.destruir",
                    "mapaTerrenos");
            }
            catch (JSDisconnectedException)
            {
                // La navegación ya cerró el circuito de Blazor.
            }
        }

        referenciaDotNet?.Dispose();
    }

    private sealed class CatalogoSimple
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
    }
