        };

    private static ClimaMapaRespuesta LimitarClimaATerrenos(
        ClimaMapaRespuesta clima,
        IReadOnlyCollection<PortalCentroTerreno> terrenos)
    {
        List<PortalCentroTerreno> ubicaciones = terrenos
            .Where(x => x.TieneCoordenadas)
            .ToList();

        if (!clima.Disponible ||
            clima.Puntos.Count == 0 ||
            ubicaciones.Count == 0)
        {
            return clima;
        }

        var seleccionados =
            new Dictionary<(decimal Latitud, decimal Longitud), ClimaPuntoMapa>();

        foreach (PortalCentroTerreno terreno in ubicaciones)
        {
            foreach (ClimaPuntoMapa punto in clima.Puntos
                         .OrderBy(x => DistanciaCuadrada(
                             terreno.Latitud,
                             terreno.Longitud,
                             x.Latitud,
                             x.Longitud))
                         .Take(12))
            {
                seleccionados[(punto.Latitud, punto.Longitud)] = punto;
            }
        }

        List<ClimaPuntoMapa> puntos = seleccionados
            .Values
            .OrderBy(x => x.Latitud)
            .ThenBy(x => x.Longitud)
            .ToList();

        if (puntos.Count == 0)
            return clima;

        return new ClimaMapaRespuesta
        {
            Disponible = true,
            Mensaje =
                "Condiciones meteorológicas calculadas con los puntos " +
                "más cercanos a sus terrenos.",
            Proveedor = clima.Proveedor,
            Licencia = clima.Licencia,
            ActualizadoUtc = clima.ActualizadoUtc,
            UnidadTemperatura = clima.UnidadTemperatura,
            UnidadPrecipitacion = clima.UnidadPrecipitacion,
            UnidadViento = clima.UnidadViento,
            TemperaturaMinima = MinimoClima(
                puntos.Select(x => x.Temperatura)),
            TemperaturaMaxima = MaximoClima(
                puntos.Select(x => x.Temperatura)),
            HumedadMinima = MinimoClima(
                puntos.Select(x => x.HumedadRelativa)),
            HumedadMaxima = MaximoClima(
                puntos.Select(x => x.HumedadRelativa)),
            PrecipitacionMaxima = MaximoClima(
                puntos.Select(x => x.Precipitacion)),
            VientoMaximo = MaximoClima(
                puntos.Select(x => x.VelocidadViento)),
            Puntos = puntos
        };
    }

    private static decimal DistanciaCuadrada(
        decimal latitudOrigen,
        decimal longitudOrigen,
        decimal latitudDestino,
        decimal longitudDestino)
    {
        decimal diferenciaLatitud = latitudDestino - latitudOrigen;
        decimal diferenciaLongitud = longitudDestino - longitudOrigen;

        return diferenciaLatitud * diferenciaLatitud +
               diferenciaLongitud * diferenciaLongitud;
    }

    private static decimal? MinimoClima(
        IEnumerable<decimal?> valores)
    {
        List<decimal> disponibles = valores
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .ToList();

        return disponibles.Count > 0
            ? disponibles.Min()
            : null;
    }

    private static decimal? MaximoClima(
        IEnumerable<decimal?> valores)
    {
        List<decimal> disponibles = valores
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .ToList();

        return disponibles.Count > 0
            ? disponibles.Max()
            : null;
    }

