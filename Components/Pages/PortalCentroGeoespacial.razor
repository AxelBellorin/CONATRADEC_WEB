    public async Task SeleccionarTerreno(int terrenoId)
    {
        cargandoHistorial = true;
        detalleTerreno = null;
        analisisSeleccionado = null;
        StateHasChanged();

        try
        {
            detalleTerreno = await Servicio
                .ObtenerHistorialTerrenoAsync(terrenoId, 20);
            analisisSeleccionado =
                detalleTerreno?.Analisis.FirstOrDefault();
        }
        catch (Exception ex)
        {
            error = $"No fue posible cargar el historial. {ex.Message}";
        }
        finally
        {
            cargandoHistorial = false;
            StateHasChanged();
        }
    }

