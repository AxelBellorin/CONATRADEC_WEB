    private static string ClaseEstado(
        string estado) =>
        estado.ToUpperInvariant() switch
        {
            "CORRECTO" =>
                "relationship-state-correct",
            "ADVERTENCIA" =>
                "relationship-state-warning",
            "INACTIVO" =>
                "relationship-state-inactive",
            _ =>
                "relationship-state-information"
        };

    private static string NombreEstado(
        string estado) =>
        estado.ToUpperInvariant() switch
        {
            "CORRECTO" =>
                "Correcto",
            "ADVERTENCIA" =>
                "Requiere revisión",
            "INACTIVO" =>
                "Inactivo",
            _ =>
                "Informativo"
        };

    private static string Valor(
        string? valor,
        string alternativo = "Sin dato") =>
        string.IsNullOrWhiteSpace(valor)
            ? alternativo
            : valor.Trim();

    private static string Numero(
        decimal? valor) =>
        valor.HasValue
            ? valor.Value.ToString("N4")
            : "Sin dato";

    private static string FechaLocal(
        DateTime fecha) =>
        fecha.ToLocalTime()
            .ToString("dd/MM/yyyy hh:mm:ss tt");

    private static string FechaLocal(
        DateTime? fecha) =>
        fecha.HasValue
            ? FechaLocal(fecha.Value)
            : "Sin dato";

