    private async Task TipoCoberturaCambiadoAsync(
        ChangeEventArgs args)
    {
        nuevaCobertura.TipoCobertura =
            args.Value?.ToString()?.Trim().ToUpperInvariant() ??
            "DEPARTAMENTO";

        if (nuevaCobertura.TipoCobertura == "NACIONAL")
        {
            nuevaCobertura.DepartamentoId = null;
            nuevaCobertura.MunicipioId = null;
            municipios = [];
            return;
        }

        if (nuevaCobertura.TipoCobertura == "DEPARTAMENTO")
        {
            nuevaCobertura.MunicipioId = null;
            municipios = [];
            return;
        }

        municipios = nuevaCobertura.DepartamentoId.HasValue
            ? await Servicio.ListarMunicipiosAsync(
                nuevaCobertura.DepartamentoId) ?? []
            : [];
    }

    private async Task DepartamentoCoberturaCambiadoAsync(
        ChangeEventArgs args)
    {
        nuevaCobertura.DepartamentoId =
            int.TryParse(args.Value?.ToString(), out int departamentoId)
                ? departamentoId
                : null;

        nuevaCobertura.MunicipioId = null;

        municipios =
            nuevaCobertura.TipoCobertura == "MUNICIPIO" &&
            nuevaCobertura.DepartamentoId.HasValue
                ? await Servicio.ListarMunicipiosAsync(
                    nuevaCobertura.DepartamentoId) ?? []
                : [];
    }

    private async Task CargarCoberturasUsuarioAsync()
    {
        if (!PuedeLeerCoberturas || usuarioCoberturaSeleccionadoId <= 0)
        {
            coberturas = [];
            return;
        }

        cargandoCoberturasUsuario = true;

        try
        {
            coberturas = await Servicio.ListarCoberturasAsync(
                usuarioCoberturaSeleccionadoId) ?? [];
        }
        catch (Exception ex)
        {
            coberturas = [];
            MostrarError(ex.Message);
        }
        finally
        {
            cargandoCoberturasUsuario = false;
        }
    }

    private async Task CrearCoberturaAsync()
    {
        if (usuarioCoberturaSeleccionadoId <= 0)
        {
            MostrarError("Seleccione un usuario.");
            return;
        }

        nuevaCobertura.UsuarioId = usuarioCoberturaSeleccionadoId;

        if (!FormularioCoberturaCompleto)
        {
            MostrarError("Complete la ubicación requerida para la cobertura.");
            return;
        }

        if (PropietarioUsuarioCobertura is not null)
        {
            MostrarError("Este usuario ya está asociado a un propietario. " +
                         "Retire esa vinculación antes de asignarle cobertura.");
            return;
        }

        if (CoberturaYaRegistrada(nuevaCobertura))
        {
            MostrarError("Este usuario ya tiene registrada esa misma cobertura.");
            return;
        }

        try
        {
            await Servicio.CrearCoberturaAsync(nuevaCobertura);
            ReiniciarFormularioCobertura();
            await CargarCoberturasUsuarioAsync();
            MostrarExito("Cobertura creada correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task EliminarCoberturaAsync(
        CoberturaTerritorialItem item)
    {
        try
        {
            await Servicio.EliminarCoberturaAsync(
                item.UsuarioCoberturaTerritorialId);

            await CargarCoberturasUsuarioAsync();
            MostrarExito("Cobertura retirada correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private void ReiniciarFormularioCobertura()
    {
        nuevaCobertura = new GuardarCoberturaTerritorialRequest
        {
            UsuarioId = usuarioCoberturaSeleccionadoId,
            TipoCobertura = "DEPARTAMENTO"
        };

        municipios = [];
    }

    private bool CoberturaYaRegistrada(
        GuardarCoberturaTerritorialRequest cobertura)
    {
        string tipo = cobertura.TipoCobertura.Trim().ToUpperInvariant();

        return coberturas.Any(item =>
            string.Equals(
                item.TipoCobertura,
                tipo,
                StringComparison.OrdinalIgnoreCase) &&
            (tipo == "NACIONAL" ||
             (tipo == "DEPARTAMENTO" &&
              item.DepartamentoId == cobertura.DepartamentoId) ||
             (tipo == "MUNICIPIO" &&
              item.DepartamentoId == cobertura.DepartamentoId &&
              item.MunicipioId == cobertura.MunicipioId)));
    }

    private bool EsCoberturaDuplicada(CoberturaTerritorialItem item) =>
        coberturas.Count(otra =>
            ClaveCobertura(otra) == ClaveCobertura(item)) > 1;

    private static string ClaveCobertura(CoberturaTerritorialItem item) =>
        $"{item.TipoCobertura.Trim().ToUpperInvariant()}|" +
        $"{item.DepartamentoId?.ToString() ?? "-"}|" +
        $"{item.MunicipioId?.ToString() ?? "-"}";

    private static string NombreTipoCobertura(string tipo) =>
        tipo.Trim().ToUpperInvariant() switch
        {
            "NACIONAL" => "Todo Nicaragua",
            "DEPARTAMENTO" => "Departamento",
            "MUNICIPIO" => "Municipio",
            _ => tipo
        };

