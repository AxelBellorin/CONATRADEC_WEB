    private async Task AbrirEditarAsync(
        FuenteNutrienteAdminItemModel fuente)
    {
        LimpiarMensaje();

        try
        {
            FuenteNutrienteAdminItemModel? actual =
                await ApiClient.GetAsync<
                    FuenteNutrienteAdminItemModel>(
                    $"api/fuente-nutriente/obtener/" +
                    $"{fuente.FuenteNutrientesId}",
                    cancellation.Token);

            if (actual is null)
            {
                MostrarMensaje(
                    "La API no devolvió el detalle de la fuente.",
                    true);
                return;
            }

            formulario =
                CrearFormularioBase();

            formulario.FuenteNutrientesId =
                actual.FuenteNutrientesId;

            formulario.NombreNutriente =
                actual.NombreNutriente;

            formulario.DescripcionNutriente =
                actual.DescripcionNutriente;

            formulario.PrecioNutriente =
                actual.PrecioNutriente;

            formulario.HabilitadaEnmiendaCalcarea =
                actual.HabilitadaEnmiendaCalcarea;

            formulario.HabilitadaFertilizacionMixta =
                actual.HabilitadaFertilizacionMixta;

            formulario.EnmiendaOriginal =
                actual.HabilitadaEnmiendaCalcarea;

            formulario.FertilizacionMixtaOriginal =
                actual.HabilitadaFertilizacionMixta;

            formulario.Prnt =
                actual.Prnt ??
                80m;

            formulario.DescripcionParametro =
                actual.DescripcionParametro ??
                "Fuente utilizada para cálculo de enmienda calcárea";

            Dictionary<int, ElementoFuenteAdminModel> aportes =
                actual.ElementosQuimicos
                    .ToDictionary(item =>
                        item.ElementoQuimicosId);

            foreach (var elemento in formulario.Elementos)
            {
                if (!aportes.TryGetValue(
                        elemento.ElementoQuimicosId,
                        out ElementoFuenteAdminModel? aporte))
                {
                    continue;
                }

                elemento.Seleccionado =
                    true;

                elemento.CantidadAporte =
                    aporte.CantidadAporte;
            }

            mostrarFormulario =
                true;
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"No fue posible abrir la fuente. {ex.Message}",
                true);
        }
    }

    private async Task GuardarAsync()
    {
        string? validacion =
            ValidarFormulario();

        if (!string.IsNullOrWhiteSpace(validacion))
        {
            MostrarMensaje(
                validacion,
                true);
            return;
        }

        guardando =
            true;

        try
        {
            FuenteNutrienteGuardarRequestModel request =
                new()
                {
                    NombreNutriente =
                        formulario.NombreNutriente.Trim(),

                    DescripcionNutriente =
                        formulario.DescripcionNutriente.Trim(),

                    PrecioNutriente =
                        formulario.PrecioNutriente,

                    ElementosQuimicos =
                        formulario.Elementos
                            .Where(item =>
                                item.Seleccionado)
                            .Select(item =>
                                new ElementoFuenteGuardarRequestModel
                                {
                                    ElementoQuimicosId =
                                        item.ElementoQuimicosId,

                                    CantidadAporte =
                                        item.CantidadAporte
                                })
                            .ToList()
                };

            FuenteNutrienteMutationResponseModel? response;

            if (formulario.FuenteNutrientesId.HasValue)
            {
                response =
                    await ApiClient.PutAsync<
                        FuenteNutrienteGuardarRequestModel,
                        FuenteNutrienteMutationResponseModel>(
                        "api/fuente-nutriente/" +
                        "editar-con-elementos/" +
                        formulario.FuenteNutrientesId.Value,
                        request,
                        cancellation.Token);
            }
            else
            {
                response =
                    await ApiClient.PostAsync<
                        FuenteNutrienteGuardarRequestModel,
                        FuenteNutrienteMutationResponseModel>(
                        "api/fuente-nutriente/" +
                        "crear-con-elementos",
                        request,
                        cancellation.Token);
            }

            int fuenteId =
                formulario.FuenteNutrientesId ??
                response?.Data?.FuenteNutrientesId ??
                0;

            if (fuenteId <= 0)
            {
                throw new InvalidOperationException(
                    "La API no devolvió el identificador de la fuente.");
            }

            await SincronizarClasificacionesAsync(
                fuenteId);

            mostrarFormulario =
                false;

            MostrarMensaje(
                response?.Mensaje ??
                "Fuente guardada correctamente.",
                false);

            await CargarActivasAsync(1);
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"No fue posible guardar la fuente. {ex.Message}",
                true);
        }
        finally
        {
            guardando =
                false;
        }
    }

    private async Task SincronizarClasificacionesAsync(
        int fuenteId)
    {
        if (formulario.HabilitadaEnmiendaCalcarea)
        {
            await ApiClient.PostAsync<
                HabilitarEnmiendaCalcareaRequestModel,
                JsonElement>(
                $"api/fuente-nutriente/{fuenteId}/" +
                "habilitar-enmienda-calcarea",
                new HabilitarEnmiendaCalcareaRequestModel
                {
                    Prnt =
                        formulario.Prnt,

                    DescripcionParametro =
                        formulario.DescripcionParametro.Trim()
                },
                cancellation.Token);
        }
        else if (formulario.EnmiendaOriginal)
        {
            await ApiClient.PutSinContenidoAsync(
                "api/fuente-nutriente/" +
                $"deshabilitar-enmienda-calcarea/{fuenteId}",
                cancellationToken:
                    cancellation.Token);
        }

        if (formulario.HabilitadaFertilizacionMixta !=
            formulario.FertilizacionMixtaOriginal)
        {
            if (formulario.HabilitadaFertilizacionMixta)
            {
                await ApiClient.PostSinContenidoAsync(
                    "api/fuente-nutriente/" +
                    $"habilitar-fertilizacion-mixta/{fuenteId}",
                    cancellation.Token);
            }
            else
            {
                await ApiClient.PutSinContenidoAsync(
                    "api/fuente-nutriente/" +
                    $"deshabilitar-fertilizacion-mixta/{fuenteId}",
                    cancellationToken:
                        cancellation.Token);
            }
        }
    }

    private string? ValidarFormulario()
    {
        if (string.IsNullOrWhiteSpace(
                formulario.NombreNutriente))
        {
            return "El nombre de la fuente es obligatorio.";
        }

        if (formulario.PrecioNutriente <= 0)
        {
            return "El precio por quintal debe ser mayor a cero.";
        }

        List<ElementoFuenteFormModel> seleccionados =
            formulario.Elementos
                .Where(item =>
                    item.Seleccionado)
                .ToList();

        if (seleccionados.Any(item =>
                item.CantidadAporte <= 0 ||
                item.CantidadAporte > 100))
        {
            return "Cada aporte seleccionado debe ser mayor a 0 y menor " +
                   "o igual a 100%.";
        }

        if (seleccionados.Sum(item =>
                item.CantidadAporte) > 100)
        {
            return "La suma de los aportes químicos no puede superar 100%.";
        }

        if (formulario.HabilitadaEnmiendaCalcarea &&
            (formulario.Prnt <= 0 ||
             formulario.Prnt > 100))
        {
            return "El PRNT debe ser mayor a 0 y menor o igual a 100.";
        }

        return null;
    }

    private async Task DesactivarAsync(
        FuenteNutrienteAdminItemModel fuente)
    {
        bool confirmado =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"¿Desactivar la fuente {fuente.NombreNutriente}? " +
                "Los análisis históricos no serán eliminados.");

        if (!confirmado)
            return;

        try
        {
            await ApiClient.EliminarAsync(
                $"api/fuente-nutriente/eliminar/" +
                $"{fuente.FuenteNutrientesId}",
                cancellation.Token);

            MostrarMensaje(
                "Fuente desactivada correctamente.",
                false);

            await CargarActivasAsync(
                pagina.PaginaActual);
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"No fue posible desactivar la fuente. {ex.Message}",
                true);
        }
    }

    private async Task ReactivarAsync(
        FuenteNutrienteAdminItemModel fuente)
    {
        bool confirmado =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"¿Reactivar la fuente {fuente.NombreNutriente}?");

        if (!confirmado)
            return;

        try
        {
            await ApiClient.PutSinContenidoAsync(
                $"api/fuente-nutriente/reactivar/" +
                $"{fuente.FuenteNutrientesId}",
                cancellationToken:
