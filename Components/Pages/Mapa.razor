    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        referenciaDotNet = DotNetObjectReference.Create(this);

        await Task.WhenAll(
            CargarCatalogosAsync(),
            CargarCatalogoCapasAsync());

        await InicializarMapaAsync();
        await CargarMapaAsync();
    }

    private async Task InicializarMapaAsync()
    {
        if (mapaInicializado)
            return;

        await JS.InvokeVoidAsync(
            "conatradecMapaInteligente.inicializar",
            "mapaTerrenos",
            referenciaDotNet);

        mapaInicializado = true;
    }

    private async Task CargarCatalogosAsync()
    {
        try
        {
            municipios = await MapaService.ObtenerMunicipiosAsync();

            departamentos = municipios
                .GroupBy(item => new
                {
                    item.DepartamentoId,
                    item.NombreDepartamento
                })
                .Select(grupo => new CatalogoSimple
                {
                    Id = grupo.Key.DepartamentoId,
                    Nombre = grupo.Key.NombreDepartamento
                })
                .OrderBy(item => item.Nombre)
                .ToList();
        }
        catch
        {
            municipios = [];
            departamentos = [];
        }
    }

    private async Task CargarCatalogoCapasAsync()
    {
        try
        {
            catalogoCapas = await MapaService.ObtenerCapasAsync();

            if (catalogoCapas.Capas.Count == 0)
            {
                catalogoCapas.Capas = CrearCapasRespaldo().ToList();
            }
        }
        catch
        {
            catalogoCapas = new CentroGeoespacialCapasRespuesta
            {
                Capas = CrearCapasRespaldo().ToList()
            };
        }

        capasActivas.Clear();

        foreach (MapaCapaDisponible capa in catalogoCapas.Capas)
        {
            capasActivas[capa.Clave] =
                capa.Disponible && capa.ActivaPorDefecto;
        }
    }

    private async Task CargarMapaAsync()
    {
        cargando = true;
        error = null;
        StateHasChanged();

        try
        {
            respuesta = await MapaService.ObtenerMapaInteligenteAsync(filtro);
            ultimaActualizacion = DateTime.Now;

            await InicializarMapaAsync();
            await JS.InvokeVoidAsync(
                "conatradecMapaInteligente.mostrarTerrenos",
                "mapaTerrenos",
                respuesta.Terrenos,
                true);

            await AplicarFiltroTerritorialEnMapaAsync(
                ajustarVista: true);

            await JS.InvokeVoidAsync(
                "conatradecMapaInteligente.aplicarCapas",
                "mapaTerrenos",
                capasActivas);

            await RecargarCapasSueloActivasAsync();
        }
        catch (Exception ex)
        {
            error = $"No fue posible cargar los terrenos. {ex.Message}";
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarClimaAsync(bool forzarActualizacion = false)
    {
        if (cargandoClima)
            return;

        cargandoClima = true;
        errorClima = null;
        StateHasChanged();

        try
        {
            climaNacional = await MapaService
                .ObtenerClimaAsync(forzarActualizacion);
            clima = climaNacional;
            climaConsultado = true;

            if (!climaNacional.Disponible)
                errorClima = climaNacional.Mensaje;

            await JS.InvokeVoidAsync(
                "conatradecMapaInteligente.mostrarClima",
                "mapaTerrenos",
                climaNacional);

            await AplicarFiltroTerritorialEnMapaAsync(
                ajustarVista: false);

            await JS.InvokeVoidAsync(
                "conatradecMapaInteligente.aplicarCapas",
                "mapaTerrenos",
                capasActivas);
        }
        catch (Exception ex)
        {
            errorClima =
                $"No fue posible cargar las capas meteorológicas. {ex.Message}";
        }
        finally
        {
            cargandoClima = false;
            StateHasChanged();
        }
    }

    private async Task AplicarFiltroTerritorialEnMapaAsync(
        bool ajustarVista)
    {
        if (!mapaInicializado)
            return;

        string departamento =
            DepartamentoSeleccionado?.Nombre ?? string.Empty;
        string municipio =
            MunicipioSeleccionado?.NombreMunicipio ?? string.Empty;

        ClimaMapaRespuesta? climaFiltrado =
            await JS.InvokeAsync<ClimaMapaRespuesta?>(
                "conatradecMapaInteligente.aplicarFiltroTerritorial",
                "mapaTerrenos",
                departamento,
                municipio,
                ajustarVista);

        if (!climaConsultado)
            return;

        clima = climaFiltrado ?? climaNacional;

        if (clima.Disponible)
        {
            errorClima = null;
        }
        else if (string.IsNullOrWhiteSpace(errorClima))
        {
            errorClima = clima.Mensaje;
        }
    }

    private async Task CargarCapaSueloAsync(
        string clave,
        bool forzarActualizacion = false)
    {
        if (string.IsNullOrWhiteSpace(clave) ||
            cargandoCapaSuelo == clave)
        {
            return;
        }

        string cacheKey = CrearClaveCacheSuelo(clave);
        errorSuelo = null;
        cargandoCapaSuelo = clave;
        StateHasChanged();

        try
        {
            if (!forzarActualizacion &&
                capasSueloCache.TryGetValue(
                    cacheKey,
                    out CapaSueloMapaRespuesta? almacenada))
            {
                await MostrarCapaSueloAsync(almacenada);
                return;
            }

            CapaSueloMapaRespuesta capa = await MapaService
                .ObtenerCapaSueloAsync(
                    clave,
                    filtro.DepartamentoId,
                    filtro.MunicipioId);

            if (!capa.Disponible)
            {
                errorSuelo = capa.Mensaje;
                return;
            }

            capasSueloCache[cacheKey] = capa;
            await MostrarCapaSueloAsync(capa);
        }
        catch (Exception ex)
        {
            errorSuelo =
                $"No fue posible cargar la capa de suelo. {ex.Message}";
        }
        finally
        {
            cargandoCapaSuelo = null;
            StateHasChanged();
        }
    }

    private async Task MostrarCapaSueloAsync(
        CapaSueloMapaRespuesta capa)
    {
        capaSueloActiva = capa;

        await JS.InvokeVoidAsync(
            "conatradecMapaInteligente.mostrarCapaSuelo",
            "mapaTerrenos",
            capa);
    }

    private async Task RecargarCapasSueloActivasAsync()
    {
        string? activa = CapasDisponibles
            .Where(item =>
                item.Categoria.Equals(
                    "SUELOS",
                    StringComparison.OrdinalIgnoreCase))
            .Select(item => item.Clave)
            .FirstOrDefault(CapaActiva);

        if (!string.IsNullOrWhiteSpace(activa))
            await CargarCapaSueloAsync(activa, true);
    }

    private string CrearClaveCacheSuelo(string clave) =>
        $"{clave}|{filtro.DepartamentoId?.ToString() ?? "0"}|" +
        $"{filtro.MunicipioId?.ToString() ?? "0"}";

