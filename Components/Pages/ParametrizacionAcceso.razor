@code {
    private bool cargando;
    private bool esError;
    private bool formularioVisible;
    private bool cargandoDetalle;
    private string mensaje = string.Empty;
    private string buscarPropietario = string.Empty;
    private string tab = "PROPIETARIOS";

    private List<PropietarioAccesoItem> propietarios = [];
    private List<UsuarioAccesoCatalogo> usuarios = [];
    private List<TerrenoAccesoCatalogo> terrenos = [];
    private List<DepartamentoAccesoCatalogo> departamentos = [];
    private List<MunicipioAccesoCatalogo> municipios = [];
    private List<AsignacionTerrenoItem> asignaciones = [];
    private List<CoberturaTerritorialItem> coberturas = [];

    private PropietarioAccesoFormulario formulario = new();
    private PropietarioDetalleRespuesta? detalleSeleccionado;

    private int terrenoParaPropietarioId;
    private int usuarioPortalId;
    private int propietarioPortalId;
    private AsignarUsuarioTerrenoRequest nuevaAsignacion = new();
    private GuardarCoberturaTerritorialRequest nuevaCobertura = new();

    private bool PuedeLeerPropietarios =>
        AuthState.TienePermisoLectura(PermisosWeb.Propietarios);

    private bool PuedeAgregarPropietarios =>
        AuthState.TienePermisoAgregar(PermisosWeb.Propietarios);

    private bool PuedeActualizarPropietarios =>
        AuthState.TienePermisoActualizar(PermisosWeb.Propietarios);

    private bool PuedeEliminarPropietarios =>
        AuthState.TienePermisoEliminar(PermisosWeb.Propietarios);

    private bool PuedeGuardarPropietario =>
        formulario.PropietarioId > 0
            ? PuedeActualizarPropietarios
            : PuedeAgregarPropietarios;

    private bool PuedeLeerVinculaciones =>
        AuthState.TienePermisoLectura(PermisosWeb.UsuarioPropietario);

    private bool PuedeGuardarVinculacion =>
        AuthState.TienePermisoAgregar(PermisosWeb.UsuarioPropietario) ||
        AuthState.TienePermisoActualizar(PermisosWeb.UsuarioPropietario);

    private bool PuedeEliminarVinculacion =>
        AuthState.TienePermisoEliminar(PermisosWeb.UsuarioPropietario);

    private bool PuedeLeerAsignaciones =>
        AuthState.TienePermisoLectura(PermisosWeb.AsignacionTerreno);

    private bool PuedeAgregarAsignaciones =>
        AuthState.TienePermisoAgregar(PermisosWeb.AsignacionTerreno);

    private bool PuedeEliminarAsignaciones =>
        AuthState.TienePermisoEliminar(PermisosWeb.AsignacionTerreno);

    private bool PuedeLeerCoberturas =>
        AuthState.TienePermisoLectura(PermisosWeb.CoberturaTerritorial);

    private bool PuedeAgregarCoberturas =>
        AuthState.TienePermisoAgregar(PermisosWeb.CoberturaTerritorial);

    private bool PuedeEliminarCoberturas =>
        AuthState.TienePermisoEliminar(PermisosWeb.CoberturaTerritorial);

    private bool PuedeVerModulo =>
        PuedeLeerPropietarios ||
        PuedeLeerVinculaciones ||
        PuedeLeerAsignaciones ||
        PuedeLeerCoberturas;

    protected override async Task OnInitializedAsync()
    {
        if (!PuedeLeerPropietarios)
        {
            tab = PuedeLeerVinculaciones
                ? "PORTAL"
                : PuedeLeerAsignaciones
                    ? "ASIGNACIONES"
                    : "COBERTURAS";
        }

        await CargarTodoAsync();
    }

    private void CambiarTab(string valor)
    {
        tab = valor;
        LimpiarMensaje();
    }

    private async Task CargarTodoAsync()
    {
        if (!PuedeVerModulo)
            return;

        cargando = true;
        LimpiarMensaje();

        try
        {
            Task<List<PropietarioAccesoItem>?> propietariosTask =
                PuedeLeerPropietarios || PuedeLeerVinculaciones
                    ? Servicio.ListarPropietariosAsync(
                        incluirInactivos: false)
                    : Task.FromResult<List<PropietarioAccesoItem>?>([]);

            Task<List<UsuarioAccesoCatalogo>?> usuariosTask =
                Servicio.ListarUsuariosAsync();

            Task<List<TerrenoAccesoCatalogo>?> terrenosTask =
                Servicio.ListarTerrenosAsync();

            Task<List<DepartamentoAccesoCatalogo>?> departamentosTask =
                Servicio.ListarDepartamentosAsync();

            await Task.WhenAll(
                propietariosTask,
                usuariosTask,
                terrenosTask,
                departamentosTask);

            propietarios = propietariosTask.Result ?? [];
            usuarios = usuariosTask.Result ?? [];
            terrenos = terrenosTask.Result ?? [];
            departamentos = departamentosTask.Result ?? [];

            if (PuedeLeerAsignaciones)
                asignaciones = await Servicio.ListarAsignacionesAsync() ?? [];

            if (PuedeLeerCoberturas)
                coberturas = await Servicio.ListarCoberturasAsync() ?? [];
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarPropietariosAsync()
    {
        try
        {
            propietarios =
                await Servicio.ListarPropietariosAsync(
                    buscarPropietario,
                    incluirInactivos: false) ?? [];
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private void NuevoPropietario()
    {
        if (!PuedeAgregarPropietarios)
            return;

        formulario = new PropietarioAccesoFormulario
        {
            Activo = true
        };

        formularioVisible = true;
        detalleSeleccionado = null;
        terrenoParaPropietarioId = 0;
        LimpiarMensaje();
    }

    private void EditarPropietario(PropietarioAccesoItem item)
    {
        if (!PuedeActualizarPropietarios)
            return;

        detalleSeleccionado = null;
        terrenoParaPropietarioId = 0;
        formulario = CrearFormulario(item);
        formularioVisible = true;
        LimpiarMensaje();
    }

    private void EditarPropietarioDesdeDetalle()
    {
        if (detalleSeleccionado is null)
            return;

        PropietarioAccesoItem propietario =
            detalleSeleccionado.Propietario;

        EditarPropietario(propietario);
    }

    private async Task VerPropietarioAsync(PropietarioAccesoItem item)
    {
        formularioVisible = false;
        formulario = new();
        detalleSeleccionado = null;
        terrenoParaPropietarioId = 0;
        cargandoDetalle = true;
        LimpiarMensaje();

        try
        {
            PropietarioDetalleRespuesta? detalle =
                await Servicio.ObtenerPropietarioAsync(
                    item.PropietarioId);

            if (detalle is null)
            {
                MostrarError(
                    "No fue posible cargar el detalle del propietario.");
                return;
            }

            detalleSeleccionado = detalle;
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
        finally
        {
            cargandoDetalle = false;
        }
    }

    private async Task GuardarPropietarioAsync()
    {
        if (!PuedeGuardarPropietario)
            return;

        cargando = true;
        LimpiarMensaje();

        try
        {
            /*
             * Activo no es un campo administrable desde la interfaz.
             * Crear y editar conservan el registro activo.
             */
            formulario.Activo = true;

            ApiOperacionAccesoRespuesta? respuesta =
                formulario.PropietarioId > 0
                    ? await Servicio.ActualizarPropietarioAsync(formulario)
                    : await Servicio.CrearPropietarioAsync(formulario);

            if (respuesta?.Success == false)
            {
                MostrarError(respuesta.Message);
                return;
            }

            MostrarExito(
                respuesta?.Message ??
                "Operación realizada correctamente.");

            CancelarFormulario();
            await CargarPropietariosAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task EliminarPropietarioAsync(PropietarioAccesoItem item)
    {
        if (!PuedeEliminarPropietarios)
            return;

        if (item.TotalTerrenos > 0)
        {
            await VerPropietarioAsync(item);

            MostrarError(
                "No se puede eliminar el propietario porque tiene terrenos " +
                "vinculados. Reasigne los terrenos a otro propietario antes " +
                "de continuar.");

            return;
        }

        bool confirmar =
            await JS.InvokeAsync<bool>(
                "confirm",
                $"¿Desea eliminar a {item.NombreCompleto}? " +
                "El registro se desactivará y su historial se conservará.");

        if (!confirmar)
            return;

        cargando = true;
        LimpiarMensaje();

        try
        {
            await Servicio.EliminarPropietarioAsync(item.PropietarioId);

            if (detalleSeleccionado?.Propietario.PropietarioId ==
                item.PropietarioId)
            {
                detalleSeleccionado = null;
            }

            propietarios.RemoveAll(x =>
                x.PropietarioId == item.PropietarioId);

            MostrarExito("Propietario eliminado correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task VincularTerrenoAsync()
    {
        if (detalleSeleccionado is null ||
            terrenoParaPropietarioId <= 0)
        {
            return;
        }

        try
        {
            await Servicio.VincularTerrenoAsync(
                detalleSeleccionado.Propietario.PropietarioId,
                terrenoParaPropietarioId);

            detalleSeleccionado =
                await Servicio.ObtenerPropietarioAsync(
                    detalleSeleccionado.Propietario.PropietarioId);

            terrenoParaPropietarioId = 0;
            MostrarExito("Terreno vinculado correctamente.");
            await CargarPropietariosAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task DesvincularTerrenoAsync(
        TerrenoPropietarioItem terreno)
    {
        if (detalleSeleccionado is null)
            return;

        try
        {
            int propietarioId =
                detalleSeleccionado.Propietario.PropietarioId;

            await Servicio.DesvincularTerrenoAsync(
                propietarioId,
                terreno.TerrenoId);

            detalleSeleccionado =
                await Servicio.ObtenerPropietarioAsync(propietarioId);

            MostrarExito("Terreno desvinculado correctamente.");
            await CargarPropietariosAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task VincularUsuarioPropietarioAsync()
    {
        try
        {
            await Servicio.VincularUsuarioPropietarioAsync(
                usuarioPortalId,
                propietarioPortalId);

            usuarioPortalId = 0;
            propietarioPortalId = 0;
            MostrarExito("Usuario vinculado correctamente.");
            await CargarPropietariosAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task DesvincularUsuarioAsync(
        PropietarioAccesoItem propietario)
    {
        if (!propietario.UsuarioPortalId.HasValue)
            return;

        try
        {
            await Servicio.DesvincularUsuarioPropietarioAsync(
                propietario.UsuarioPortalId.Value);

            MostrarExito("Usuario desvinculado correctamente.");
            await CargarPropietariosAsync();
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task CrearAsignacionAsync()
    {
        if (nuevaAsignacion.UsuarioId <= 0 ||
            nuevaAsignacion.TerrenoId <= 0)
        {
            MostrarError("Seleccione usuario y terreno.");
            return;
        }

        try
        {
            await Servicio.CrearAsignacionAsync(nuevaAsignacion);
            nuevaAsignacion = new();
            asignaciones = await Servicio.ListarAsignacionesAsync() ?? [];
            MostrarExito("Asignación creada correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task EliminarAsignacionAsync(
        AsignacionTerrenoItem item)
    {
        try
        {
            await Servicio.EliminarAsignacionAsync(
                item.UsuarioTerrenoAsignacionId);

            asignaciones = await Servicio.ListarAsignacionesAsync() ?? [];
            MostrarExito("Asignación desactivada.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task DepartamentoCoberturaCambiadoAsync(
        ChangeEventArgs args)
    {
        nuevaCobertura.DepartamentoId =
            int.TryParse(args.Value?.ToString(), out int departamentoId)
                ? departamentoId
                : null;

        nuevaCobertura.MunicipioId = null;

        municipios = nuevaCobertura.DepartamentoId.HasValue
            ? await Servicio.ListarMunicipiosAsync(
                nuevaCobertura.DepartamentoId) ?? []
            : [];
    }

    private async Task CrearCoberturaAsync()
    {
        if (nuevaCobertura.UsuarioId <= 0)
        {
            MostrarError("Seleccione un usuario.");
            return;
        }

        try
        {
            await Servicio.CrearCoberturaAsync(nuevaCobertura);
            nuevaCobertura = new();
            municipios = [];
            coberturas = await Servicio.ListarCoberturasAsync() ?? [];
            MostrarExito("Cobertura creada correctamente.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private async Task EliminarCoberturaAsync(
        CoberturaTerritorialItem item)
    {
        try
        {
            await Servicio.EliminarCoberturaAsync(
                item.UsuarioCoberturaTerritorialId);

            coberturas = await Servicio.ListarCoberturasAsync() ?? [];
            MostrarExito("Cobertura desactivada.");
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
    }

    private void CancelarFormulario()
    {
        formulario = new();
        formularioVisible = false;
    }

    private void CerrarDetalle()
    {
        detalleSeleccionado = null;
        terrenoParaPropietarioId = 0;
        cargandoDetalle = false;
    }

    private static PropietarioAccesoFormulario CrearFormulario(
        PropietarioAccesoItem item) =>
        new()
        {
            PropietarioId = item.PropietarioId,
            Identificacion = item.Identificacion,
            NombreCompleto = item.NombreCompleto,
            Telefono = item.Telefono,
            Correo = item.Correo,
            Direccion = item.Direccion,
            Activo = true
        };

    private string ClaseTab(string valor) =>
        tab == valor ? "active" : string.Empty;

    private static string Iniciales(string nombre)
    {
        string[] partes = nombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return string.Concat(
            partes.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }

    private void MostrarError(string texto)
    {
        esError = true;
        mensaje = texto;
    }

    private void MostrarExito(string texto)
    {
        esError = false;
        mensaje = texto;
    }

    private void LimpiarMensaje()
    {
        esError = false;
        mensaje = string.Empty;
    }
}
