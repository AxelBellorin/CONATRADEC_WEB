@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          crossorigin="" />

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.css" />

    <link rel="stylesheet"
          href="css/app.css" />

    <link rel="stylesheet"
          href="css/dashboard-ejecutivo.css" />

    <link rel="stylesheet"
          href="css/mapa-alertas.css?v=2.4.0" />

    <link rel="stylesheet"
          href="css/seguridad-web.css" />

    <link rel="stylesheet"
          href="css/parametrizacion-acceso.css" />

    <link rel="stylesheet"
          href="css/portal-propietario.css?v=1.0.0" />

    <link rel="stylesheet"
          href="css/portal-centro-geoespacial.css?v=3.0.0" />

    <link rel="stylesheet"
          href="css/mapa-panel-compacto.css?v=1.4.0" />

    <link rel="stylesheet"
          href="css/animations.css?v=1.0.0" />

    <link rel="stylesheet"
          href="css/pronostico-clima.css?v=1.2.0" />

    <link rel="stylesheet"
          href="css/clima-labores.css?v=1.0.0" />

    <link rel="stylesheet"
          href="css/terreno-poligonos.css?v=1.0.0" />

    <link rel="stylesheet"
          href="css/resumen-territorial-mapa.css?v=2.0.0" />

    <!--
        Geología se carga después del resumen territorial para evitar que
        su tarjeta de estado cubra los controles flotantes del mapa.
    -->
    <link rel="stylesheet"
          href="css/geologia-mapa.css?v=1.6.0" />

    <link rel="stylesheet"
          href="css/resumen-territorial-enriquecido.css?v=1.1.0" />

    <link rel="stylesheet"
          href="css/mapa-relaciones-analisis.css?v=1.1.0" />

    <link rel="stylesheet"
          href="css/mapa-paneles-movibles.css?v=2.2.0" />

    <link rel="stylesheet"
          href="CONATRADEC.AdminWeb.styles.css" />

    <!--
        Distribución fluida global para todas las páginas administrativas.
        Se carga al final para reemplazar los anchos máximos anteriores.
    -->
    <link rel="stylesheet"
          href="css/responsive-layout.css?v=1.1.0" />

    <link rel="icon"
          type="image/svg+xml"
          href="favicon.svg" />

    <HeadOutlet
        @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes
        @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <script src="js/session-inactivity.js"></script>
    <script src="_framework/blazor.web.js"></script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            crossorigin="">
    </script>

    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js">
    </script>

    <script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js">
    </script>

    <script src="https://unpkg.com/leaflet-draw@1.0.4/dist/leaflet.draw.js">
    </script>

    <script src="js/mapa.js"></script>
    <script src="js/dispositivosMapa.js"></script>
    <script src="js/mapaInteligente.js?v=2.4.1"></script>
    <script src="js/mapaInteligenteMejoras.js?v=1.2.0"></script>

    <!--
        Turf genera el corredor geográfico alrededor de las fallas.
        Se fija la versión para evitar cambios inesperados del proveedor.
    -->
    <script src="https://cdn.jsdelivr.net/npm/@@turf/turf@@7.3.0/turf.min.js"></script>

    <!--
        Capas exclusivamente informativas: fallas geológicas y volcanes.
        Se carga después del mapa inteligente para extenderlo sin cambiar
        la lógica agrícola, de suelo o de clima existente.
    -->
    <script src="js/geologiaMapa.js?v=1.6.0"></script>

    <!--
        El punto continúa siendo dibujado por el mapa actual.
        Estas capas agregan únicamente el polígono cuando existe.
    -->
    <script src="js/terrenoPoligonosMapa.js?v=1.0.0"></script>
    <script src="js/terrenoPoligonoEditor.js?v=1.0.0"></script>

    <!--
        Resumen automático por departamento o municipio cuando la capa
        de terrenos individuales está desactivada.
    -->
    <script src="js/resumenTerritorialMapa.js?v=2.0.0"></script>

    <!--
        Enriquece la ficha departamental y municipal con clima,
        elementos químicos y contexto geológico.
    -->
    <script src="js/resumenTerritorialEnriquecido.js?v=1.1.0"></script>

    <!--
        Mapa de relaciones de análisis.
        Utiliza solamente Cytoscape.js y su diseño jerárquico incorporado.
        No depende de Dagre ni de complementos externos de distribución.
    -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.33.1/cytoscape.min.js"></script>
    <script src="js/mapaRelacionesAnalisis.js?v=1.1.1"></script>

    <!--
        Pantalla completa con filtros disponibles y paneles movibles.
        Debe cargarse después de mapaInteligente.js.
    -->
    <script src="js/mapaPanelesMovibles.js?v=2.1.0"></script>

    <script src="js/climaLaboresTimeline.js?v=1.0.0"></script>
</body>
</html>
