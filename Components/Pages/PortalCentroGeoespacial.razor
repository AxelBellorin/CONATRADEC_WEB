    private async Task SeleccionarCapaClimaAsync(string clave)
    {
        foreach (string capa in ClavesClima)
            capasActivas[capa] = false;

        capaClimaActiva = clave;
        capasActivas[clave] = true;
        capaSueloActiva = string.Empty;
        DesactivarCapasSuelo();

        await JS.InvokeVoidAsync(
            "conatradecMapaInteligente.mostrarClima",
            "mapaTerrenosPropietario",
            climaNacional);

        await AplicarFiltroTerritorialEnMapaAsync(false);

        await JS.InvokeVoidAsync(
            "conatradecMapaInteligente.aplicarCapas",
            "mapaTerrenosPropietario",
            capasActivas);
    }

