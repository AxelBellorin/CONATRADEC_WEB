@page "/login"
@implements IAsyncDisposable
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Iniciar sesión | CONATRADEC</PageTitle>

<div class="@ClasePagina">
    <section class="login-visual">
        <div class="login-visual-content">
            <div class="login-copy">
                <div class="login-logo">
                    <i class="fa-solid fa-seedling"></i>
                </div>

                <p class="eyebrow">CONATRADEC</p>

                <h1>
                    Gestión agrícola en una sola plataforma
                </h1>

                <p>
                    Supervisa terrenos, análisis de suelo,
                    indicadores y actividad administrativa
                    desde cualquier computadora.
                </p>

                <div class="login-feature-list">
                    <span>
                        <i class="fa-solid fa-chart-pie"></i>
                        Indicadores consolidados
                    </span>

                    <span>
                        <i class="fa-solid fa-map"></i>
                        Mapa dinámico de terrenos
                    </span>

                    <span>
                        <i class="fa-solid fa-shield-halved"></i>
                        Acceso por permisos
                    </span>
                </div>
            </div>

            <div class="login-mascot-stage"
                 aria-hidden="true">
                <span class="mascot-glow"></span>
                <span class="coffee-bean bean-one"></span>
                <span class="coffee-bean bean-two"></span>
                <span class="coffee-bean bean-three"></span>

                <img class="login-mascot"
                     src="images/mascota-conatradec.webp"
                     width="720"
                     height="734"
                     alt="" />

                <span class="mascot-ground-shadow"></span>

                <div class="login-mascot-greeting login-mascot-greeting-desktop"
                     aria-hidden="true">
                    <span class="login-mascot-greeting-glow"></span>
                    <span class="login-bean-text">Bienvenido</span>
                </div>
            </div>
        </div>
    </section>

    <section class="login-panel">
        <div class="login-card">
            <div class="login-card-header">
                <span class="mobile-logo mobile-mascot-logo">
                    <img src="images/mascota-conatradec.webp"
                         width="720"
                         height="734"
                         alt="Mascota de CONATRADEC" />
                </span>

                <div class="login-mascot-greeting login-mascot-greeting-mobile"
                     aria-hidden="true">
                    <span class="login-mascot-greeting-glow"></span>
                    <span class="login-bean-text">Bienvenido</span>
                </div>

                <p class="eyebrow">
                    Portal administrativo
                </p>

                <h2>@saludo</h2>

                <p>
                    Utiliza las mismas credenciales
                    de CONATRADEC.
                </p>
            </div>

            <EditForm Model="@modelo"
                      OnValidSubmit="IniciarSesionAsync"
                      FormName="login-form">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-error"
                         role="alert"
                         aria-live="polite">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@error</span>
                    </div>
                }

                <div class="form-group login-field-user">
                    <label for="usuario">
                        Usuario o correo
                    </label>

                    <div class="input-with-icon">
                        <i class="fa-regular fa-user"></i>

                        <InputText id="usuario"
                                   name="username"
                                   class="form-control"
                                   autocomplete="username"
                                   disabled="@procesando"
                                   @oninput="LimpiarEstadoAlEditarAsync"
                                   @bind-Value="modelo.UsuarioOEmail"
                                   placeholder="Escribe tu usuario o correo" />
                    </div>

                    <ValidationMessage
                        For="() => modelo.UsuarioOEmail" />
                </div>

                <div class="form-group login-field-password">
                    <label for="clave">
                        Contraseña
                    </label>

                    <div class="input-with-icon login-password-wrapper">
                        <i class="fa-solid fa-lock"></i>

                        <InputText id="clave"
                                   name="password"
                                   type="@TipoCampoClave"
                                   class="form-control"
                                   autocomplete="current-password"
                                   disabled="@procesando"
                                   @oninput="LimpiarEstadoAlEditarAsync"
                                   @bind-Value="modelo.Clave"
                                   placeholder="Escribe tu contraseña" />

                        <button type="button"
                                class="login-password-toggle"
                                disabled="@procesando"
                                aria-label="@TextoBotonClave"
                                aria-pressed="@mostrarClave"
                                title="@TextoBotonClave"
                                @onclick="AlternarVisualizacionClave">
                            <i class="fa-solid @IconoClave"></i>
                        </button>
                    </div>

                    <ValidationMessage
                        For="() => modelo.Clave" />
                </div>

                <div class="login-options">
                    <label class="login-remember">
                        <InputCheckbox
                            disabled="@procesando"
                            @bind-Value="recordarUsuario" />

                        <span>Recordar usuario</span>
                    </label>

                    <span class="login-password-safety">
                        <i class="fa-solid fa-shield-halved"></i>
                        La contraseña no se guarda aquí
                    </span>
                </div>

                <button type="submit"
                        class="@ClaseBotonLogin"
                        disabled="@procesando">
                    @if (accesoConcedido)
                    {
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Acceso concedido</span>
                    }
                    else if (procesando)
                    {
                        <span class="spinner"></span>
                        <span>Validando...</span>
                    }
                    else if (autenticacionFallida)
                    {
                        <i class="fa-solid fa-rotate-right"></i>
                        <span>Intentar nuevamente</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        <span>Iniciar sesión</span>
                    }
                </button>
            </EditForm>

            <div class="login-note">
                <i class="fa-solid fa-circle-info"></i>

                <span>
                    El acceso y las opciones dependen
                    de tu rol y permisos.
                </span>
            </div>
        </div>
    </section>
</div>

@code {
    private readonly LoginRequest modelo = new();

    private bool procesando;
    private bool mostrarClave;
    private bool recordarUsuario;
    private bool accesoConcedido;
    private bool autenticacionFallida;
    private string saludo = "Bienvenido";
    private string? error;

    private string TipoCampoClave =>
        mostrarClave
            ? "text"
            : "password";

    private string IconoClave =>
        mostrarClave
            ? "fa-eye-slash"
            : "fa-eye";

    private string TextoBotonClave =>
        mostrarClave
            ? "Ocultar contraseña"
            : "Mostrar contraseña";

    private string ClasePagina =>
        $"login-page{(procesando ? " is-processing" : string.Empty)}" +
        $"{(autenticacionFallida ? " has-error" : string.Empty)}" +
        $"{(accesoConcedido ? " has-success" : string.Empty)}";

    private string ClaseBotonLogin =>
        "btn-primary btn-block login-submit" +
        (accesoConcedido
            ? " is-success"
            : autenticacionFallida
                ? " is-error"
                : string.Empty);

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            HoraLocalNavegadorWeb? contexto =
                await JS.InvokeAsync<HoraLocalNavegadorWeb>(
                    "conatradecBrowser.getLocalTimeInfo");

            if (contexto is not null)
            {
                saludo = string.IsNullOrWhiteSpace(
                    contexto.Saludo)
                        ? "Bienvenido"
                        : contexto.Saludo;
            }

            string? usuarioRecordado =
                await JS.InvokeAsync<string?>(
                    "conatradecBrowser.getRememberedLogin");

            if (!string.IsNullOrWhiteSpace(
                    usuarioRecordado))
            {
                modelo.UsuarioOEmail =
                    usuarioRecordado.Trim();

                recordarUsuario = true;
            }
        }
        catch
        {
            /*
             * El formulario continúa funcionando aunque el navegador no
             * permita consultar su administrador de contraseñas.
             */
        }

        try
        {
            await JS.InvokeVoidAsync(
                "conatradecCoffeeTrail.init",
                ".login-page");
        }
        catch
        {
            /*
             * El mensaje animado es decorativo. Un navegador sin soporte
             * para la animación no debe impedir que el usuario inicie sesión.
             */
        }

        await InvokeAsync(StateHasChanged);
    }

    private void AlternarVisualizacionClave()
    {
        if (!procesando)
            mostrarClave = !mostrarClave;
    }

    private async Task IniciarSesionAsync()
    {
        if (procesando)
            return;

        procesando = true;
        accesoConcedido = false;
        autenticacionFallida = false;
        error = null;

        await LimpiarMensajeMascotaAsync();

        try
        {
            ResultadoOperacion resultado =
                await AuthState.IniciarSesionAsync(
                    modelo);

            if (!resultado.Exitoso)
            {
                autenticacionFallida = true;
                error =
                    "Usuario o contraseña incorrectos.";

                procesando = false;
                await InvokeAsync(StateHasChanged);

                await MostrarMensajeMascotaAsync(
                    "error");

                await EnfocarClaveAsync();
                return;
            }

            accesoConcedido = true;
            await InvokeAsync(StateHasChanged);

            await GuardarUsuarioRecordadoAsync();

            bool animacionMostrada =
                await MostrarMensajeMascotaAsync(
                    "success");

            if (animacionMostrada)
            {
                await Task.Delay(850);
            }

            Navigation.NavigateTo(
                "/",
                forceLoad: false,
                replace: true);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Error al iniciar sesión en el portal web: {ex}");

            autenticacionFallida = true;
            error =
                "No fue posible iniciar sesión. " +
                "Verifica tu conexión e intenta nuevamente.";

            procesando = false;
            await InvokeAsync(StateHasChanged);

            await MostrarMensajeMascotaAsync(
                "error");

            await EnfocarClaveAsync();
        }
        finally
        {
            if (!accesoConcedido)
                procesando = false;
        }
    }

    private async Task LimpiarEstadoAlEditarAsync(
        ChangeEventArgs _)
    {
        if (procesando ||
            (!autenticacionFallida &&
             string.IsNullOrWhiteSpace(error)))
        {
            return;
        }

        autenticacionFallida = false;
        error = null;

        await LimpiarMensajeMascotaAsync();
    }

    private async Task<bool> MostrarMensajeMascotaAsync(
        string resultado)
    {
        try
        {
            return await JS.InvokeAsync<bool>(
                "conatradecCoffeeTrail.show",
                resultado);
        }
        catch
        {
            /*
             * El mensaje de la mascota es decorativo. Si el navegador no
             * puede mostrarlo, el inicio de sesión continúa normalmente.
             */
            return false;
        }
    }

    private async Task LimpiarMensajeMascotaAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "conatradecCoffeeTrail.clear");
        }
        catch
        {
            /*
             * La limpieza visual no debe afectar el formulario.
             */
        }
    }

    private async Task EnfocarClaveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "conatradecCoffeeTrail.focusPassword");
        }
        catch
        {
            /*
             * El enfoque automático es una mejora de usabilidad opcional.
             */
        }
    }

    private async Task GuardarUsuarioRecordadoAsync()
    {
        try
        {
            if (recordarUsuario)
            {
                await JS.InvokeVoidAsync(
                    "conatradecBrowser.setRememberedLogin",
                    modelo.UsuarioOEmail);
            }
            else
            {
                await JS.InvokeVoidAsync(
                    "conatradecBrowser.clearRememberedLogin");
            }
        }
        catch
        {
            /*
             * El inicio de sesión ya fue correcto. Recordar el usuario es
             * opcional y nunca debe impedir la navegación.
             */
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync(
                "conatradecCoffeeTrail.dispose");
        }
        catch
        {
            /*
             * La conexión de Blazor puede haberse cerrado antes de que el
             * componente termine de liberarse.
             */
        }
    }
}
