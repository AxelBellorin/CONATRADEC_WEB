@page "/seguimiento-alertas"
@inject AuthStateService AuthState
@inject SeguimientoAlertasService Service
@inject NavigationManager Navigation

<PageTitle>
    Seguimiento de alertas | CONATRADEC
</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Gestión técnica</p>

        <h1>Seguimiento de alertas</h1>

        <p>
            Asigna responsables, documenta acciones
            y consulta el historial.
        </p>
    </div>

    <div class="page-header-actions">
        <a class="btn-secondary"
           href="/alertas-agricolas">
            <i class="fa-solid fa-triangle-exclamation"></i>
            Alertas detectadas
        </a>

        <button class="btn-primary"
                @onclick="Actualizar"
                disabled="@cargando">
            <i class="fa-solid fa-rotate"></i>
            Actualizar
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError
        ? "alert-error"
        : "alert-success")">
        @mensaje
    </div>
}

<section class="followup-summary-grid">
    <article>
        <span>Total</span>
        <strong>@resumen.Total</strong>
    </article>

    <article class="pending">
        <span>Pendientes</span>
        <strong>@resumen.Pendientes</strong>
    </article>

    <article class="progress">
        <span>En proceso</span>
        <strong>@resumen.EnProceso</strong>
    </article>

    <article class="closed">
        <span>Cerrados</span>
        <strong>@resumen.Cerradas</strong>
    </article>
</section>

<section class="panel followup-filters">
    <div class="form-group followup-search">
        <label>Buscar</label>

        <InputText class="form-control"
                   @bind-Value="buscar"
                   placeholder="Terreno, propietario, alerta o responsable" />
    </div>

    <div class="form-group">
        <label>Estado</label>

        <InputSelect class="form-control"
                     @bind-Value="estado">
            <option value="">Todos</option>
            <option value="PENDIENTE">Pendiente</option>
            <option value="EN_PROCESO">En proceso</option>
            <option value="ATENDIDA">Atendida</option>
            <option value="DESCARTADA">Descartada</option>
        </InputSelect>
    </div>

    <div class="form-group">
        <label>Responsable</label>

        <InputSelect class="form-control"
                     @bind-Value="responsableId">
            <option value="">Todos</option>
            <option value="0">Sin asignar</option>

            @foreach (TecnicoAlertaItem tecnico in tecnicos)
            {
                <option value="@tecnico.UsuarioId">
                    @tecnico.NombreCompleto
                </option>
            }
        </InputSelect>
    </div>

    <div class="followup-filter-actions">
        <button class="btn-primary"
                @onclick="AplicarFiltros"
                disabled="@cargando">
            Aplicar
        </button>

        <button class="btn-link"
                @onclick="LimpiarFiltros"
                disabled="@cargando">
            Limpiar
        </button>
    </div>
</section>

@if (cargando)
{
    <LoadingState Mensaje="Cargando seguimientos..." />
}
else if (seguimientos.Count == 0)
{
    <section class="panel followup-empty-state">
        <i class="fa-solid fa-clipboard-check"></i>
        <h2>No hay seguimientos para mostrar</h2>
        <p>
            No existen registros que coincidan con
            los filtros seleccionados.
        </p>
    </section>
}
else
{
    <section class="followup-grid">
        @foreach (SeguimientoAlertaItem item in seguimientos)
        {
            <article class="followup-card">
                <div class="followup-card-header">
                    <div>
                        <span class="executive-alert-badge @ClaseNivel(item.Nivel)">
                            @NivelTexto(item.Nivel)
                        </span>

                        <h3>@item.TipoAlerta</h3>
                    </div>

                    <span class="followup-status @ClaseEstado(item.Estado)">
                        @EstadoTexto(item.Estado)
                    </span>
                </div>

                <div class="followup-terrain">
                    <i class="fa-solid fa-seedling"></i>

                    <div>
                        <strong>@item.CodigoTerreno</strong>
                        <span>@item.Propietario</span>
                        <small>@item.Ubicacion</small>
                    </div>
                </div>

                <dl>
                    <div>
                        <dt>Responsable</dt>
                        <dd>
                            @(item.UsuarioAsignado ??
                              "Sin asignar")
                        </dd>
                    </div>

                    <div>
                        <dt>Creado</dt>
                        <dd>
                            @FormatearFecha(item.FechaCreacionUtc)
                        </dd>
                    </div>

                    <div>
                        <dt>Último cambio</dt>
                        <dd>
                            @FormatearFecha(item.FechaUltimaModificacionUtc)
                        </dd>
                    </div>
                </dl>

                <p class="followup-card-observation">
                    @(string.IsNullOrWhiteSpace(item.Observacion)
                        ? "Sin observaciones."
                        : item.Observacion)
                </p>

                <button class="btn-secondary"
                        @onclick="() => Editar(item)">
                    <i class="fa-solid @(PuedeActualizar
                        ? "fa-pen-to-square"
                        : "fa-clock-rotate-left")"></i>
                    @(PuedeActualizar
                        ? "Gestionar e historial"
                        : "Ver historial")
                </button>
            </article>
        }
    </section>

    <Paginador Pagina="pagina"
               TotalPaginas="totalPaginas"
               TotalRegistros="totalRegistros"
               TamanoPagina="tamanoPagina"
               Procesando="cargando"
               PaginaCambiada="CambiarPagina"
               TamanoPaginaCambiado="CambiarTamanoPagina" />
}

@if (editando is not null)
{
    <div class="modal-backdrop">
        <div class="modal-card modal-card-large">
            <div class="modal-header">
                <div>
                    <h2>Seguimiento técnico</h2>
                    <p>
                        @editando.TipoAlerta ·
                        @editando.CodigoTerreno
                    </p>
                </div>

                <button class="modal-close"
                        @onclick="CerrarModal">
                    ×
                </button>
            </div>

            <div class="followup-detail-summary">
                <div>
                    <span>Terreno</span>
                    <strong>@editando.CodigoTerreno</strong>
                    <small>@editando.Propietario</small>
                </div>

                <div>
                    <span>Ubicación</span>
                    <strong>@editando.Ubicacion</strong>
                    <small>@editando.Direccion</small>
                </div>

                <div>
                    <span>Fecha de apertura</span>
                    <strong>
                        @FormatearFecha(editando.FechaCreacionUtc)
                    </strong>
                </div>
            </div>

            <EditForm Model="@formulario"
                      OnValidSubmit="Guardar">
                <DataAnnotationsValidator />

                <div class="followup-form-grid">
                    <div class="form-group">
                        <label>Estado</label>

                        <InputSelect class="form-control"
                                     @bind-Value="formulario.Estado"
                                     disabled="@(!PuedeActualizar)">
                            <option value="PENDIENTE">
                                Pendiente
                            </option>

                            <option value="EN_PROCESO">
                                En proceso
                            </option>

                            <option value="ATENDIDA">
                                Atendida
                            </option>

                            <option value="DESCARTADA">
                                Descartada
                            </option>
                        </InputSelect>
                    </div>

                    <div class="form-group">
                        <label>Técnico responsable</label>

                        <InputSelect class="form-control"
                                     @bind-Value="formulario.UsuarioAsignadoId"
                                     disabled="@(!PuedeActualizar)">
                            <option value="">Sin asignar</option>

                            @foreach (TecnicoAlertaItem tecnico in tecnicos)
                            {
                                <option value="@tecnico.UsuarioId">
                                    @tecnico.Etiqueta
                                </option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="form-group">
                    <label>Observación técnica</label>

                    <InputTextArea
                        class="form-control followup-observation"
                        @bind-Value="formulario.Observacion"
                        disabled="@(!PuedeActualizar)" />

                    <div class="field-help">
                        @formulario.Observacion.Length / 1000 caracteres
                    </div>

                    <ValidationMessage
                        For="() => formulario.Observacion" />
                </div>

                @if (formulario.Estado is
                    "ATENDIDA" or "DESCARTADA")
                {
                    <div class="alert alert-info">
                        Al guardar este estado se registrará
                        la fecha de cierre del seguimiento.
                    </div>
                }

                <div class="modal-actions">
                    <button type="button"
                            class="btn-link"
                            @onclick="CerrarModal">
                        Cerrar
                    </button>

                    @if (PuedeActualizar)
                    {
                        <button type="submit"
                                class="btn-primary"
                                disabled="@guardando">
                            <i class="fa-solid fa-floppy-disk"></i>
                            Guardar cambios
                        </button>
                    }
                </div>
            </EditForm>

            <div class="followup-history-header">
                <div>
                    <h3>Historial</h3>
                    <p>
                        Registro cronológico de las acciones
                        realizadas.
                    </p>
                </div>

                @if (cargandoHistorial)
                {
                    <i class="fa-solid fa-spinner fa-spin"></i>
                }
            </div>

            <div class="timeline">
                @if (!cargandoHistorial &&
                     historial.Count == 0)
                {
                    <p>No hay movimientos registrados.</p>
                }

                @foreach (HistorialAlertaItem item in historial)
                {
                    <article class="timeline-item">
                        <div class="timeline-icon">
                            <i class="@IconoHistorial(item.Accion)"></i>
                        </div>

                        <div>
                            <strong>
                                @AccionTexto(item.Accion)
                            </strong>

                            <span>@item.Usuario</span>
                            <p>@item.Detalle</p>

                            <small>
                                @FormatearFecha(item.FechaUtc)
                            </small>
                        </div>
                    </article>
                }
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public int? SeguimientoId { get; set; }

    private List<SeguimientoAlertaItem> seguimientos = [];
    private List<TecnicoAlertaItem> tecnicos = [];
    private List<HistorialAlertaItem> historial = [];

    private SeguimientoAlertaItem? editando;
    private ActualizarSeguimientoAlerta formulario = new();
    private ResumenSeguimientoAlertas resumen = new();

    private string buscar = string.Empty;
    private string estado = string.Empty;
    private string responsableId = string.Empty;

    private int pagina = 1;
    private int tamanoPagina = 12;
    private int totalRegistros;
    private int totalPaginas;

    private bool cargando = true;
    private bool cargandoHistorial;
    private bool guardando;
    private bool enlaceProcesado;
    private bool tecnicosCargados;
    private string? mensaje;
    private bool esError;

    private bool PuedeActualizar =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoActualizar(
            PermisosWeb.SeguimientoAlertas);

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!AuthState.TienePermisoLectura(
                PermisosWeb.SeguimientoAlertas) &&
            !AuthState.EsAdministrador)
        {
            Navigation.NavigateTo("/");
            return;
        }

        await Cargar();

        if (SeguimientoId is > 0 &&
            !enlaceProcesado)
        {
            enlaceProcesado = true;

            SeguimientoAlertaItem? seleccionado =
                seguimientos.FirstOrDefault(item =>
                    item.SeguimientoAlertaAgricolaId ==
                    SeguimientoId.Value);

            seleccionado ??=
                await Service.ObtenerAsync(
                    SeguimientoId.Value);

            if (seleccionado != null)
                await Editar(seleccionado);
        }

        StateHasChanged();
    }

    private Task Actualizar() =>
        Cargar();

    private async Task Cargar(bool limpiarMensaje = true)
    {
        cargando = true;

        if (limpiarMensaje)
            mensaje = null;

        try
        {
            Task tecnicosTask = Task.CompletedTask;

            if (!tecnicosCargados)
                tecnicosTask = CargarTecnicos();

            Task paginaTask = CargarPagina();

            await Task.WhenAll(
                tecnicosTask,
                paginaTask);

            tecnicosCargados = true;
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarTecnicos() =>
        tecnicos = await Service.TecnicosAsync();

    private async Task CargarPagina()
    {
        SeguimientosPaginados resultado =
            await Service.ListarPaginadoAsync(
                pagina,
                tamanoPagina,
                buscar,
                estado,
                ObtenerResponsableId());

        seguimientos = resultado.Items;
        resumen = resultado.Resumen;
        pagina = resultado.Pagina <= 0 ? 1 : resultado.Pagina;
        tamanoPagina = resultado.TamanoPagina <= 0
            ? tamanoPagina
            : resultado.TamanoPagina;
        totalRegistros = resultado.TotalRegistros;
        totalPaginas = resultado.TotalPaginas;
    }

    private async Task AplicarFiltros()
    {
        pagina = 1;
        await Cargar();
    }

    private async Task LimpiarFiltros()
    {
        buscar = string.Empty;
        estado = string.Empty;
        responsableId = string.Empty;
        pagina = 1;
        await Cargar();
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        if (nuevaPagina == pagina || cargando)
            return;

        pagina = nuevaPagina;
        await Cargar();
    }

    private async Task CambiarTamanoPagina(int nuevoTamano)
    {
        tamanoPagina = nuevoTamano;
        pagina = 1;
        await Cargar();
    }

    private int? ObtenerResponsableId()
    {
        if (string.IsNullOrWhiteSpace(responsableId))
            return null;

        return int.TryParse(responsableId, out int valor)
            ? valor
            : null;
    }

    private async Task Editar(
        SeguimientoAlertaItem item)
    {
        editando = item;

        formulario = new ActualizarSeguimientoAlerta
        {
            Estado = item.Estado,
            UsuarioAsignadoId = item.UsuarioAsignadoId,
            Observacion = item.Observacion,
            UsuarioAccionId =
                AuthState.Usuario?.UsuarioId ?? 0
        };

        await CargarHistorial(
            item.SeguimientoAlertaAgricolaId);
    }

    private async Task CargarHistorial(int id)
    {
        cargandoHistorial = true;

        try
        {
            historial = await Service.HistorialAsync(id);
        }
        catch (Exception ex)
        {
            mensaje =
                $"No fue posible cargar el historial. {ex.Message}";

            esError = true;
            historial = [];
        }
        finally
        {
            cargandoHistorial = false;
        }
    }

    private void CerrarModal()
    {
        editando = null;
        historial = [];

        if (SeguimientoId.HasValue)
        {
            Navigation.NavigateTo(
                "/seguimiento-alertas",
                replace: true);
        }
    }

    private async Task Guardar()
    {
        if (editando is null)
            return;

        guardando = true;
        mensaje = null;

        try
        {
            SeguimientoAlertaItem? actualizado =
                await Service.ActualizarAsync(
                    editando.SeguimientoAlertaAgricolaId,
                    formulario);

            if (actualizado == null)
            {
                throw new InvalidOperationException(
                    "La API no devolvió el seguimiento actualizado.");
            }

            editando = actualizado;

            historial = await Service.HistorialAsync(
                actualizado.SeguimientoAlertaAgricolaId);

            mensaje =
                "Seguimiento actualizado correctamente.";

            esError = false;
            await Cargar(limpiarMensaje: false);
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            esError = true;
        }
        finally
        {
            guardando = false;
        }
    }

    private static string ClaseNivel(string nivel) =>
        nivel == "CRITICA"
            ? "critical"
            : nivel == "ATENCION"
                ? "attention"
                : "without-analysis";

    private static string NivelTexto(string nivel) =>
        nivel switch
        {
            "CRITICA" => "Crítica",
            "ATENCION" => "Atención",
            _ => "Sin análisis"
        };

    private static string ClaseEstado(string estado) =>
        estado
            .ToLowerInvariant()
            .Replace("_", "-");

    private static string EstadoTexto(string estado) =>
        estado switch
        {
            "EN_PROCESO" => "En proceso",
            "ATENDIDA" => "Atendida",
            "DESCARTADA" => "Descartada",
            _ => "Pendiente"
        };

    private static string AccionTexto(string accion) =>
        accion switch
        {
            "CREADA" => "Seguimiento creado",
            "ACTUALIZADA" => "Seguimiento actualizado",
            _ => accion
        };

    private static string IconoHistorial(string accion) =>
        accion switch
        {
            "CREADA" => "fa-solid fa-plus",
            "ACTUALIZADA" => "fa-solid fa-pen",
            _ => "fa-solid fa-circle"
        };

    private static string FormatearFecha(DateTime fecha) =>
        fecha
            .ToLocalTime()
            .ToString("dd/MM/yyyy hh:mm tt");
}
