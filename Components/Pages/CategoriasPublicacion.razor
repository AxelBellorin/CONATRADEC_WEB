@page "/contenido/tipos-publicacion"
@using System.ComponentModel.DataAnnotations
@inject AuthStateService AuthState
@inject ApiClientService Api
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Tipos de publicación | CONATRADEC</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Contenido y comunicación</p>
        <h1>Tipos de publicación</h1>
        <p>
            Administra las categorías utilizadas por noticias, eventos,
            ofertas y demás contenido institucional.
        </p>
    </div>

    <div class="page-header-actions">
        <a class="btn-secondary"
           href="/contenido/publicaciones">
            <i class="fa-solid fa-newspaper"></i>
            Publicaciones
        </a>

        @if (PuedeAgregar)
        {
            <button class="btn-primary"
                    @onclick="AbrirCrear">
                <i class="fa-solid fa-plus"></i>
                Nuevo tipo
            </button>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert alert-success-custom">
        <i class="fa-solid fa-circle-check"></i>
        <span>@mensaje</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@error</span>
    </div>
}

@if (!PuedeLeer)
{
    <section class="panel empty-state compact-empty">
        <i class="fa-solid fa-lock"></i>
        <h2>Sin permiso de lectura</h2>
        <p>
            Su rol no puede consultar los tipos de publicación.
        </p>
    </section>
}
else
{
    <section class="panel toolbar-panel">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input class="form-control"
                   placeholder="Buscar por nombre o descripción"
                   @bind="buscar"
                   @bind:event="oninput" />
        </div>

        <label class="album-check">
            <InputCheckbox @bind-Value="mostrarInactivas" />
            <span>Mostrar inactivas</span>
        </label>

        <button class="btn-secondary"
                disabled="@procesando"
                @onclick="CargarAsync">
            <i class="fa-solid fa-rotate"></i>
            Actualizar
        </button>

        <div class="toolbar-summary">
            <strong>@Filtradas.Count</strong>
            <span>categorías</span>
        </div>
    </section>

    @if (cargando)
    {
        <LoadingState Mensaje="Cargando tipos de publicación..." />
    }
    else if (Filtradas.Count == 0)
    {
        <section class="panel empty-state compact-empty">
            <i class="fa-solid fa-folder-open"></i>
            <h2>No se encontraron categorías</h2>
        </section>
    }
    else
    {
        <section class="panel">
            <div class="responsive-table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Orden</th>
                            <th>Color</th>
                            <th>Tipo</th>
                            <th>Descripción</th>
                            <th>Publicaciones</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CategoriaItem item in Filtradas)
                        {
                            <tr>
                                <td>@item.Orden</td>

                                <td>
                                    <span style="
                                        display:inline-block;
                                        width:28px;
                                        height:28px;
                                        border-radius:8px;
                                        background:@item.ColorHex;
                                        border:1px solid #d1d5db">
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        @item.NombreCategoriaPublicacion
                                    </strong>
                                </td>

                                <td>
                                    @item.DescripcionCategoriaPublicacion
                                </td>

                                <td>
                                    @item.CantidadPublicaciones
                                </td>

                                <td>
                                    <span class="status-label @(item.Activo ? "success" : "danger")">
                                        @(item.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>

                                <td>
                                    <div class="security-actions">
                                        @if (item.Activo && PuedeActualizar)
                                        {
                                            <button class="table-action"
                                                    title="Editar"
                                                    @onclick="() => AbrirEditar(item)">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                        }

                                        @if (item.Activo && PuedeEliminar)
                                        {
                                            <button class="table-action danger"
                                                    title="Desactivar"
                                                    disabled="@(item.CantidadPublicaciones > 0)"
                                                    @onclick="() => CambiarEstadoAsync(item, false)">
                                                <i class="fa-solid fa-ban"></i>
                                            </button>
                                        }

                                        @if (!item.Activo && PuedeActualizar)
                                        {
                                            <button class="btn-secondary"
                                                    @onclick="() => CambiarEstadoAsync(item, true)">
                                                <i class="fa-solid fa-rotate-left"></i>
                                                Reactivar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@if (mostrarFormulario)
{
    <div class="modal-backdrop"
         @onclick="CerrarFormulario">
        <article class="modal-card"
                 @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <p class="eyebrow">Tipo de publicación</p>
                    <h2>
                        @(formulario.Id > 0
                            ? "Editar tipo"
                            : "Nuevo tipo")
                    </h2>
                </div>

                <button class="modal-close"
                        disabled="@procesando"
                        @onclick="CerrarFormulario">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <EditForm Model="formulario"
                      OnValidSubmit="GuardarAsync"
                      FormName="tipo-publicacion-form">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="form-group">
                    <label>Nombre *</label>
                    <InputText class="form-control"
                               maxlength="80"
                               @bind-Value="formulario.NombreCategoriaPublicacion" />
                    <ValidationMessage
                        For="() => formulario.NombreCategoriaPublicacion" />
                </div>

                <div class="form-group">
                    <label>Descripción</label>
                    <InputTextArea class="form-control"
                                   maxlength="250"
                                   @bind-Value="formulario.DescripcionCategoriaPublicacion" />
                </div>

                <div class="form-group">
                    <label>Color</label>
                    <input class="form-control"
                           type="color"
                           @bind="formulario.ColorHex" />
                </div>

                <div class="form-group">
                    <label>Orden</label>
                    <InputNumber class="form-control"
                                 min="0"
                                 max="9999"
                                 @bind-Value="formulario.Orden" />
                </div>

                <div class="modal-actions">
                    <button type="button"
                            class="btn-secondary"
                            @onclick="CerrarFormulario">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn-primary"
                            disabled="@procesando">
                        @(procesando
                            ? "Guardando..."
                            : "Guardar")
                    </button>
                </div>
            </EditForm>
        </article>
    </div>
}

@code {
    private const string CodigoPermiso =
        "categoriaPublicacionPage";

    private readonly List<CategoriaItem> categorias = [];
    private CategoriaFormulario formulario = new();

    private bool cargando = true;
    private bool procesando;
    private bool mostrarFormulario;
    private bool mostrarInactivas = true;
    private string buscar = string.Empty;
    private string? mensaje;
    private string? error;

    private bool PuedeLeer =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoLectura(
            CodigoPermiso);

    private bool PuedeAgregar =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoAgregar(
            CodigoPermiso);

    private bool PuedeActualizar =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoActualizar(
            CodigoPermiso);

    private bool PuedeEliminar =>
        AuthState.EsAdministrador ||
        AuthState.TienePermisoEliminar(
            CodigoPermiso);

    private List<CategoriaItem> Filtradas =>
        categorias
            .Where(item =>
                mostrarInactivas || item.Activo)
            .Where(item =>
                string.IsNullOrWhiteSpace(buscar) ||
                item.NombreCategoriaPublicacion.Contains(
                    buscar,
                    StringComparison.OrdinalIgnoreCase) ||
                item.DescripcionCategoriaPublicacion.Contains(
                    buscar,
                    StringComparison.OrdinalIgnoreCase))
            .OrderBy(item => item.Orden)
            .ThenBy(item =>
                item.NombreCategoriaPublicacion)
            .ToList();

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
            return;

        if (!AuthState.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarAsync();
        StateHasChanged();
    }

    private async Task CargarAsync()
    {
        if (!PuedeLeer)
        {
            cargando = false;
            return;
        }

        cargando = true;
        LimpiarMensajes();

        try
        {
            List<CategoriaItem>? resultado =
                await Api.GetAsync<List<CategoriaItem>>(
                    "api/configuracion/categorias-publicacion" +
                    "?incluirInactivas=true");

            categorias.Clear();

            if (resultado is not null)
                categorias.AddRange(resultado);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirCrear()
    {
        formulario = new CategoriaFormulario
        {
            ColorHex = "#3B655B",
            Orden = categorias.Count == 0
                ? 1
                : categorias.Max(item => item.Orden) + 1
        };

        mostrarFormulario = true;
        LimpiarMensajes();
    }

    private void AbrirEditar(
        CategoriaItem item)
    {
        formulario = new CategoriaFormulario
        {
            Id = item.CategoriaPublicacionId,
            NombreCategoriaPublicacion =
                item.NombreCategoriaPublicacion,
            DescripcionCategoriaPublicacion =
                item.DescripcionCategoriaPublicacion,
            ColorHex = item.ColorHex,
            Orden = item.Orden
        };

        mostrarFormulario = true;
        LimpiarMensajes();
    }

    private void CerrarFormulario()
    {
        if (procesando)
            return;

        mostrarFormulario = false;
        formulario = new();
    }

    private async Task GuardarAsync()
    {
        procesando = true;
        LimpiarMensajes();

        try
        {
            var datos = new CategoriaGuardar
            {
                NombreCategoriaPublicacion =
                    formulario.NombreCategoriaPublicacion,
                DescripcionCategoriaPublicacion =
                    formulario.DescripcionCategoriaPublicacion,
                ColorHex = formulario.ColorHex,
                Orden = formulario.Orden
            };

            if (formulario.Id <= 0)
            {
                await Api.PostAsync<
                    CategoriaGuardar,
                    RespuestaOperacion>(
                    "api/configuracion/categorias-publicacion",
                    datos);
            }
            else
            {
                await Api.PutAsync<
                    CategoriaGuardar,
                    RespuestaOperacion>(
                    "api/configuracion/categorias-publicacion/" +
                    formulario.Id,
                    datos);
            }

            mostrarFormulario = false;
            formulario = new();

            await CargarAsync();

            mensaje =
                "Tipo de publicación guardado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task CambiarEstadoAsync(
        CategoriaItem item,
        bool activo)
    {
        if (!activo)
        {
            bool confirmar =
                await JS.InvokeAsync<bool>(
                    "confirm",
                    "¿Desea desactivar " +
                    item.NombreCategoriaPublicacion +
                    "?");

            if (!confirmar)
                return;
        }

        procesando = true;
        LimpiarMensajes();

        try
        {
            await Api.PatchAsync<
                EstadoCategoria,
                RespuestaOperacion>(
                "api/configuracion/categorias-publicacion/" +
                item.CategoriaPublicacionId +
                "/estado",
                new EstadoCategoria
                {
                    Activo = activo
                });

            await CargarAsync();

            mensaje = activo
                ? "Tipo de publicación reactivado correctamente."
                : "Tipo de publicación desactivado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            procesando = false;
        }
    }

    private void LimpiarMensajes()
    {
        mensaje = null;
        error = null;
    }

    private sealed class CategoriaItem
    {
        public int CategoriaPublicacionId { get; set; }

        public string NombreCategoriaPublicacion
        {
            get;
            set;
        } = string.Empty;

        public string DescripcionCategoriaPublicacion
        {
            get;
            set;
        } = string.Empty;

        public string ColorHex { get; set; } =
            "#3B655B";

        public int Orden { get; set; }

        public bool Activo { get; set; }

        public int CantidadPublicaciones { get; set; }
    }

    private sealed class CategoriaFormulario
    {
        public int Id { get; set; }

        [Required(
            ErrorMessage = "El nombre es obligatorio.")]
        [MaxLength(80)]
        public string NombreCategoriaPublicacion
        {
            get;
            set;
        } = string.Empty;

        [MaxLength(250)]
        public string DescripcionCategoriaPublicacion
        {
            get;
            set;
        } = string.Empty;

        [Required]
        public string ColorHex { get; set; } =
            "#3B655B";

        [Range(0, 9999)]
        public int Orden { get; set; }
    }

    private sealed class CategoriaGuardar
    {
        public string NombreCategoriaPublicacion
        {
            get;
            set;
        } = string.Empty;

        public string DescripcionCategoriaPublicacion
        {
            get;
            set;
        } = string.Empty;

        public string ColorHex { get; set; } =
            "#3B655B";

        public int Orden { get; set; }
    }

    private sealed class EstadoCategoria
    {
        public bool Activo { get; set; }
    }

    private sealed class RespuestaOperacion
    {
        public string Mensaje { get; set; } =
            string.Empty;
    }
}
