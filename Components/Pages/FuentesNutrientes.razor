    }

    private async Task EditarDesdeDetalleAsync()
    {
        FuenteNutrienteAdminItemModel? fuente =
            detalle;

        CerrarDetalle();

        if (fuente is not null)
        {
            await AbrirEditarAsync(
                fuente);
        }
    }

    private void CerrarFormulario()
    {
        if (guardando)
            return;

        mostrarFormulario =
            false;
    }

    private void CerrarDetalle()
    {
        mostrarDetalle =
            false;

        detalle =
            null;
    }

    private async Task CambiarPaginaAsync(
        int nuevaPagina)
    {
        if (cargando ||
            nuevaPagina == pagina.PaginaActual ||
            nuevaPagina < 1 ||
            nuevaPagina > pagina.TotalPaginas)
        {
            return;
        }

        await CargarActivasAsync(
            nuevaPagina);
    }

    private async Task CambiarTamanoPaginaAsync(
        int nuevoTamano)
    {
        if (cargando)
            return;

        tamanoPagina =
            Math.Clamp(
                nuevoTamano,
                5,
                100);

        await CargarActivasAsync(1);
    }

    private static decimal? ObtenerAporte(
        FuenteNutrienteAdminItemModel fuente,
        int elementoId)
    {
        return fuente.ElementosQuimicos
            .FirstOrDefault(item =>
                item.ElementoQuimicosId ==
                elementoId)
            ?.CantidadAporte;
    }

    private static string ObtenerIcono(
        FuenteNutrienteAdminItemModel fuente)
    {
        if (fuente.HabilitadaEnmiendaCalcarea)
            return "fa-mountain-sun";

        if (fuente.HabilitadaFertilizacionMixta)
            return "fa-recycle";

        return "fa-flask-vial";
    }

    private void MostrarMensaje(
        string texto,
        bool esError)
    {
        mensaje =
            texto;

        mensajeEsError =
            esError;
    }

    private void LimpiarMensaje()
    {
        mensaje =
            string.Empty;

        mensajeEsError =
            false;
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
