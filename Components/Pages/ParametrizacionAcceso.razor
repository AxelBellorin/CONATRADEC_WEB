    private async Task CargarTodoAsync()
    {
        if (!PuedeVerModulo)
            return;

        cargando = true;
        LimpiarMensaje();

        try
        {
            Task<List<PropietarioAccesoItem>?> propietariosTask =
                PuedeLeerPropietarios || PuedeLeerVinculaciones
                    ? Servicio.ListarPropietariosAsync(
                        incluirInactivos: false)
                    : Task.FromResult<List<PropietarioAccesoItem>?>([]);

            Task<List<UsuarioAccesoCatalogo>?> usuariosTask =
                Servicio.ListarUsuariosAsync();

            Task<List<TerrenoAccesoCatalogo>?> terrenosTask =
                Servicio.ListarTerrenosAsync();

            Task<List<UsuarioPropietarioAsignacionCatalogo>?>
                usuariosPropietariosAsignacionTask = PuedeLeerAsignaciones
                    ? Servicio.ListarUsuariosPropietariosAsignacionAsync()
                    : Task.FromResult<List<UsuarioPropietarioAsignacionCatalogo>?>([]);

            Task<List<DepartamentoAccesoCatalogo>?> departamentosTask =
                Servicio.ListarDepartamentosAsync();

            await Task.WhenAll(
                propietariosTask,
                usuariosTask,
                terrenosTask,
                usuariosPropietariosAsignacionTask,
                departamentosTask);

            propietarios = propietariosTask.Result ?? [];
            propietariosCatalogo = [.. propietarios];
            usuarios = usuariosTask.Result ?? [];
            terrenos = terrenosTask.Result ?? [];
            usuariosPropietariosAsignacion =
                usuariosPropietariosAsignacionTask.Result ?? [];
            departamentos = departamentosTask.Result ?? [];

            if (PuedeLeerAsignaciones)
            {
                if (usuarioAsignacionSeleccionadoId > 0 &&
                    usuarios.Any(item => item.UsuarioId == usuarioAsignacionSeleccionadoId) &&
                    usuariosPropietariosAsignacion.Any(
                        item => item.UsuarioId == usuarioAsignacionSeleccionadoId))
                {
                    await CargarAsignacionesUsuarioAsync();

                    UsuarioAccesoCatalogo? usuarioSeleccionado = UsuarioAsignacionSeleccionado;
                    if (usuarioSeleccionado is not null &&
                        string.IsNullOrWhiteSpace(buscarUsuarioAsignacion))
                    {
                        buscarUsuarioAsignacion = TextoUsuarioAsignacion(usuarioSeleccionado);
                    }
                }
                else
                {
                    usuarioAsignacionSeleccionadoId = 0;
                    buscarUsuarioAsignacion = string.Empty;
                    buscarTerrenoAsignacion = string.Empty;
                    asignaciones = [];
                    terrenosAsignacionPropietario = [];
                    nuevaAsignacion = new();
                }
            }

            if (usuarioPortalId > 0)
            {
                UsuarioAccesoCatalogo? usuarioPortal = UsuarioPortalSeleccionado;
                if (usuarioPortal is null)
                {
                    LimpiarUsuarioPortal();
                }
                else if (string.IsNullOrWhiteSpace(buscarUsuarioPortal))
                {
                    buscarUsuarioPortal = TextoUsuario(usuarioPortal);
                }
            }

            if (PuedeLeerCoberturas)
            {
                if (usuarioCoberturaSeleccionadoId > 0 &&
                    usuarios.Any(
                        item => item.UsuarioId == usuarioCoberturaSeleccionadoId))
                {
                    coberturas = await Servicio.ListarCoberturasAsync(
                        usuarioCoberturaSeleccionadoId) ?? [];

                    UsuarioAccesoCatalogo? usuarioSeleccionado = UsuarioCoberturaSeleccionado;
                    if (usuarioSeleccionado is not null &&
                        string.IsNullOrWhiteSpace(buscarUsuarioCobertura))
                    {
                        buscarUsuarioCobertura = TextoUsuario(usuarioSeleccionado);
                    }
                }
                else
                {
                    usuarioCoberturaSeleccionadoId = 0;
                    buscarUsuarioCobertura = string.Empty;
                    coberturas = [];
                    ReiniciarFormularioCobertura();
                }
            }
        }
        catch (Exception ex)
        {
            MostrarError(ex.Message);
        }
        finally
        {
            cargando = false;
